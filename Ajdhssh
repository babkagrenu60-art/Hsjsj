Tabs.Troll:AddButton({Title="▶ Оттолкнуть сейчас",Callback=function()
    local c=LocalPlayer.Character
    if not c then return end
    local r=c:FindFirstChild("HumanoidRootPart")
    if not r then return end
    for _,t in pairs(Players:GetPlayers()) do
        if t~=LocalPlayer and t.Character then
            local tr=t.Character:FindFirstChild("HumanoidRootPart")
            if tr then
                local o=tr.Position-r.Position
                local d=o.Magnitude
                if d<=Settings.PushDistance and d>0 then
                    tr.AssemblyLinearVelocity=o.Unit*Settings.PushPower+Vector3.new(0,Settings.PushPower*.35,0)
                end
            end
        end
    end
end})

