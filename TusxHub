local function makeToggle(scroll, name, callback, default)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 38)
    btn.BackgroundColor3 = Cfg.PanelColor
    btn.BorderSizePixel = 0
    btn.Text = name .. ": ВЫКЛ"
    btn.TextColor3 = Cfg.TextColor
    btn.TextSize = 10
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.Parent = scroll
    corner(btn, 6)
    stroke(btn, Cfg.BorderColor, 1)
    local state = default or false
    if state then
        btn.Text = name .. ": ВКЛ"
        btn.BackgroundColor3 = Color3.fromRGB(30, 60, 90)
    end
    btn.MouseButton1Click:Connect(function()
        playClick()
        state = not state
        btn.Text = name .. ": " .. (state and "ВКЛ" or "ВЫКЛ")
        TW:Create(btn, TweenInfo.new(animTime(0.2)), {
            BackgroundColor3 = state and Color3.fromRGB(30, 60, 90) or Cfg.PanelColor
        }):Play()
        pcall(callback, state)
        showNotification(name, state)
    end)
end

