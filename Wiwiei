-- Звук взрыва (генерация)
local function PlayExplosionSound()
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://9120386370" -- громкий взрыв
    sound.Volume = 1
    sound.Parent = workspace
    sound:Play()
    game:GetService("Debris"):AddItem(sound, 3)
end

-- СОЗДАНИЕ БЕКОНОВ
local function CreateBacon(name, color, position)
    local model = Instance.new("Model")
    model.Name = name
    
    local hrp = Instance.new("Part")
    hrp.Name = "HumanoidRootPart"
    hrp.Size = Vector3.new(2, 2, 1)
    hrp.Position = position
    hrp.Anchored = false
    hrp.CanCollide = true
    hrp.Material = Enum.Material.SmoothPlastic
    hrp.BrickColor = BrickColor.new(color)
    hrp.Parent = model
    
    local torso = Instance.new("Part")
    torso.Name = "Torso"
    torso.Size = Vector3.new(2, 2.5, 1.5)
    torso.Position = position + Vector3.new(0, 1.5, 0)
    torso.Anchored = false
    torso.CanCollide = true
    torso.Material = Enum.Material.SmoothPlastic
    torso.BrickColor = BrickColor.new(color)
    torso.Parent = model
    
    local head = Instance.new("Part")
    head.Name = "Head"
    head.Size = Vector3.new(1.5, 1.5, 1.5)
    head.Position = position + Vector3.new(0, 3.5, 0)
    head.Anchored = false
    head.CanCollide = true
    head.Material = Enum.Material.SmoothPlastic
    head.BrickColor = BrickColor.new("Bright yellow")
    head.Parent = model
    
    local humanoid = Instance.new("Humanoid")
    humanoid.Name = "Humanoid"
    humanoid.MaxHealth = 100
    humanoid.Health = 100
    humanoid.Parent = model
    
    -- Склеиваем части
    local weld1 = Instance.new("Weld")
    weld1.Part0 = hrp
    weld1.Part1 = torso
    weld1.C0 = CFrame.new(0, 1.5, 0)
    weld1.Parent = hrp
    
    local weld2 = Instance.new("Weld")
    weld2.Part0 = torso
    weld2.Part1 = head
    weld2.C0 = CFrame.new(0, 2, 0)
    weld2.Parent = torso
    
    model.Parent = workspace
    return model
end

-- Функция анимации "привет"
local function PlayWaveAnimation(baconModel)
    local hrp = baconModel:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local torso = baconModel:FindFirstChild("Torso")
    if not torso then return end
    
    -- Поворот в сторону
    local tween1 = TweenService:Create(torso, TweenInfo.new(0.3), {CFrame = torso.CFrame * CFrame.Angles(0, 1.5, 0)})
    local tween2 = TweenService:Create(torso, TweenInfo.new(0.3), {CFrame = torso.CFrame * CFrame.Angles(0, -1.5, 0)})
    
    tween1:Play()
    tween1.Completed:Wait()
    tween2:Play()
    tween2.Completed:Wait()
end

-- СОЗДАНИЕ ДИНАМИЧНОЙ БОМБЫ (взрывает всё, что видит)
local function CreateNuke(origin)
    PlayExplosionSound()
    
    -- Визуальный эффект взрыва (сфера)
    local explosion = Instance.new("Part")
    explosion.Name = "BombExplosion"
    explosion.Size = Vector3.new(1, 1, 1)
    explosion.Position = origin
    explosion.Anchored = true
    explosion.CanCollide = false
    explosion.Material = Enum.Material.Neon
    explosion.BrickColor = BrickColor.new("Bright red")
    explosion.Transparency = 0.3
    explosion.Parent = workspace
    
    -- Анимация расширения (Nuke)
    local tweenSize = TweenService:Create(explosion, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = Vector3.new(80, 80, 80),
        Transparency = 0
    })
    local tweenFade = TweenService:Create(explosion, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Transparency = 1
    })
    
    tweenSize:Play()
    tweenSize.Completed:Wait()
    tweenFade:Play()
    
    -- УДАЛЕНИЕ ВСЕХ ОБЪЕКТОВ В РАДИУСЕ 50 СТУПЕНЕЙ
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj ~= explosion then
            local distance = (obj.Position - origin).Magnitude
            if distance < 50 then
                game:GetService("Debris"):AddItem(obj, 0.1)
                
                -- Создаём осколки
                for i = 1, 10 do
                    local shard = Instance.new("Part")
                    shard.Size = Vector3.new(0.5, 0.5, 0.5)
                    shard.Position = obj.Position + Vector3.new(math.random(-5,5), math.random(-5,5), math.random(-5,5))
                    shard.Anchored = false
                    shard.CanCollide = true
                    shard.BrickColor = BrickColor.random()
                    shard.Material = Enum.Material.Neon
                    shard.Velocity = Vector3.new(math.random(-50,50), math.random(20,80), math.random(-50,50))
                    shard.Parent = workspace
                    game:GetService("Debris"):AddItem(shard, 3)
                end
            end
        end
    end
    
    -- Удаляем бомбу
    game:GetService("Debris"):AddItem(explosion, 1.5)
end

