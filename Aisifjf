-- Улучшенные настройки предикта
local aimLeadMode = "advanced"  -- simple / advanced / extreme
local velocitySamples = {}      -- сглаживание скорости цели
local MAX_VELOCITY_SAMPLES = 6

-- NPC
local aimNPCEnabled = false
local npcOnlyMode = false
local npcAimRange = 200

-- Приоритеты
local aimAtSheriffPriority = true
local killAllForMurder = false
local predictForMurder = true
local murderPredictStrength = 1.4

-- ============================================
-- НОВЫЙ ПРЕДИКТ — сглаживание скорости + компенсация гравитации
-- ============================================
local function getSmoothedVelocity(hrp)
    if not hrp then return Vector3.new() end
    local userId = hrp.Parent and hrp.Parent.Name or "unknown"
    if not velocitySamples[userId] then velocitySamples[userId] = {} end
    local samples = velocitySamples[userId]
    table.insert(samples, hrp.Velocity)
    if #samples > MAX_VELOCITY_SAMPLES then
        table.remove(samples, 1)
    end
    local sum = Vector3.new()
    for _, v in ipairs(samples) do
        sum = sum + v
    end
    return sum / #samples
end

local function getPredictedPosition(part, velocity, hrp)
    if not predictEnabled then return part.Position end
    local gravity = WS.Gravity

    -- Сглаживание скорости для более плавного предикта
    local smoothVel = velocity
    if hrp then
        smoothVel = getSmoothedVelocity(hrp)
    end

    -- Сила предикта
    local strength = predictStrength
    if getMyRole() == "Murderer" and predictForMurder then
        strength = murderPredictStrength
    end

    -- Time-to-hit в зависимости от дистанции
    local dist = 0
    if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        dist = (LP.Character.HumanoidRootPart.Position - part.Position).Magnitude
    end

    -- Чем дальше цель, тем больше предикт
    local distMultiplier = 1 + (dist / 100) * 0.5
    local predictTime = 0.15 * strength * distMultiplier

    -- Режимы предикта
    if aimLeadMode == "advanced" then
        predictTime = predictTime * 1.15
    elseif aimLeadMode == "extreme" then
        predictTime = predictTime * 1.4
    end

    -- Компенсация гравитации для дуги падения/прыжка
    local verticalComponent
    if smoothVel.Y > 5 then
        -- Прыжок вверх — целимся выше
        verticalComponent = smoothVel.Y * predictTime - 0.5 * gravity * predictTime * predictTime
    elseif smoothVel.Y < -5 then
        -- Падение вниз — целимся ниже
        verticalComponent = smoothVel.Y * predictTime - 0.5 * gravity * predictTime * predictTime
    else
        -- Обычное движение — используем полную компенсацию
        verticalComponent = smoothVel.Y * predictTime - 0.5 * gravity * predictTime * predictTime
    end

    -- Горизонтальный предикт (движение вправо/влево/вперёд/назад)
    local horizontalPredict = Vector3.new(
        smoothVel.X * predictTime,
        0,
        smoothVel.Z * predictTime
    )

    return part.Position + horizontalPredict + Vector3.new(0, verticalComponent, 0)
end

-- ============================================
-- ПОИСК NPC
-- ============================================
local function isPlayerCharacter(model)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character == model then return true end
    end
    return false
end

local function findNPCs()
    local npcs = {}
    local myChar = LP.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return npcs end
    local myPos = myChar.HumanoidRootPart.Position

    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("Humanoid") then
            local model = obj.Parent
            if model and not isPlayerCharacter(model) then
                local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
                local head = model:FindFirstChild("Head")
                if hrp and head and obj.Health > 0 then
                    local dist = (myPos - hrp.Position).Magnitude
                    if dist <= npcAimRange and model ~= myChar then
                        table.insert(npcs, {
                            model = model,
                            humanoid = obj,
                            hrp = hrp,
                            head = head,
                            dist = dist,
                        })
                    end
                end
            end
        end
    end
    table.sort(npcs, function(a, b) return a.dist < b.dist end)
    return npcs
end

-- ============================================
-- КОСТЬ ЦЕЛИ
-- ============================================
local function getAimPartFromModel(model)
    if aimBone == "Head" then return model:FindFirstChild("Head") end
    if aimBone == "UpperTorso" then return model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") end
    if aimBone == "LowerTorso" then return model:FindFirstChild("LowerTorso") or model:FindFirstChild("Torso") end
    if aimBone == "HumanoidRootPart" then return model:FindFirstChild("HumanoidRootPart") end
    return model:FindFirstChild("Head")
end

local function getAimPositionFromPlayer(target)
    if not target or not target.Character then return nil end
    local char = target.Character
    local part = getAimPartFromModel(char)
    if not part then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then return getPredictedPosition(part, hrp.Velocity, hrp) end
    return part.Position
end

local function getAimPositionFromNPC(npc)
    if not npc or not npc.model then return nil end
    local part = getAimPartFromModel(npc.model)
    if not part then return nil end
    local hrp = npc.model:FindFirstChild("HumanoidRootPart")
    if hrp then return getPredictedPosition(part, hrp.Velocity, hrp) end
    return part.Position
end

