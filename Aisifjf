-- УТИЛИТЫ
-- ============================================
local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function padding(parent, t, r, b, l)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, t or 0)
    p.PaddingRight = UDim.new(0, r or 0)
    p.PaddingBottom = UDim.new(0, b or 0)
    p.PaddingLeft = UDim.new(0, l or 0)
    p.Parent = parent
    return p
end

local function copyToClipboard(text)
    if setclipboard then pcall(function() setclipboard(text) end) return true end
    if toclipboard then pcall(function() toclipboard(text) end) return true end
    return false
end

local function openTelegram(link)
    if openbrowser then pcall(function() openbrowser(link) end) return true end
    if request then pcall(function() request({Url = link, Method = "GET"}) end) return true end
    return false
end

