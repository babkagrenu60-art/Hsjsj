-- ============================================
-- УБИРАЕМ ЗАДЕРЖКУ ПИСТОЛЕТА
-- ============================================
-- В MM2 у пистолета шерифа есть ~200ms Cooldown между нажатием и выстрелом
-- Мы перехватываем активацию Tool:Activate() и вызываем выстрел моментально
local pistolHook = nil
local pistolToolHooked = {}

local function hookPistolTool(tool)
    if not tool or not tool:IsA("Tool") then return end
    if pistolToolHooked[tool] then return end
    pistolToolHooked[tool] = true

    -- Хукаем свойство Enabled чтобы не блокировало
    pcall(function()
        tool:SetAttribute("XenoHooked", true)
    end)

    -- Перехватываем активацию
    pcall(function()
        local oldActivate = tool.Activate
        tool.Activate = function(self)
            if noPistolDelay then
                -- Мгновенный выстрел без задержки
                local fired = false
                for _, conn in ipairs(getconnections and getconnections(self.Activated) or {}) do
                    if conn.Fire then
                        pcall(function() conn:Fire() end)
                        fired = true
                        break
                    end
                end
                if not fired and self.Activated then
                    pcall(function() self.Activated:Fire() end)
                end
            else
                return oldActivate(self)
            end
        end
    end)
end

