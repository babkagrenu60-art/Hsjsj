local function getColorAtPosition(pos)
    -- Разные оттенки для интересного эффекта
    local t = (pos.X + pos.Y) % 3
    if t < 1 then
        return CFG.Color
    elseif t < 2 then
        return Color3.fromRGB(140, 200, 255)
    else
        return Color3.fromRGB(70, 130, 200)
    end
end

local function spawnParticles(targetPos, count, fromCenter)
    -- targetPos: Vector2 на экране, куда летят частицы
    -- count: количество частиц
    -- fromCenter: если true — частицы летят ИЗ targetPos, иначе К targetPos
    local particles = {}
    local viewSize = workspace.CurrentCamera.ViewportSize

    for i = 1, count do
        local p = Instance.new("Frame")
        p.Size = UDim2.new(0, 4, 0, 4)
        p.BackgroundColor3 = CFG.Color
        p.BorderSizePixel = 0
        p.ZIndex = 600
        p.Parent = particleLayer
        corner(p, 1)

        -- Стартовая позиция — от центра панели
        local startX, startY
        if fromCenter then
            startX = targetPos.X + math.random(-3, 3)
            startY = targetPos.Y + math.random(-3, 3)
        else
            startX = viewSize.X / 2 + math.random(-100, 100)
            startY = viewSize.Y / 2 + math.random(-150, 150)
        end

        local endX, endY
        if fromCenter then
            -- Разлёт от targetPos в стороны
            endX = startX + math.random(-90, 90)
            endY = startY + math.random(-90, 90)
        else
            -- Слёт к targetPos
            endX = targetPos.X + math.random(-3, 3)
            endY = targetPos.Y + math.random(-3, 3)
        end

        p.Position = UDim2.new(0, startX, 0, startY)
        p.BackgroundColor3 = getColorAtPosition(Vector2.new(startX, startY))
        p.BackgroundTransparency = 0
        p.Size = UDim2.new(0, math.random(3, 6), 0, math.random(3, 6))
        corner(p, 2)

        table.insert(particles, {
            obj = p,
            startPos = Vector2.new(startX, startY),
            endPos = Vector2.new(endX, endY),
        })
    end

    -- Анимация полёта
    local duration = fromCenter and 0.5 or 0.45
    local startTime = tick()

    local conn
    conn = RS.RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        local alpha = math.clamp(elapsed / duration, 0, 1)
        -- Ease out cubic
        local eased = 1 - (1 - alpha) ^ 3

        for _, data in ipairs(particles) do
            if data.obj and data.obj.Parent then
                local x = data.startPos.X + (data.endPos.X - data.startPos.X) * eased
                local y = data.startPos.Y + (data.endPos.Y - data.startPos.Y) * eased
                data.obj.Position = UDim2.new(0, x, 0, y)
                data.obj.BackgroundTransparency = alpha * 0.7
                data.obj.Size = UDim2.new(0, math.max(2, 6 * (1 - alpha * 0.6)), 0, math.max(2, 6 * (1 - alpha * 0.6)))
            end
        end

        if alpha >= 1 then
            conn:Disconnect()
            for _, data in ipairs(particles) do
                if data.obj and data.obj.Parent then
                    data.obj:Destroy()
                end
            end
        end
    end)
end

