-- Флаг для открытия/закрытия
local isOpen = true

-- Функция броска брёвен
local function throwLogs()
    print("🔍 Ищем костер...")
    
    local campfire = nil
    local logs = {}
    
    for _, obj in ipairs(game.Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = string.lower(obj.Name)
            if string.find(name, "camp") or string.find(name, "fire") or string.find(name, "bonfire") then
                if obj.Size.X > 2 and obj.Size.Z > 2 then
                    campfire = obj
                    break
                end
            end
        end
    end
    
    if not campfire then
        button.Text = "❌ НЕТ КОСТРА"
        wait(1.5)
        button.Text = "📦 LOG"
        print("❌ Костер не найден!")
        return
    end
    
    print("✅ Костер найден: " .. campfire.Name)
    
    for _, obj in ipairs(game.Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = string.lower(obj.Name)
            if string.find(name, "log") or string.find(name, "wood") or string.find(name, "tree") then
                if obj.Size.X > 1 and obj.Size.Y > 1 and obj.Size.Z > 1 then
                    table.insert(logs, obj)
                end
            end
        end
    end
    
    if #logs == 0 then
        button.Text = "❌ НЕТ БРЁВЕН"
        wait(1.5)
        button.Text = "📦 LOG"
        print("❌ Бревна не найдены!")
        return
    end
    
    print("✅ Найдено брёвен: " .. #logs)
    
    local thrown = 0
    for _, log in ipairs(logs) do
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(40000, 40000, 40000)
        bv.Velocity = (campfire.Position - log.Position).Unit * 40
        bv.Parent = log
        thrown = thrown + 1
        wait(0.05)
        game:GetService("Debris"):AddItem(bv, 1)
    end
    
    button.Text = "✅ " .. thrown .. " БРЁВЕН"
    wait(1.5)
    button.Text = "📦 LOG"
    print("✅ Кинуто " .. thrown .. " бревен!")
end

-- === ОТКРЫТИЕ/ЗАКРЫТИЕ МЕНЮ ===
toggleBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    frame.Visible = isOpen
    toggleBtn.Text = isOpen and "🔥" or "❌"
end)

toggleBtn.TouchTap:Connect(function()
    isOpen = not isOpen
    frame.Visible = isOpen
    toggleBtn.Text = isOpen and "🔥" or "❌"
end)

-- === НАЖАТИЕ НА КНОПКУ LOG ===
button.MouseButton1Click:Connect(throwLogs)
button.TouchTap:Connect(throwLogs)

print("✅ GUI загружен! Кнопка 🔥 - открыть/закрыть. Меню можно двигать пальцем.")
