-- ============================================
-- УТИЛИТЫ
-- ============================================
local function corner(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r)
    c.Parent = parent
    return c
end

local function stroke(parent, col, t)
    local s = Instance.new("UIStroke")
    s.Color = col
    s.Thickness = t or 1
    s.Parent = parent
    return s
end

local function getEasingStyle()
    if UICfg.AnimationType == "back" then return Enum.EasingStyle.Back
    elseif UICfg.AnimationType == "quad" then return Enum.EasingStyle.Quad
    elseif UICfg.AnimationType == "elastic" then return Enum.EasingStyle.Elastic
    elseif UICfg.AnimationType == "bounce" then return Enum.EasingStyle.Bounce
    end
    return Enum.EasingStyle.Back
end

local function animTime(base)
    return base / Cfg.AnimSpeed
end

