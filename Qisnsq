local anims={
"rbxassetid://3823158750",
"rbxassetid://5918726674",
"rbxassetid://5917459365",
"rbxassetid://6575952146",
}
local anim=Instance.new("Animation")
anim.AnimationId=anims[math.random(1,#anims)]
