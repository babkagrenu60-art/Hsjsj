local function updateRoleCache()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then
            local role = getPlayerRole(player)
            if role ~= "Innocent" then
                RoleCache[player.UserId] = role
            end
        end
    end
end

