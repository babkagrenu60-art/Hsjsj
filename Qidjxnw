local function makeBlack(part)
    if not part or not part.Parent then return end
    if doneParts[part] then return end
    doneParts[part]=true
    part:SetAttribute("OrigColor",part.Color)
    part.Color=Color3.fromRGB(0,0,0)
    part.Material=Enum.Material.SmoothPlastic
    for _,face in ipairs{Enum.NormalId.Top,Enum.NormalId.Bottom,Enum.NormalId.Front,Enum.NormalId.Back,Enum.NormalId.Left,Enum.NormalId.Right} do
        local gui=Instance.new("SurfaceGui")
        gui.Face=face;gui.CanvasSize=Vector2.new(400,400);gui.LightInfluence=0
        gui.Parent=part
        local txt=Instance.new("TextLabel")
        txt.Size=UDim2.new(1,0,1,0);txt.BackgroundTransparency=1
        txt.Text="КУЛКИД";txt.TextColor3=Color3.fromRGB(255,0,0);txt.TextScaled=true
        txt.Font=Enum.Font.GothamBlack;txt.TextStrokeTransparency=0
        txt.TextStrokeColor3=Color3.fromRGB(0,0,0);txt.Parent=gui
    end
    part.Touched:Connect(function(hit)
        if not active then return end
        local char=hit.Parent
        if not char then return end
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local hrp=char:FindFirstChild("HumanoidRootPart")
        if hrp and soundOn then
            local snd=Instance.new("Sound")
            snd.SoundId=SCREAM_ID;snd.Volume=5
            snd.Parent=hrp;snd:Play()
            task.delay(5,function() if snd then snd:Destroy() end end)
        end
        local plr=P:GetPlayerFromCharacter(char)
        if plr then infectPlayer(plr) end
    end)
end

local function scanPlatforms()
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name=="PlatformPart" then makeBlack(obj) end
    end
end

-- ===== 1 ЛИЦО С УПРАВЛЕНИЕМ =====
local function startFP()
    if fpLoop then fpLoop:Disconnect() end
    fpLoop=RS.RenderStepped:Connect(function(dt)
        if not active then return end
        local char=LP.Character
        if not char then return end
        local head=char:FindFirstChild("Head")
        if not head then return end

        cam.CameraType=Enum.CameraType.Scriptable

        -- Углы с учётом тряски
        local shakeX=0;local shakeY=0
        if shakeIntensity>0.01 then
            shakeX=(math.random()-0.5)*shakeIntensity*0.05
            shakeY=(math.random()-0.5)*shakeIntensity*0.05
            shakeIntensity=shakeIntensity*0.92
        end

        local baseCFrame=CFrame.new(head.Position)*CFrame.Angles(0,camAngleX,0)*CFrame.Angles(camAngleY,0,0)
        local shakenCFrame=baseCFrame*CFrame.Angles(shakeX,shakeY,0)
        cam.CFrame=shakenCFrame

        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then
                p.LocalTransparencyModifier=1
                if p.Transparency<1 then p.Transparency=1 end
            end
            if p:IsA("Decal") then p.Transparency=1 end
        end
    end)
end

local function stopFP()
    if fpLoop then fpLoop:Disconnect();fpLoop=nil end
    cam.CameraType=Enum.CameraType.Custom
    local char=LP.Character
    if char then
        local hum=char:FindFirstChildOfClass("Humanoid")
        if hum then cam.CameraSubject=hum end
        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.LocalTransparencyModifier=0
                if p.Name~="HumanoidRootPart" then p.Transparency=0 end
            end
            if p:IsA("Decal") then p.Transparency=0 end
        end
    end
end

