    -- ========== ОСНОВНЫЕ ФУНКЦИИ ИИ ==========
    
    -- Поиск всех доступных целей
    function FindAllTargets()
        local targets = {}
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return targets end
        
        local hrp = character.HumanoidRootPart
        local currentPos = hrp.Position
        
        -- Ищем все платформы и чекпоинты
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local name = string.lower(obj.Name or "")
                local isTarget = false
                
                -- Расширенный список целей
                if string.find(name, "checkpoint") or 
                   string.find(name, "finish") or
                   string.find(name, "stage") or
                   string.find(name, "platform") or
                   string.find(name, "ground") or
                   string.find(name, "floor") or
                   string.find(name, "block") or
                   string.find(name, "part") or
                   string.find(name, "mesh") then
                    isTarget = true
                end
                
                -- Проверяем размер (не слишком маленькие)
                if isTarget and obj.Size.Magnitude > 2 then
                    local dist = (currentPos - obj.Position).Magnitude
                    -- Ищем цели в радиусе 50 и выше текущей позиции
                    if dist > 3 and dist < 80 and obj.Position.Y >= currentPos.Y - 5 then
                        table.insert(targets, {
                            Object = obj,
                            Position = obj.Position,
                            Distance = dist,
                            Y = obj.Position.Y
                        })
                    end
                end
            end
        end
        
        -- Сортируем по расстоянию
        table.sort(targets, function(a, b)
            return a.Distance < b.Distance
        end)
        
        return targets
    end
    
    -- Поиск ближайшей цели
    function FindBestTarget()
        local targets = FindAllTargets()
        if #targets == 0 then return nil end
        
        local character = LocalPlayer.Character
        if not character then return nil end
        
        local hrp = character.HumanoidRootPart
        local currentPos = hrp.Position
        
        -- Сначала ищем чекпоинты
        for _, target in pairs(targets) do
            local name = string.lower(target.Object.Name or "")
            if string.find(name, "checkpoint") or string.find(name, "finish") or string.find(name, "stage") then
                if target.Distance > 5 then
                    return target.Object
                end
            end
        end
        
        -- Затем ищем платформы выше
        local bestTarget = nil
        local bestScore = -math.huge
        
        for _, target in pairs(targets) do
            if target.Distance > 5 then
                local score = 0
                -- Выше = лучше
                if target.Y > currentPos.Y then
                    score = score + (target.Y - currentPos.Y) * 2
                end
                -- Ближе = лучше
                score = score + (50 - target.Distance)
                -- Предпочитаем цели выше
                if target.Y > currentPos.Y + 1 then
                    score = score + 30
                end
                
                if score > bestScore then
                    bestScore = score
                    bestTarget = target.Object
                end
            end
        end
        
        return bestTarget
    end
    
    -- Поиск опасностей
    function CheckHazards(rootPart)
        pcall(function()
            for _, part in pairs(workspace:GetPartBoundsInRadius(rootPart.Position, 12)) do
                if part and part:IsA("BasePart") then
                    local name = string.lower(part.Name or "")
                    if string.find(name, "kill") or string.find(name, "lava") or 
                       string.find(name, "laser") or string.find(name, "acid") or 
                       string.find(name, "spike") or string.find(name, "void") then
                        local relativePos = rootPart.CFrame:PointToObjectSpace(part.Position)
                        if relativePos.Z < 0 and math.abs(relativePos.X) < 4 then
                            return true
                        end
                    end
                end
            end
        end)
        return false
    end
    
    -- Основной цикл движения
    function MoveAI()
        local character = LocalPlayer.Character
        if not character then 
            SetThought("❌ Персонаж не найден!", "danger")
            return 
        end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        
        if not humanoid or not rootPart or humanoid.Health <= 0 then
            SetThought("❌ Персонаж мертв!", "danger")
            return
        end
        
        -- Проверяем места смерти
        for _, deathPos in pairs(DeathLocations) do
            if (rootPart.Position - deathPos).Magnitude < 10 then
                SetThought("⚠️ Тут я уже падал! ПРЫГАЮ!", "learn")
                humanoid.Jump = true
                local jumpVec = rootPart.CFrame.LookVector * 25 + Vector3.new(0, 18, 0)
                rootPart.AssemblyLinearVelocity = jumpVec
                task.wait(0.3)
                return
            end
        end
        
        -- Проверка опасностей
        if CheckHazards(rootPart) then
            SetThought("⚠️ Опасность! Перепрыгиваю!", "danger")
            humanoid.Jump = true
            local jumpVec = rootPart.CFrame.LookVector * 20 + Vector3.new(0, 15, 0)
            rootPart.AssemblyLinearVelocity = jumpVec
            task.wait(0.2)
            return
        end
        
        -- Поиск цели
        local target = FindBestTarget()
        
        if not target then
            -- Если цели не найдены, идем вперед
            SetThought("🔍 Ищу путь вперед...", "normal")
            local forwardPos = rootPart.Position + rootPart.CFrame.LookVector * 20
            forwardPos = Vector3.new(forwardPos.X, rootPart.Position.Y, forwardPos.Z)
            humanoid:MoveTo(forwardPos)
            return
        end
        
        -- Получаем позицию цели
        local targetPos = target.Position
        local distance = (rootPart.Position - targetPos).Magnitude
        
        -- Обновляем статус
        SetThought("🎯 Движусь к цели! Расстояние: " .. math.floor(distance), "normal")
        
        -- Если цель далеко - бежим
        if distance > 20 then
            humanoid.WalkSpeed = 20
        else
            humanoid.WalkSpeed = 16
        end
        
        -- Двигаемся к цели
        humanoid:MoveTo(targetPos)
        
        -- Если нужно прыгнуть
        if targetPos.Y > rootPart.Position.Y + 1.5 then
            SetThought("🏃 Прыгаю на платформу выше!", "normal")
            humanoid.Jump = true
            
            -- Усиленный прыжок
            if distance < 15 then
                local jumpVec = rootPart.CFrame.LookVector * 15 + Vector3.new(0, 20, 0)
                rootPart.AssemblyLinearVelocity = jumpVec
            end
        end
        
        -- Если застряли - прыгаем
        if MoveTimer > 3 then
            SetThought("⚠️ Застрял! Прыгаю!", "danger")
            humanoid.Jump = true
            rootPart.AssemblyLinearVelocity = Vector3.new(0, 15, 0)
            MoveTimer = 0
        end
    end
    
    -- ========== ЗАПУСК ИИ ==========
    StartButton.MouseButton1Click:Connect(function()
        AI_Enabled = not AI_Enabled
        
        if AI_Enabled then
            StartButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
            StartButton.Text = "⏹️ ОСТАНОВИТЬ ИИ"
            SetThought("✅ ИИ активирован! Ищу путь...", "normal")
            MoveTimer = 0
            
            if not isRunning then
                isRunning = true
                task.spawn(function()
                    while AI_Enabled and isRunning do
                        pcall(function()
                            MoveAI()
                            MoveTimer = MoveTimer + 0.05
                        end)
                        task.wait(0.05)
                    end
                end)
            end
        else
            StartButton.BackgroundColor3 = Color3.fromRGB(0, 150, 50)
            StartButton.Text = "▶️ ЗАПУСТИТЬ ИИ"
            SetThought("⏸️ ИИ деактивирован", "normal")
            isRunning = false
            MoveTimer = 0
        end
    end)
    
    -- ========== ОЧИСТКА ПАМЯТИ ==========
    ClearButton.MouseButton1Click:Connect(function()
        DeathLocations = {}
        SetThought("🧹 Память очищена! Бот переобучается...", "normal")
        ClearButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        task.wait(0.5)
        ClearButton.BackgroundColor3 = Color3.fromRGB(150, 50, 0)
    end)
    
    -- ========== ПОКАЗАТЬ ЦЕЛЬ ==========
    TargetButton.MouseButton1Click:Connect(function()
        local target = FindBestTarget()
        if target then
            SetThought("🎯 Найдена цель: " .. target.Name .. " на расстоянии " .. 
                math.floor((LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and 
                (LocalPlayer.Character.HumanoidRootPart.Position - target.Position).Magnitude) or 0), "normal")
            
            -- Создаем маркер на цели
            local marker = Instance.new("Part")
            marker.Size = Vector3.new(2, 2, 2)
            marker.Position = target.Position + Vector3.new(0, 2, 0)
            marker.BrickColor = BrickColor.new("Bright red")
            marker.Material = Enum.Material.Neon
            marker.Anchored = true
            marker.CanCollide = false
            marker.Parent = workspace
            
            -- Удаляем через 3 секунды
            task.delay(3, function()
                marker:Destroy()
            end)
        else
            SetThought("❌ Цели не найдены!", "danger")
        end
    end)
    
    -- Фоновое обновление
    task.spawn(function()
        while true do
            task.wait(2)
            if AI_Enabled then
                local targets = FindAllTargets()
                if #targets > 0 then
                    SetThought("🧠 Найдено целей: " .. #targets .. " | Ошибок: " .. #DeathLocations, "normal")
                end
            end
        end
    end)
    
    return {
        SetThought = SetThought,
        MainFrame = MainFrame,
        ToggleButton = ToggleButton
    }
end

