local function playSound(id, volume, loop)
    if not SoundCfg.Enabled then return nil end
    local sound
    pcall(function()
        sound = Instance.new("Sound")
        sound.SoundId = id
        sound.Volume = volume or SoundCfg.Volume
        sound.Looped = loop or false
        sound.Parent = SoundService
        sound:Play()
        if not loop then game:GetService("Debris"):AddItem(sound, 15) end
    end)
    return sound
end

local function playClick() if SoundCfg.Click then playSound(Cfg.SoundClick, 0.6) end end
local function playStartup() if SoundCfg.Startup then playSound(Cfg.SoundStartup, 0.9) end end
local function playDeathKnife() if SoundCfg.DeathKnife then playSound(Cfg.SoundDeathKnife, 0.9) end end
local function playKnifeKill() if SoundCfg.KnifeKill then playSound(Cfg.SoundKnifeKill, 0.9) end end
local function playRevolverShot() if SoundCfg.RevolverShot then playSound(Cfg.SoundRevolverShot, 0.8) end end

local roundWaitSound = nil
local function startRoundWaitSound()
    if not SoundCfg.RoundWait then return end
    if roundWaitSound and roundWaitSound.Parent then return end
    roundWaitSound = playSound(Cfg.SoundRoundWait, 0.7, true)
end
local function stopRoundWaitSound()
    if roundWaitSound and roundWaitSound.Parent then
        pcall(function() roundWaitSound:Stop() end)
        pcall(function() roundWaitSound:Destroy() end)
    end
    roundWaitSound = nil
end

