--==================================================
-- ПЕРЕТАСКИВАНИЕ ПАНЕЛИ
--==================================================

local dragging = false
local dragStart
local panelStart

top.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.Touch
	or input.UserInputType == Enum.UserInputType.MouseButton1 then

		dragging = true
		dragStart = input.Position
		panelStart = panel.Position
	end
end)

top.InputEnded:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.Touch
	or input.UserInputType == Enum.UserInputType.MouseButton1 then

		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)

	if not dragging then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.Touch
	and input.UserInputType ~= Enum.UserInputType.MouseMovement then
		return
	end

	local delta = input.Position - dragStart

	panel.Position = UDim2.new(
		panelStart.X.Scale,
		panelStart.X.Offset + delta.X,
		panelStart.Y.Scale,
		panelStart.Y.Offset + delta.Y
	)
end)

--==================================================
-- ПОИСК ЗЕМЛИ
--==================================================

local function findGround(position)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude

	local character = player.Character

	if character then
		params.FilterDescendantsInstances = {character}
	end

	local ray = workspace:Raycast(
		position + Vector3.new(0,50,0),
		Vector3.new(0,-120,0),
		params
	)

	if ray then
		return ray.Position + Vector3.new(0,3,0)
	end

	return nil
end

--==================================================
-- ВЫБОР НОВОЙ ТОЧКИ
--==================================================

local function chooseTarget()

	if not root then
		return nil
	end

	for i = 1,40 do

		local angle = math.random() * math.pi * 2
		local distance = math.random(20,SEARCH_DISTANCE)

		local candidate = root.Position + Vector3.new(
			math.cos(angle) * distance,
			0,
			math.sin(angle) * distance
		)

		local ground = findGround(candidate)

		if ground then

			local x = math.floor(ground.X / 10)
			local z = math.floor(ground.Z / 10)

			local key = x .. ":" .. z

			if not visited[key] and not failed[key] then
				return ground,key
			end
		end
	end

	-- Если всё рядом уже исследовано,
	-- очищаем часть памяти и продолжаем исследование.
	visited = {}

	return nil
end

--==================================================
-- ПОСТРОЕНИЕ МАРШРУТА
--==================================================

local function makePath(target)

	if not root then
		return nil
	end

	local path = PathfindingService:CreatePath({
		AgentRadius = 2,
		AgentHeight = 5,
		AgentCanJump = true,
		AgentJumpHeight = 8,
		AgentMaxSlope = 45,
		WaypointSpacing = WAYPOINT_SPACING
	})

	local success = pcall(function()
		path:ComputeAsync(root.Position,target)
	end)

	if not success then
		return nil
	end

	if path.Status ~= Enum.PathStatus.Success then
		return nil
	end

	return path:GetWaypoints()
end

--==================================================
-- ПРОХОЖДЕНИЕ МАРШРУТА
--==================================================

local function followPath(waypoints,key)

	for _,waypoint in ipairs(waypoints) do

		if not running then
			return false
		end

		if not humanoid or humanoid.Health <= 0 then
			return false
		end

		if waypoint.Action == Enum.PathWaypointAction.Jump then
			humanoid.Jump = true
		end

		humanoid:MoveTo(waypoint.Position)

		local finished = humanoid.MoveToFinished:Wait()

		if not finished then

			failed[key] = true

			-- Попытка выбраться из тупика
			humanoid.Jump = true

			return false
		end

		-- Иногда бот самостоятельно прыгает
		if math.random(1,20) == 1 then
			humanoid.Jump = true
		end
	end

	visited[key] = true

	return true
end

--==================================================
-- AI
--==================================================

local function runAI()

	while running do

		if not humanoid or not root or humanoid.Health <= 0 then
			getCharacter()
			task.wait(1)
			continue
		end

		local target,key = chooseTarget()

		if target then

			status.Text = "Ищу путь..."

			local waypoints = makePath(target)

			if waypoints then

				status.Text = "Иду..."

				followPath(waypoints,key)

			else

				status.Text = "Обхожу..."

				failed[key] = true

				-- Бот пробует небольшое смещение,
				-- после чего строит новый маршрут.
				humanoid:MoveTo(
					root.Position +
					Vector3.new(
						math.random(-12,12),
						0,
						math.random(-12,12)
					)
				)

				humanoid.Jump = true

				task.wait(0.7)
			end

		else
			status.Text = "Исследую..."
			task.wait(0.5)
		end

		task.wait(0.15)
	end
end

