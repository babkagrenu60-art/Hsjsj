--==================================================
-- AI
--==================================================

local bot
local running = false
local visited = {}
local failed = {}

local function getTarget(root)

	for i = 1,30 do

		local angle = math.random() * math.pi * 2
		local distance = math.random(25,80)

		local pos = root.Position + Vector3.new(
			math.cos(angle) * distance,
			50,
			math.sin(angle) * distance
		)

		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {bot}

		local ray = workspace:Raycast(
			pos,
			Vector3.new(0,-120,0),
			params
		)

		if ray then

			local target = ray.Position + Vector3.new(0,3,0)

			local key = math.floor(target.X/10)..":"..
						math.floor(target.Z/10)

			if not visited[key] and not failed[key] then
				return target,key
			end
		end
	end

	return nil
end

local function createPath(startPos,targetPos)

	local path = PathfindingService:CreatePath({
		AgentRadius = 2,
		AgentHeight = 5,
		AgentCanJump = true,
		AgentJumpHeight = 9,
		AgentMaxSlope = 45,
		WaypointSpacing = 3
	})

	local ok = pcall(function()
		path:ComputeAsync(startPos,targetPos)
	end)

	if ok and path.Status == Enum.PathStatus.Success then
		return path:GetWaypoints()
	end

	return nil
end

local function startBot()

	if running then return end

	local character = player.Character
	if not character then return end

	character.Archivable = true

	bot = character:Clone()
	bot.Name = player.Name .. "_AI_Bot"
	bot.Parent = workspace

	local humanoid = bot:FindFirstChildOfClass("Humanoid")
	local root = bot:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		bot:Destroy()
		bot = nil
		return
	end

	bot:PivotTo(character:GetPivot() * CFrame.new(5,0,0))

	humanoid.WalkSpeed = 16
	humanoid.JumpPower = 50

	running = true
	visited = {}
	failed = {}

	while running and bot.Parent and humanoid.Health > 0 do

		local target,key = getTarget(root)

		if target then

			local waypoints = createPath(
				root.Position,
				target
			)

			if waypoints then

				local stuck = false

				for _,point in ipairs(waypoints) do

					if not running then break end
					if not bot.Parent then break end

					if point.Action ==
						Enum.PathWaypointAction.Jump then
						humanoid.Jump = true
					end

					humanoid:MoveTo(point.Position)

					local reached =
						humanoid.MoveToFinished:Wait()

					if not reached then
						failed[key] = true
						stuck = true

						humanoid.Jump = true
						task.wait(.4)

						break
					end

					if math.random(1,15) == 1 then
						humanoid.Jump = true
					end
				end

				if not stuck then
					visited[key] = true
				end

			else
				failed[key] = true
				humanoid.Jump = true
				task.wait(.5)
			end

		else

			visited = {}

		end

		task.wait(.15)
	end
end

local function stopBot()

	running = false

	if bot then
		bot:Destroy()
		bot = nil
	end
end

