-- Эффект: Роблокс Егор (Бег)
local egorWalkActive = false
EgorWalkButton.MouseButton1Click:Connect(function()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")
    egorWalkActive = not egorWalkActive
    if egorWalkActive then
        EgorWalkButton.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        hum.WalkSpeed = 4
        task.spawn(function()
            while egorWalkActive and char and hum.Parent do
                pcall(function()
                    for _, track in pairs(hum:FindFirstChildOfClass("Animator"):GetPlayingAnimationTracks()) do
                        if track.Name:lower():find("walk") or track.Name:lower():find("run") then
                            track:AdjustSpeed(25)
                        end
                    end
                end)
                task.wait(0.05)
            end
        end)
    else
        EgorWalkButton.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        hum.WalkSpeed = 16
    end
end)

-- Эффект: Егор Гравитация (Лаганное падение с прыжка)
local egorGravActive = false
EgorGravButton.MouseButton1Click:Connect(function()
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    egorGravActive = not egorGravActive
    if egorGravActive then
        EgorGravButton.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        task.spawn(function()
            while egorGravActive and char and hrp.Parent do
                if hrp.AssemblyLinearVelocity.Y < -2 then
                    hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, -3, hrp.AssemblyLinearVelocity.Z)
                    hrp.CFrame = hrp.CFrame * CFrame.new(0, math.sin(tick() * 50) * 0.05, 0)
                end
                task.wait(0.02)
            end
        end)
    else
        EgorGravButton.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    end
end)

-- Эффект: МЕДЛЕННЫЙ РЕГДОЛЛ (Падение куклой с контролем скорости)
local ragdollActive = false
local activeVelocity = nil
local activeAttachment = nil

RagdollButton.MouseButton1Click:Connect(function()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")
    local hrp = char:WaitForChild("HumanoidRootPart")
    ragdollActive = not ragdollActive
    
    if ragdollActive then
        RagdollButton.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        hum.PlatformStand = true -- Отключаем удержание равновесия (персонаж падает тряпкой)
        
        -- Создаем физический замедлитель падения
        activeAttachment = Instance.new("Attachment")
        activeAttachment.Parent = hrp
        
        activeVelocity = Instance.new("LinearVelocity") [1]
        activeVelocity.Attachment0 = activeAttachment
        activeVelocity.MaxForce = math.huge -- Сила бесконечна, чтобы перевесить гравитацию игры
        -- Задаем медленную скорость падения по оси Y (значение -2 означает медленный спуск вниз)
        activeVelocity.VectorVelocity = Vector3.new(0, -2, 0) 
        activeVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
        activeVelocity.Parent = hrp
        
        -- Дополнительно пускаем микро-судороги по телу для эффекта лагающего регдолла
        task.spawn(function()
            while ragdollActive and hrp and hrp.Parent do
                hrp.CFrame = hrp.CFrame * CFrame.Angles(math.sin(tick()*10)*0.02, 0, math.cos(tick()*10)*0.02)
                task.wait(0.02)
            end
        end)
    else
        RagdollButton.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        hum.PlatformStand = false -- Возвращаем управление телом
        
        -- Удаляем физические замедлители, чтобы персонаж снова стал обычным
        if activeVelocity then activeVelocity:Destroy() end
