-- === ЛОГИКА ЗАРАЖЕНИЯ ===
local function paintInfected(char)
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.Color=Color3.fromRGB(80,200,80) end
    end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    if hrp and not hrp:FindFirstChild("VirusEmitter") then
        local e=Instance.new("ParticleEmitter")
        e.Name="VirusEmitter"
        e.Texture="rbxassetid://243660364"
        e.Rate=20;e.Lifetime=NumberRange.new(1,2)
        e.Speed=NumberRange.new(2,6);e.Size=NumberSequence.new(1)
        e.Color=ColorSequence.new(Color3.fromRGB(100,255,100))
        e.Parent=hrp
    end
end

local function clearInfected(char)
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("ParticleEmitter") and p.Name=="VirusEmitter" then p:Destroy() end
    end
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.Color=Color3.fromRGB(255,255,255) end
    end
end

local function infectPlayer(plr)
    if infected[plr] then return end
    infected[plr]=true
    local c=plr.Character
    if c then paintInfected(c) end
    plr.CharacterAdded:Connect(function(char)
        if infected[plr] then
            task.wait(1)
            paintInfected(char)
        end
    end)
end

local function countInfected()
    local n=0
    for plr,_ in pairs(infected) do
        if plr and plr.Parent then n=n+1 end
    end
    return n
end

local function updateStats()
    local total=#P:GetPlayers()
    local n=countInfected()
    StatLbl.Text="Заразил: "..n.." / "..total
    CoinLbl.Text="💰 Монеты: "..coins
    ShopLbl.Text="💰 Монеты: "..coins
    RadiusLbl.Text="Радиус заражения: "..radius
    -- Проверка победы
    if active and n>=total-1 and total>1 then
        coins=coins+10
        active=false
        MainBtn.Text="✅ ПОБЕДА! +10 монет"
        MainBtn.BackgroundColor3=Color3.fromRGB(80,80,30)
        if loop then loop:Disconnect();loop=nil end
        task.wait(3)
        resetAll()
    end
end

function resetAll()
    infected={}
    for _,plr in ipairs(P:GetPlayers()) do
        if plr.Character then clearInfected(plr.Character) end
    end
    active=false
    MainBtn.Text="🦠  СТАТЬ ЗАРАЖЁННЫМ"
    MainBtn.BackgroundColor3=Color3.fromRGB(35,55,40)
    updateStats()
end

-- === ОСНОВНОЙ ЦИКЛ ===
local function startLoop()
    if loop then loop:Disconnect() end
    loop=RS.Heartbeat:Connect(function()
        if not active then return end
        local myChar=LP.Character
        if not myChar then return end
        local myHrp=myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end
        paintInfected(myChar)

        -- Заражение ближних
        for _,plr in ipairs(P:GetPlayers()) do
            if plr~=LP and not infected[plr] then
                local c=plr.Character
                if c then
                    local h=c:FindFirstChild("HumanoidRootPart")
                    if h and (h.Position-myHrp.Position).Magnitude<=radius then
                        infectPlayer(plr)
                    end
                end
            end
        end

        -- Лихорадка: снимаем HP
        if damageMode then
            for plr,_ in pairs(infected) do
                if plr and plr~=LP then
                    local c=plr.Character
                    if c then
                        local hum=c:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health>0 then
                            hum.Health=math.max(0,hum.Health-5*0.05)
                        end
                    end
                end
            end
        end

        updateStats()
    end)
end

-- === КНОПКА СТАТЬ ЗАРАЖЁННЫМ ===
MainBtn.MouseButton1Click:Connect(function()
