-- Функция переключения видимости меню
local function toggleMenu()
    MainFrame.Visible = not MainFrame.Visible
    if MainFrame.Visible then
        OpenCloseButton.Text = "МЕНЮ (ЗАКРЫТЬ) [K]"
        OpenCloseButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    else
        OpenCloseButton.Text = "МЕНЮ (ОТКРЫТЬ) [K]"
        OpenCloseButton.BackgroundColor3 = Color3.fromRGB(0, 170, 100)
    end
end

OpenCloseButton.MouseButton1Click:Connect(toggleMenu)

-- Открытие/Закрытие на кнопку K или Insert на клавиатуре
game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed then
        if input.KeyCode == Enum.KeyCode.K or input.KeyCode == Enum.KeyCode.Insert then
            toggleMenu()
        end
    end
end)

