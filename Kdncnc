local function makeBtn(parent,text,y,color)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(1,0,0,32)
    b.Position=UDim2.new(0,0,0,y)
    b.BackgroundColor3=color or CFG.BtnColor
    b.BorderSizePixel=0
