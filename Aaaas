local function collectGuiObjects()
    local list = {}
    for _, desc in ipairs(MF:GetDescendants()) do
        if desc:IsA("GuiObject") and not desc:IsA("UIStroke") then
            local entry = {
                obj = desc,
                origBg = desc.BackgroundTransparency,
                origText = nil,
                origImage = nil,
            }
            if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
                entry.origText = desc.TextTransparency
            end
            if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
                entry.origImage = desc.ImageTransparency
            end
            table.insert(list, entry)
        end
    end
    return list
end

local function setAllTransparent(list)
    for _, entry in ipairs(list) do
        entry.obj.BackgroundTransparency = 1
        if entry.origText then
            entry.obj.TextTransparency = 1
        end
        if entry.origImage then
            entry.obj.ImageTransparency = 1
        end
    end
end

local function restoreAll(list, duration)
    for _, entry in ipairs(list) do
        pcall(function()
            TW:Create(entry.obj, TweenInfo.new(duration or 0.3), {
                BackgroundTransparency = entry.origBg
            }):Play()
        end)
        if entry.origText then
            pcall(function()
                TW:Create(entry.obj, TweenInfo.new(duration or 0.3), {
                    TextTransparency = entry.origText
                }):Play()
            end)
        end
        if entry.origImage then
            pcall(function()
                TW:Create(entry.obj, TweenInfo.new(duration or 0.3), {
                    ImageTransparency = entry.origImage
                }):Play()
            end)
        end
    end
end

local function closeMenu()
    if isAnimating then return end
    isAnimating = true

    local guiList = collectGuiObjects()

    for _, entry in ipairs(guiList) do
        pcall(function()
            TW:Create(entry.obj, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                BackgroundTransparency = 1
            }):Play()
        end)
        if entry.origText then
            pcall(function()
                TW:Create(entry.obj, TweenInfo.new(0.25), {TextTransparency = 1}):Play()
            end)
        end
        if entry.origImage then
            pcall(function()
                TW:Create(entry.obj, TweenInfo.new(0.25), {ImageTransparency = 1}):Play()
            end)
        end
    end

    TW:Create(mainStroke, TweenInfo.new(0.3), {Transparency = 1}):Play()

    local shrink = TW:Create(MF, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 290, 0, 0),
        BackgroundTransparency = 1
    })
    shrink:Play()

    shrink.Completed:Connect(function()
        MF.Visible = false
        MF.Size = UDim2.new(0, 290, 0, 360)
        MF.BackgroundTransparency = 0
        mainStroke.Transparency = 0
        restoreAll(guiList, 0)
        isAnimating = false
    end)
end

local function openMenu()
    if isAnimating then return end
    isAnimating = true

    MF.Visible = true
    MF.Size = UDim2.new(0, 290, 0, 0)
    MF.BackgroundTransparency = 1
    mainStroke.Transparency = 1

    local guiList = collectGuiObjects()
    setAllTransparent(guiList)

    local expand = TW:Create(MF, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 290, 0, 360),
        BackgroundTransparency = 0
    })
    TW:Create(mainStroke, TweenInfo.new(0.3), {Transparency = 0}):Play()
    expand:Play()

    task.spawn(function()
        task.wait(0.1)
        restoreAll(guiList, 0.25)
    end)

    task.wait(0.35)
    isAnimating = false
end

CloseBtn.MouseButton1Click:Connect(closeMenu)

Icon.MouseButton1Click:Connect(function()
    if MF.Visible then
        closeMenu()
    else
        openMenu()
    end
end)

-- Перетаскивание
do
    local dragging = false
    local dragStart = nil
    local startPos = nil

    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MF.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            MF.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

