-- ESP Storage
local ESPObjects = {}

-- Cleanup functions
local function clearESP()
    for _, obj in pairs(ESPObjects) do
        if obj then
            obj:Remove()
        end
    end
    ESPObjects = {}
end

-- Get player role
local function getPlayerRole(player)
    local character = player.Character
    if not character then return nil end
    
    local backpack = player.Backpack
    local tools = {}
    
    if character:FindFirstChildOfClass("Tool") then
        table.insert(tools, character:FindFirstChildOfClass("Tool"))
    end
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(tools, item)
            end
        end
    end
    
    for _, tool in pairs(tools) do
        if tool.Name:lower():find("knife") or tool.Name:lower():find("murder") then
            return "Murderer"
        elseif tool.Name:lower():find("gun") or tool.Name:lower():find("sheriff") or tool.Name:lower():find("pistol") then
            return "Sheriff"
        end
    end
    
    -- Check for role values
    if character:FindFirstChild("Murderer") then return "Murderer" end
    if character:FindFirstChild("Sheriff") then return "Sheriff" end
    
    return "Innocent"
end

-- Get my role
local function getMyRole()
    return getPlayerRole(LocalPlayer)
end

-- ESP Function
local function updateESP()
    clearESP()
    
    if not ESPEnabled then return end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character:FindFirstChild("HumanoidRootPart") then
            local character = player.Character
            local humanoid = character.Humanoid
            local rootPart = character.HumanoidRootPart
            local role = getPlayerRole(player)
            
            local highlight = Instance.new("Highlight")
            highlight.Name = "ESP_" .. player.Name
            highlight.Parent = character
            highlight.Adornee = character
            highlight.FillTransparency = 0.7
            highlight.OutlineTransparency = 0
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            
            if role == "Murderer" then
                highlight.FillColor = Color3.new(1, 0, 0)
                highlight.OutlineColor = Color3.new(1, 0, 0)
            elseif role == "Sheriff" then
                highlight.FillColor = Color3.new(0, 0, 1)
                highlight.OutlineColor = Color3.new(0, 0, 1)
            else
                highlight.FillColor = Color3.new(0, 1, 0)
                highlight.OutlineColor = Color3.new(0, 0, 1)
            end
            
            -- Distance label
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "ESPDist_" .. player.Name
            billboard.Parent = character
            billboard.Adornee = rootPart
            billboard.Size = UDim2.new(0, 100, 0, 30)
            billboard.StudsOffset = Vector3.new(0, 3, 0)
            billboard.AlwaysOnTop = true
            
            local textLabel = Instance.new("TextLabel")
            textLabel.Parent = billboard
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.TextColor3 = Color3.new(1, 1, 1)
            textLabel.TextStrokeTransparency = 0
            textLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
            textLabel.Font = Enum.Font.SourceSansBold
            textLabel.TextSize = 16
            textLabel.Text = player.Name .. "\n" .. role
            
            table.insert(ESPObjects, highlight)
            table.insert(ESPObjects, billboard)
            
            -- Update distance
            task.spawn(function()
                while ESPEnabled and character and character.Parent do
                    local distance = (LocalPlayer.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude
                    textLabel.Text = player.Name .. " [" .. role .. "]\n" .. math.floor(distance) .. "m"
                    task.wait(0.1)
                end
            end)
        end
    end
end

-- Auto Gun Pickup
local function findGun()
    for _, item in pairs(Workspace:GetDescendants()) do
        if item:IsA("Tool") and (item.Name:lower():find("gun") or item.Name:lower():find("pistol")) and item.Parent ~= LocalPlayer.Character then
            return item
        end
    end
    return nil
end

local function autoGunPickup()
    if not GunAutoPickup then return end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local gun = findGun()
    if gun and gun.Parent and gun.Parent:FindFirstChild("CFrame") then
        local originalCFrame = character.HumanoidRootPart.CFrame
        local gunCFrame = gun.Parent.CFrame
        
        character.HumanoidRootPart.CFrame = gunCFrame
        task.wait(0.05)
        character.HumanoidRootPart.CFrame = originalCFrame
    end
end

-- Get closest player for aimbot
local function getClosestPlayerToAim()
    local myRole = getMyRole()
    local myCharacter = LocalPlayer.Character
    if not myCharacter or not myCharacter:FindFirstChild("HumanoidRootPart") then return nil end
    
    local closestPlayer = nil
    local closestDistance = math.huge
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character.Humanoid
            if humanoid.Health > 0 then
                local role = getPlayerRole(player)
                local isPriority = false
                
                -- Priority targeting
                if myRole == "Sheriff" and role == "Murderer" then
                    isPriority = true
                elseif myRole == "Murderer" and role == "Sheriff" then
                    isPriority = true
                end
                
                if isPriority then
                    local distance = (myCharacter.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                    if distance < closestDistance then
                        closestPlayer = player
                        closestDistance = distance
                    end
                end
            end
        end
    end
    
    -- If no priority targets, get closest player
    if not closestPlayer then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character:FindFirstChild("HumanoidRootPart") then
                local humanoid = player.Character.Humanoid
                if humanoid.Health > 0 then
                    local distance = (myCharacter.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                    if distance < closestDistance then
                        closestPlayer = player
                        closestDistance = distance
                    end
                end
            end
        end
    end
    
    return closestPlayer
end

-- Aimbot
local function aimbot()
    if not AimbotEnabled then return end
    
    local target = getClosestPlayerToAim()
    if not target or not target.Character or not target.Character:FindFirstChild("Head") then return end
    
    local myCharacter = LocalPlayer.Character
    if not myCharacter or not myCharacter:FindFirstChild("HumanoidRootPart") then return end
    
    local targetPosition = target.Character.Head.Position
    local aimDirection = (targetPosition - Camera.CFrame.Position).Unit
    local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + aimDirection)
    
    local smoothCFrame = Camera.CFrame:Lerp(targetCFrame, Smoothing / 100)
    Camera.CFrame = smoothCFrame
end

-- Silent Aim
local function applySilentAim(projectile)
    if not SilentAimEnabled then return end
    
    local target = getClosestPlayerToAim()
    if not target or not target.Character or not target.Character:FindFirstChild("Head") then return end
    
    local head = target.Character.Head
    projectile.CFrame = CFrame.new(projectile.Position, head.Position)
end

-- Kill Aura
local function killAura()
    if not KillAuraEnabled then return end
    
    local myCharacter = LocalPlayer.Character
    if not myCharacter or not myCharacter:FindFirstChild("HumanoidRootPart") then return end
    
    local myRole = getMyRole()
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character.Humanoid
            if humanoid.Health > 0 then
                local distance = (myCharacter.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                
                if distance <= KillAuraRange then
                    local targetRole = getPlayerRole(player)
                    
                    if myRole == "Murderer" and targetRole ~= "Murderer" then
                        -- Kill innocents and sheriff
                        if myCharacter:FindFirstChildOfClass("Tool") and myCharacter:FindFirstChildOfClass("Tool"):FindFirstChild("Handle") then
                            local tool = myCharacter:FindFirstChildOfClass("Tool")
                            local handle = tool.Handle
                            handle.Position = player.Character.HumanoidRootPart.Position
                            tool:Activate()
                        else
                            -- Direct damage
                            humanoid:TakeDamage(9999)
                        end
                    elseif myRole == "Sheriff" and targetRole == "Murderer" then
                        -- Shoot murderer
                        if myCharacter:FindFirstChildOfClass("Tool") then
                            local tool = myCharacter:FindFirstChildOfClass("Tool")
                            tool:Activate()
                        end
                    end
                end
            end
        end
    end
end

-- Speed and Fly
local function updateSpeed()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") then return end
    local humanoid = LocalPlayer.Character.Humanoid
    
    if SpeedEnabled then
        humanoid.WalkSpeed = SpeedValue
    else
        humanoid.WalkSpeed = 16
    end
end

local function updateFly()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    
    local humanoid = LocalPlayer.Character.Humanoid
    local rootPart = LocalPlayer.Character.HumanoidRootPart
    
    if FlyEnabled then
        humanoid:ChangeState(Enum.HumanoidStateType.Flying)
        rootPart.Velocity = Vector3.new(0, 0, 0)
        
        -- Flight controls
        local direction = Vector3.new()
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direction += Camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direction -= Camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direction -= Camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direction += Camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            direction += Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            direction -= Vector3.new(0, 1, 0)
        end
        
        rootPart.Velocity = direction.Unit * FlySpeed
    else
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end
end

