local SETTINGS = {
    DetectionRadius = 120,
    ShootCooldown = 1.2,
    MemorySize = 30,
    MoveSpeed = 25, -- Сила движения
    RotationSpeed = 5
}

-- Нейросеть (имитация)
local Brain = {
    Aggression = 0.5,
    Deaths = 0,
    Memory = {},
    CurrentTarget = nil,
    LastPosition = nil,
    StuckCounter = 0
}

-- Создаём кнопку
