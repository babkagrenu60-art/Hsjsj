local function openGui()
    if guiOpen then return end
    guiOpen=true; MF.Visible=true; MF.Size=UDim2.new(0,0,0,0)
    TW:Create(MF,TweenInfo.new(0.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=UDim2.new(0,260,0,290)}):Play()
