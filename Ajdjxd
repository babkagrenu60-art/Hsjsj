local SAVE_KEY = "XenoEditor_LastCode"
local SAVED_INDEX = "XenoEditor_Scripts"
local savedScripts = {}
local scriptCounter = 0

local function encode(str)
    local out = {}
    for i = 1, #str do
        local b = str:byte(i)
        out[i] = string.format("%02x", bit32.bxor(b, 42))
    end
    return table.concat(out)
end

local function decode(hex)
    local out = {}
    for i = 1, #hex, 2 do
        local byte = tonumber(hex:sub(i, i + 1), 16)
        if byte then
            out[#out + 1] = string.char(bit32.bxor(byte, 42))
        end
    end
    return table.concat(out)
end

local function safeWrite(name, data)
    if not writefile then return false end
    return pcall(function() writefile(name, data) end)
end

local function safeRead(name)
    if not readfile then return nil end
    local ok, data = pcall(function() return readfile(name) end)
    if ok then return data end
    return nil
end

local function safeDelete(name)
    if not delfile then return end
    pcall(function() delfile(name) end)
end

local function saveScriptsToDisk()
    local lines = {}
    for _, s in ipairs(savedScripts) do
        local safeName = s.name:gsub("\n", " "):gsub("|", "/")
        lines[#lines + 1] = safeName .. "|" .. encode(s.code)
    end
    safeWrite(SAVED_INDEX .. ".txt", table.concat(lines, "\n"))
end

local function loadScriptsFromDisk()
    savedScripts = {}
    scriptCounter = 0
    local data = safeRead(SAVED_INDEX .. ".txt")
    if not data or data == "" then return end
    for line in data:gmatch("[^\n]+") do
        local name, encoded = line:match("^(.-)|(.+)$")
        if name and encoded then
            local code = decode(encoded)
            if code and code ~= "" then
                table.insert(savedScripts, {name = name, code = code})
                local num = tonumber(name:match("(%d+)$"))
                if num and num > scriptCounter then
                    scriptCounter = num
                end
            end
        end
    end
    if scriptCounter == 0 then
        scriptCounter = #savedScripts
    end
end

