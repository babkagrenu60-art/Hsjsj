local Settings = {
    AutoGun = false, AutoDodge = false, DodgeMode = "Телепорт",
    AutoShoot = false, ShootWithKnife = false, ShootThroughWalls = false,
    KillAura = false, KillDistance = 10, GuardGun = false,
