-- АТАКА
local function attackLoop()
    if aLoop then aLoop:Disconnect() end
    aLoop=RS.Heartbeat:Connect(function(dt)
        if not active then return end
        local c=LP.Character
        if not c then return end
        local hrp=c:FindFirstChild("HumanoidRootPart")
        local h=c:FindFirstChildOfClass("Humanoid")
        if not hrp or not h then return end

        if thrown then
            if h.FloorMaterial~=Enum.Material.Air then thrown=false;landing() end
        end

        local moving=h.MoveDirection.Magnitude>0.1
        local near=false
        local closest=nil
        local minD=999

        for plr,_ in pairs(infected) do
            if plr~=LP and plr.Parent then
                local ch=plr.Character
                if ch then
                    local mh=ch:FindFirstChild("HumanoidRootPart")
                    local mhum=ch:FindFirstChildOfClass("Humanoid")
                    if mh and mhum then
                        local d=(mh.Position-hrp.Position).Magnitude
                        if d<=range then
                            near=true
                            if d<minD then minD=d;closest={char=ch,hrp=mh,hum=mhum} end
                            if d>0.5 then
                                local dir=(hrp.Position-mh.Position)
                                dir=Vector3.new(dir.X,0,dir.Z)
                                if dir.Magnitude>0.1 then
                                    dir=dir.Unit
                                    local np=mh.Position+dir*mSpeed
                                    local r=Ray.new(mh.Position,dir*3)
                                    local ht=workspace:FindPartOnRay(r,ch)
                                    if not ht then mh.CFrame=CFrame.new(np,np+dir) end
                                    if mhum.WalkSpeed==0 then mhum.WalkSpeed=16 end
                                end
                            end
                        else
                            if mhum.WalkSpeed~=0 then mhum.WalkSpeed=0 end
                        end
                    end
                end
            end
        end

        if not moving and near and closest and not thrown and not slow then
            local dir=(hrp.Position-closest.hrp.Position)
            dir=Vector3.new(dir.X,0,dir.Z)
            if dir.Magnitude<0.1 then dir=Vector3.new(0,0,1) end
            dir=dir.Unit
            hrp.AssemblyLinearVelocity=dir*80+Vector3.new(0,60,0)
            shake=1.5
            thrown=true
            if sndOn then
                local s=Instance.new("Sound");s.SoundId=SCREAM;s.Volume=5;s.Parent=hrp;s:Play()
                task.delay(3,function() if s then s:Destroy() end end)
            end
            BodyLbl.Text="💥 МОНСТР ОТКИНУЛ!"
            BodyLbl.TextColor3=Color3.fromRGB(255,50,50)
        end
    end)
end

