-- ========== ОСНОВНЫЕ ЦИКЛЫ ==========
task.spawn(function()
    while task.wait(.5) do
        if Settings.NightVision then updateESP() end
    end
end)

task.spawn(function()
    while task.wait(.1) do
        if Settings.AutoDodge and LocalPlayer.Character then
            local h=LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if h then
                for _,v in pairs(workspace:GetChildren()) do
                    if v:IsA("BasePart") and v.Name=="Knife" then
                        if(v.Position-h.Position).Magnitude<15 then
                            if Settings.DodgeMode=="Телепорт" then
                                h.CFrame=CFrame.new(h.Position+Vector3.new(math.random(-20,20),0,math.random(-20,20)))
                            else
                                local hu=LocalPlayer.Character:FindFirstChild("Humanoid")
                                if hu then hu.Jump=true end
                            end
                            task.wait(.5)
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(.15) do
        if Settings.AutoShoot and LocalPlayer.Character then
            local g=LocalPlayer.Character:FindFirstChild("Gun")
            if g then
                local m=findMurderer()
                if m and m.Character then
                    local h=m.Character:FindFirstChild("HumanoidRootPart")
                    if h then
                        if not Settings.ShootWithKnife or(Settings.ShootWithKnife and m.Character:FindFirstChild("Knife"))then
                            local mouse=LocalPlayer:GetMouse()
                            if mouse then
                                mouse.Hit=CFrame.new(h.Position)
                                UserInputService.InputBegan:Fire(mouse,Enum.UserInputType.MouseButton1)
                                task.wait(.05)
                                UserInputService.InputEnded:Fire(mouse,Enum.UserInputType.MouseButton1)
                            end
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(.05) do
        if Settings.KillAura and LocalPlayer.Character then
            local k=LocalPlayer.Character:FindFirstChild("Knife")
            if k then
                local h=LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if h then
                    for _,p in pairs(Players:GetPlayers()) do
                        if p~=LocalPlayer and p.Character then
                            local th=p.Character:FindFirstChild("HumanoidRootPart")
                            if th then
                                if(h.Position-th.Position).Magnitude<=Settings.KillDistance then
                                    local hu=p.Character:FindFirstChild("Humanoid")
                                    if hu and hu.Health>0 then hu.Health=0 end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(.2) do
        if Settings.GuardGun and LocalPlayer.Character then
            local g=workspace:FindFirstChild("GunDrop")
            if g then
                local h=LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if h then
                    for _,p in pairs(Players:GetPlayers()) do
                        if p~=LocalPlayer and p.Character then
                            local th=p.Character:FindFirstChild("HumanoidRootPart")
                            if th then
                                if(th.Position-g.Position).Magnitude<8 then
                                    local l=h.CFrame
                                    h.CFrame=th.CFrame
                                    task.wait(.3)
                                    h.CFrame=l
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

