local loopConnection = nil

ToggleBtn.MouseButton1Click:Connect(function()
    WH_Enabled = not WH_Enabled
    
    if WH_Enabled then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 50)
        ToggleBtn.Text = "🏃 АВТО-ВЕЛХОП: ВКЛ"
        StatusLabel.Text = "✅ Велхоп активирован!"
        StatusLabel.TextColor3 = Color3.fromRGB(85, 255, 140)
        
        -- Запускаем цикл
        if loopConnection then loopConnection:Disconnect() end
        
        loopConnection = RunService.Heartbeat:Connect(function()
            if WH_Enabled then
                pcall(DoWallHop)
            end
        end)
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 30, 30)
        ToggleBtn.Text = "🏃 АВТО-ВЕЛХОП: ВЫКЛ"
        StatusLabel.Text = "⏸️ Велхоп выключен"
        StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        
        if loopConnection then
            loopConnection:Disconnect()
            loopConnection = nil
        end
    end
end)

