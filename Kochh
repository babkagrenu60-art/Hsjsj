local function sendChat(msg)
    local ev=game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
    if ev then
        local say=ev:FindFirstChild("SayMessageRequest")
        if say then
            pcall(function() say:FireServer(msg,"All") end)
        end
    end
end

