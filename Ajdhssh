local UserInputService = game:GetService("UserInputService")

-- ========== ESP НОЧНОЕ ЗРЕНИЕ ==========
local ESPObjects = {}
local function getPlayerRole(p)
    if p == LocalPlayer then return end
    local c = p.Character
    if not c then return end
    local knife = c:FindFirstChild("Knife") or p.Backpack:FindFirstChild("Knife")
    local gun = c:FindFirstChild("Gun") or p.Backpack:FindFirstChild("Gun")
    if knife and gun then return "Убийца/Шериф"
    elseif knife then return "Убийца"
    elseif gun then return "Шериф"
    else return "Невиновный" end
end

local function createNightVision(p)
    if p == LocalPlayer then return end
    local c = p.Character
    if not c then return end
    if ESPObjects[p] then for _,o in pairs(ESPObjects[p]) do o:Destroy() end ESPObjects[p]=nil end
    if not Settings.NightVision then return end
    local role = getPlayerRole(p)
    local color = role=="Убийца" and Color3.fromRGB(0,255,0) or role=="Шериф" and Color3.fromRGB(0,150,255) or Color3.fromRGB(255,255,255)
    local h = Instance.new("Highlight")
    h.Name = "NightVision"
    h.Adornee = c
    h.FillColor = color
    h.FillTransparency = 0.3
    h.OutlineColor = color
    h.OutlineTransparency = 0.1
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = c
    ESPObjects[p] = {h}
end

local function updateESP()
    for _,p in pairs(Players:GetPlayers()) do createNightVision(p) end
end
local function clearESP()
    for p,o in pairs(ESPObjects) do for _,obj in pairs(o) do obj:Destroy() end end ESPObjects={}
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function() task.wait(.5) createNightVision(p) end)
end)
Players.PlayerRemoving:Connect(function(p)
    if ESPObjects[p] then for _,o in pairs(ESPObjects[p]) do o:Destroy() end ESPObjects[p]=nil end
end)

-- ========== ФУНКЦИИ ==========
local function findMurderer()
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LocalPlayer then
            local c = p.Character
            if c and (c:FindFirstChild("Knife") or p.Backpack:FindFirstChild("Knife")) then return p end
        end
    end return nil
end

