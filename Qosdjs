-- Ближайший игрок
local function getNearest()
    local myChar=LP.Character
    if not myChar then return nil end
    local myHrp=myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end

    local nearest,minDist=nil,maxDist
    for _,plr in ipairs(P:GetPlayers()) do
        if plr~=LP then
            local c=plr.Character
            if c then
                local h=c:FindFirstChild("HumanoidRootPart")
                if h then
                    local d=(h.Position-myHrp.Position).Magnitude
                    if d<minDist then minDist=d; nearest=plr end
                end
            end
        end
    end
    return nearest
end

-- Толчок
local function pushPlayer(plr)
    if not plr then return end
    local myChar=LP.Character
    if not myChar then return end
    local myHrp=myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    local tChar=plr.Character
    if not tChar then return end
    local tHrp=tChar:FindFirstChild("HumanoidRootPart")
    if not tHrp then return end

    local dir=tHrp.Position-myHrp.Position
    if dir.Magnitude<0.1 then dir=Vector3.new(0,0,1) end
    local look=dir.Unit

    -- ВАЖНО: отключаем коллизию у себя на момент толчка, чтобы не отскакивать
    local savedCollide={}
    for _,p in ipairs(myChar:GetDescendants()) do
        if p:IsA("BasePart") then
            savedCollide[p]=p.CanCollide
            p.CanCollide=false
        end
    end

    -- Импульс жертве
    tHrp.AssemblyLinearVelocity=look*pushForce + Vector3.new(0,pushForce*0.5,0)

    -- Рагдолл
    local hum=tChar:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand=true
        task.delay(0.4,function()
            if hum and hum.Parent then hum.PlatformStand=false end
        end)
    end

    -- Возвращаем коллизию через 0.1 сек
    task.delay(0.1,function()
        for p,val in pairs(savedCollide) do
            if p and p.Parent then p.CanCollide=val end
        end
    end)
end

-- Авторежим
local function startAuto()
    if loop then loop:Disconnect() end
    loop=RS.Heartbeat:Connect(function()
        if not active then return end
        local now=tick()
        if now-lastPush<cooldown then return end
        local near=getNearest()
        if near then
            lastPush=now
            pushPlayer(near)
        end
    end)
end

local function stopAuto()
    if loop then loop:Disconnect(); loop=nil end
end

