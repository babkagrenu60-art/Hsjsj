-- 6. ESP (ИСПРАВЛЕННЫЙ)
-- ==========================================
local espHighlights = {}

local function ApplyEsp(player)
	if player == LocalPlayer then return end
	
	local function addHighlight(character)
		if character and not character:FindFirstChild("ESPHighlight") then
			local highlight = Instance.new("Highlight")
			highlight.Name = "ESPHighlight"
			highlight.FillColor = Color3.fromRGB(120, 120, 120) -- Серый
			highlight.FillTransparency = 0.5
			highlight.OutlineColor = Color3.fromRGB(200, 200, 200)
			highlight.OutlineTransparency = 0.3
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Adornee = character
			highlight.Parent = character
			espHighlights[player] = highlight
		end
	end
	
	local function removeHighlight()
		if espHighlights[player] then
			espHighlights[player]:Destroy()
			espHighlights[player] = nil
		end
	end
	
	-- Подключаемся к изменениям персонажа
	if player.Character then
		addHighlight(player.Character)
	end
	
	player.CharacterAdded:Connect(function(character)
		task.wait(0.1)
		addHighlight(character)
	end)
	
	player.CharacterRemoving:Connect(function()
		removeHighlight()
	end)
end

-- Включаем/выключаем ESP
local function UpdateEsp()
	for _, player in pairs(Players:GetPlayers()) do
		if EspActive then
			ApplyEsp(player)
		else
			if espHighlights[player] then
				espHighlights[player]:Destroy()
				espHighlights[player] = nil
			end
		end
	end
end

