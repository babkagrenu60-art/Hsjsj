local aimBone = "Head"
local aimbotEnabled = false
local aimSmoothness = 0.2
local lastAimCF = nil

local function getAimPartFromModel(model)
    if aimBone == "Head" then return model:FindFirstChild("Head") end
    if aimBone == "UpperTorso" then return model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") end
    if aimBone == "LowerTorso" then return model:FindFirstChild("LowerTorso") or model:FindFirstChild("Torso") end
    if aimBone == "LeftArm" then return model:FindFirstChild("Left Arm") or model:FindFirstChild("LeftUpperArm") end
    if aimBone == "RightArm" then return model:FindFirstChild("Right Arm") or model:FindFirstChild("RightUpperArm") end
    if aimBone == "LeftLeg" then return model:FindFirstChild("Left Leg") or model:FindFirstChild("LeftUpperLeg") end
    if aimBone == "RightLeg" then return model:FindFirstChild("Right Leg") or model:FindFirstChild("RightUpperLeg") end
    if aimBone == "HumanoidRootPart" then return model:FindFirstChild("HumanoidRootPart") end
    return model:FindFirstChild("Head")
end

local function getClosestTarget()
    local myChar = LP.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position
    local myRole = getPlayerRole(LP)
    local best, bestDist = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and player.Character then
            local char = player.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local role = getPlayerRole(player)
                local dist = (myPos - hrp.Position).Magnitude
                local isPriority = false
                if myRole == "Sheriff" and role == "Murderer" then isPriority = true end
                if myRole == "Murderer" and role == "Sheriff" then isPriority = true end
                if isPriority and dist < bestDist then best, bestDist = player, dist end
            end
        end
    end
    if not best then
        bestDist = math.huge
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LP and player.Character then
                local char = player.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChild("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local dist = (myPos - hrp.Position).Magnitude
                    if dist < bestDist then best, bestDist = player, dist end
                end
            end
        end
    end
    return best
end

RS.RenderStepped:Connect(function()
    if not aimbotEnabled then return end
    if not UIS.TouchEnabled and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        lastAimCF = nil
        return
    end
    local target = getClosestTarget()
    if not target or not target.Character then return end
    local part = getAimPartFromModel(target.Character)
    if not part then return end
    local targetCF = CFrame.new(CAM.CFrame.Position, part.Position)
    local newCF
    if lastAimCF and aimSmoothness > 0 then
        newCF = lastAimCF:Lerp(targetCF, 1 - aimSmoothness)
    else
        newCF = targetCF
    end
    lastAimCF = newCF
    CAM.CFrame = newCF
end)

