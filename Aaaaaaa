-- Функция выстрела в убийцу
function ShootAtMurderer()
    pcall(function()
        local char = player.Character
        if not char then return end
        
        -- Ищем пистолет
        local gun = char:FindFirstChild("Gun") or player.Backpack:FindFirstChild("Gun")
        if not gun then
            autoShootButton.Text = "❌ НЕТ\nПЕСТА"
            task.wait(1)
            autoShootButton.Text = "🔫\nСТРЕЛЬБА"
            return
        end
        
        -- Если пистолет в бекпаке, берем в руки
        if gun.Parent == player.Backpack then
            gun.Parent = char
        end
        
        -- Ищем убийцу
        local murderer = nil
        for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= player and p.Character then
                local char2 = p.Character
                if char2 then
                    if p.Backpack:FindFirstChild("Knife") or char2:FindFirstChild("Knife") then
                        murderer = char2:FindFirstChild("HumanoidRootPart")
                        break
                    end
                end
            end
        end
        
        if not murderer then
            autoShootButton.Text = "❌ НЕТ\nУБИЙЦЫ"
            task.wait(1)
            autoShootButton.Text = "🔫\nСТРЕЛЬБА"
            return
        end
        
        -- Пытаемся выстрелить
        local shootEvent = gun:FindFirstChild("ShootGun") or gun:FindFirstChildOfClass("RemoteEvent")
        if shootEvent then
            shootEvent:FireServer(murderer.Position)
            autoShootButton.Text = "✅ ВЫСТРЕЛ!"
            task.wait(0.5)
            autoShootButton.Text = "🔫\nСТРЕЛЬБА"
        else
            -- Альтернативный способ
            if gun:IsA("Tool") then
                gun:Activate()
                autoShootButton.Text = "✅ ВЫСТРЕЛ!"
                task.wait(0.5)
                autoShootButton.Text = "🔫\nСТРЕЛЬБА"
            end
        end
    end)
end

