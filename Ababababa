-- Функция для стягивания лута вокруг
local function TeleportItemsToPlayer(itemName)
    local character = game.Players.LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        print("Персонаж не найден!")
        return 
    end
    
    local hrp = character.HumanoidRootPart
    local count = 0
    
    for _, item in pairs(workspace:GetChildren()) do
        if item:IsA("Tool") or (item:IsA("Model") and string.find(string.lower(item.Name), string.lower(itemName))) then
            local primaryPart = nil
            
            -- Ищем основную часть предмета
            if item:IsA("Model") then
                primaryPart = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
            else
                primaryPart = item
            end
            
            if primaryPart and primaryPart:IsA("BasePart") then
                -- Проверяем, что предмет не внутри персонажа
                if not primaryPart:IsDescendantOf(character) then
                    -- Телепортируем к игроку с небольшим смещением
                    local offset = Vector3.new(
                        math.random(-3, 3),
                        2,
                        math.random(-3, 3)
                    )
                    primaryPart.CFrame = hrp.CFrame + offset
                    count = count + 1
                end
            end
        end
    end
    
    print("Собрано предметов: " .. count)
end

