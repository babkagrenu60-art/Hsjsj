-- ФУНКЦИЯ АНИМАЦИЙ БЕКОНА
local function AnimateBacon(baconModel, animationType)
    local hrp = baconModel:FindFirstChild("HumanoidRootPart")
    local torso = baconModel:FindFirstChild("Torso")
    local head = baconModel:FindFirstChild("Head")
    
    if not hrp or not torso then return end
    
    if animationType == "wave" then
        -- МАШЕТ РУКОЙ (поворот корпуса)
        local t1 = TweenService:Create(torso, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {
            CFrame = torso.CFrame * CFrame.Angles(0, 1.5, 0)
        })
        local t2 = TweenService:Create(torso, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {
            CFrame = torso.CFrame * CFrame.Angles(0, -1.5, 0)
        })
        t1:Play()
        t1.Completed:Wait()
        t2:Play()
        t2.Completed:Wait()
        
    elseif animationType == "dance" then
        -- ТАНЕЦ
        for i = 1, 6 do
            local t = TweenService:Create(hrp, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {
                CFrame = hrp.CFrame * CFrame.Angles(0, 0.5, 0)
            })
            t:Play()
            t.Completed:Wait()
            local t2 = TweenService:Create(hrp, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {
                CFrame = hrp.CFrame * CFrame.Angles(0, -0.5, 0)
            })
            t2:Play()
            t2.Completed:Wait()
        end
        
    elseif animationType == "jump" then
        -- ПРЫЖОК
        local t = TweenService:Create(hrp, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
            Position = hrp.Position + Vector3.new(0, 5, 0)
        })
        t:Play()
        t.Completed:Wait()
        local t2 = TweenService:Create(hrp, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
            Position = hrp.Position - Vector3.new(0, 5, 0)
        })
        t2:Play()
        t2.Completed:Wait()
        
    elseif animationType == "fall" then
        -- ПАДЕНИЕ (наклон)
        local t = TweenService:Create(hrp, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {
            CFrame = hrp.CFrame * CFrame.Angles(1.5, 0, 0)
        })
        t:Play()
        t.Completed:Wait()
    end
end

