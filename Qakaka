-- ================= ЛОГИКА СУПЕР-ФУНКЦИЙ =================

local player = game.Players.LocalPlayer
local egorWalkActive = false
local egorGravActive = false

-- Смена обычной гравитации
ApplyButton.MouseButton1Click:Connect(function()
    local targetGravity = tonumber(GravityInput.Text)
    if targetGravity then
        workspace.Gravity = targetGravity
        ApplyButton.BackgroundColor3 = Color3.fromRGB(0, 200, 50)
        task.wait(0.5)
        ApplyButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    else
        ApplyButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        task.wait(0.5)
        ApplyButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    end
end)

-- 1. Эффект "Роблокс Егор (Бег)"
EgorWalkButton.MouseButton1Click:Connect(function()
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    
    egorWalkActive = not egorWalkActive
    
    if egorWalkActive then
        EgorWalkButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0) -- Красный (Активен)
        
        -- Уменьшаем скорость ходьбы персонажа, чтобы он шел медленно
        humanoid.WalkSpeed = 4 
        
        -- Цикл, который заставляет анимацию ног проигрываться безумно быстро
        task.spawn(function()
            while egorWalkActive and character and humanoid.Parent do
                for _, animScript in pairs(character:GetChildren()) do
                    if animScript.Name == "Animate" then
                        -- Ускоряем скорость воспроизведения анимаций ходьбы и бега
                        pcall(function()
                            animScript.walk.WalkAnim.AnimationId = animScript.run.RunAnim.AnimationId
                        end)
                    end
                end
                
                -- Разгоняем скорость треков анимации ног через аниматор
                local animator = humanoid:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                        if track.Name:lower():find("walk") or track.Name:lower():find("run") then
                            track:AdjustSpeed(25) -- Скорость перебирания ногами х25!
                        end
                    end
                end
                task.wait(0.05)
            end
        end)
    else
        -- Возвращаем всё назад
        EgorWalkButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        humanoid.WalkSpeed = 16
    end
end)

-- 2. Эффект "Роблокс Егор Гравитация" (Нормальный прыжок + лаганный спуск)
EgorGravButton.MouseButton1Click:Connect(function()
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local hrp = character:WaitForChild("HumanoidRootPart")
    
    egorGravActive = not egorGravActive
    
    if egorGravActive then
        EgorGravButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0) -- Красный (Активен)
        
        task.spawn(function()
            while egorGravActive and character and hrp.Parent do
                -- Проверяем, падает ли персонаж вниз после прыжка
                if hrp.AssemblyLinearVelocity.Y < -2 then
                    -- Имитируем "лагающее приземление": искусственно притормаживаем падение
                    hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, -3, hrp.AssemblyLinearVelocity.Z)
                    
                    -- Создаем визуальный микро-дерганый эффект (лаг)
                    hrp.CFrame = hrp.CFrame * CFrame.new(0, math.sin(tick() * 50) * 0.05, 0)
                end
                task.wait(0.02)
            end
        end)
    else
        EgorGravButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end
end)
