-- Фоновый поток для атак и добычи
task.spawn(function()
    while task.wait(0.3) do
        pcall(function()
            local char = game.Players.LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                local hrp = char.HumanoidRootPart
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                
                -- Радиус атаки
                local attackRadius = 25
                
                -- Киллаура на волков, культистов и мобов
                if KillAuraEnabled then
                    for _, monster in pairs(workspace:GetChildren()) do
                        if monster:FindFirstChild("Humanoid") and 
                           monster:FindFirstChild("HumanoidRootPart") and 
                           not game.Players:GetPlayerFromCharacter(monster) then
                            
                            local monsterHumanoid = monster:FindFirstChildOfClass("Humanoid")
                            local monsterHRP = monster:FindFirstChild("HumanoidRootPart")
                            
                            -- Проверяем, что монстр жив и не игрок
                            if monsterHumanoid and monsterHumanoid.Health > 0 and monsterHRP then
                                local distance = (hrp.Position - monsterHRP.Position).Magnitude
                                if distance < attackRadius then
                                    -- Атакуем монстра
                                    local tool = char:FindFirstChildWhichIsA("Tool")
                                    if tool and tool:IsA("Tool") then
                                        tool:Activate()
                                    end
                                    
                                    -- Наносим урон
                                    monsterHumanoid.Health = monsterHumanoid.Health - 10
                                end
                            end
                        end
                    end
                end
                
                -- Киллаура на деревья
                if TreeAuraEnabled then
                    for _, tree in pairs(workspace:GetChildren()) do
                        if string.find(string.lower(tree.Name), "tree") or 
                           string.find(string.lower(tree.Name), "log") or
                           string.find(string.lower(tree.Name), "trunk") then
                            
                            local treePart = tree:FindFirstChildWhichIsA("BasePart") or tree:FindFirstChild("Part") or tree
                            if treePart and treePart:IsA("BasePart") then
                                local distance = (hrp.Position - treePart.Position).Magnitude
                                if distance < 45 then
                                    local tool = char:FindFirstChildWhichIsA("Tool")
                                    if tool and tool:IsA("Tool") then
                                        tool:Activate()
                                        -- Имитация добычи
                                        task.wait(0.1)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end)

