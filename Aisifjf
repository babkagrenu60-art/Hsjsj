    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = CFG.PanelColor
    btn.BorderSizePixel = 0
    btn.Text = name .. ": ВЫКЛ"
    btn.TextColor3 = CFG.TextColor
    btn.TextSize = 10
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.Parent = scroll
    corner(btn, 5)
    stroke(btn, CFG.BorderColor, 1)
    local state = defaultState or false
    if state then
        btn.Text = name .. ": ВКЛ"
        btn.BackgroundColor3 = Color3.fromRGB(30, 60, 90)
    end
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = name .. ": " .. (state and "ВКЛ" or "ВЫКЛ")
        TW:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = state and Color3.fromRGB(30, 60, 90) or CFG.PanelColor
        }):Play()
        local ok, err = pcall(callback, state)
        if not ok then print("[XENO] " .. name .. ": " .. tostring(err)) end
        showNotification(name, state)
    end)
    return btn
end

