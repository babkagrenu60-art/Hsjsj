-- ===== АНИМАЦИИ GUI =====
local function openGui()
    if guiOpen then return end
    guiOpen=true; MF.Visible=true; MF.Size=UDim2.new(0,0,0,0)
    TW:Create(MF,TweenInfo.new(0.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=CFG.Size}):Play()
end
local function closeGui()
    if not guiOpen then return end
    guiOpen=false
    local t=TW:Create(MF,TweenInfo.new(0.18,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Size=UDim2.new(0,0,0,0)})
    t:Play(); t.Completed:Connect(function() MF.Visible=false end)
end

Icon.MouseButton1Click:Connect(function() if guiOpen then closeGui() else openGui() end end)
CB.MouseButton1Click:Connect(closeGui)

-- Перетаскивание
do
    local drag,ds,sp=false,nil,nil
    TB.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            drag=true; ds=i.Position; sp=MF.Position
            i.Changed:Connect(function() if i.UserInputState==Enum.UserInputState.End then drag=false end end)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
            local d=i.Position-ds
            MF.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
        end
    end)
end

-- ===== ЛОГИКА ПОЛЁТА (коллизия-отталкивание) =====
local function startFly()
    isFlying=true
    FlyTxt.Text="☄️  ВЫКЛЮЧИТЬ"
    FlyTxt.TextColor3=Color3.fromRGB(255,150,100)
    FlyBtn.BackgroundColor3=Color3.fromRGB(55,35,25)
    StatusLbl.Text="Активно · летишь"
    StatusLbl.TextColor3=Color3.fromRGB(255,150,100)

    local char=LP.Character
    if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    -- Анимация полёта
    local animator=hum:FindFirstChildOfClass("Animator")
    if animator then
        flyAnim=Instance.new("Animation")
        flyAnim.AnimationId=FLY_ANIM_ID
        local success,track=pcall(function() return animator:LoadAnimation(flyAnim) end)
        if success and track then
            flyAnimTrack=track
            flyAnimTrack.Priority=Enum.AnimationPriority.Action
            flyAnimTrack.Looped=true
            flyAnimTrack:Play()
        end
    end

    hum.PlatformStand=true
    hum:ChangeState(Enum.HumanoidStateType.Physics)

    -- Включаем коллизию у всех частей тела
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide=true
            p.Massless=false
        end
    end

    -- Ты становишься тяжёлым — чтобы отталкивать, а не отскакивать
    hrp.CustomPhysicalProperties=PhysicalProperties.new(50,0.3,0.5,100,100)

    -- Цикл полёта
    flyLoop=RS.Heartbeat:Connect(function(dt)
        if not isFlying then return end
        local c=LP.Character
        if not c then return end
        local h=c:FindFirstChild("HumanoidRootPart")
        if not h then return end

        local cam=workspace.CurrentCamera
        local lookDir=cam.CFrame.LookVector
        local moveDir=lookDir

        local move=hum.MoveDirection
        if move.Magnitude>0 then
            moveDir=moveDir+move*2
            moveDir=moveDir.Unit
        end

        -- Держим скорость + массу
        h.AssemblyLinearVelocity=moveDir*CFG.Speed
        h.CustomPhysicalProperties=PhysicalProperties.new(50,0.3,0.5,100,100)
        for _,p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide=true
                p.Massless=false
            end
        end
    end)
end

local function stopFly()
    isFlying=false
    FlyTxt.Text="☄️  ВКЛЮЧИТЬ"
    FlyTxt.TextColor3=Color3.fromRGB(200,200,210)
    FlyBtn.BackgroundColor3=Color3.fromRGB(35,35,50)
    StatusLbl.Text="Выключено"
    StatusLbl.TextColor3=Color3.fromRGB(150,150,160)

    if flyLoop then flyLoop:Disconnect(); flyLoop=nil end

    if flyAnimTrack then
        flyAnimTrack:Stop()
        flyAnimTrack=nil
    end
    flyAnim=nil

    local char=LP.Character
    if char then
        local hum=char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand=false end
    end
end

FlyBtn.MouseButton1Click:Connect(function()
    if isFlying then stopFly() else startFly() end
end)

LP.CharacterAdded:Connect(function()
    if isFlying then stopFly() end
end)

