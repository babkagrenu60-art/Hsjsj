-- ===== ОБРАБОТКА ПЛАТФОРМ =====
local function makeBlack(part)
    if not part or not part.Parent then return end
    if doneParts[part] then return end
    doneParts[part]=true

    -- Сохраняем оригинальный цвет
    part:SetAttribute("OrigColor",part.Color)
    part.Color=Color3.fromRGB(0,0,0)
    part.Material=Enum.Material.SmoothPlastic

    -- Надпись "КУЛКИД" на всех сторонах
    for _,face in ipairs{Enum.NormalId.Top,Enum.NormalId.Bottom,Enum.NormalId.Front,Enum.NormalId.Back,Enum.NormalId.Left,Enum.NormalId.Right} do
        local gui=Instance.new("SurfaceGui")
        gui.Face=face
        gui.CanvasSize=Vector2.new(400,400)
        gui.LightInfluence=0
        gui.Parent=part

        local frame=Instance.new("Frame")
        frame.Size=UDim2.new(1,0,1,0)
        frame.BackgroundColor3=Color3.fromRGB(0,0,0)
        frame.BackgroundTransparency=1
        frame.Parent=gui

        local txt=Instance.new("TextLabel")
        txt.Size=UDim2.new(1,0,1,0)
        txt.BackgroundTransparency=1
        txt.Text="КУЛКИД"
        txt.TextColor3=Color3.fromRGB(255,0,0)
        txt.TextScaled=true
        txt.Font=Enum.Font.GothamBlack
        txt.TextStrokeTransparency=0
        txt.TextStrokeColor3=Color3.fromRGB(0,0,0)
        txt.Parent=frame
    end

    -- Звук при касании
    part.Touched:Connect(function(hit)
        if not active then return end
        local char=hit.Parent
        if not char then return end
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        local hrp=char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local snd=Instance.new("Sound")
            snd.SoundId=SCREAM_ID
            snd.Volume=5
            snd.Parent=hrp
            snd:Play()
            task.delay(5,function() if snd then snd:Destroy() end end)
        end
    end)
end

local function scanPlatforms()
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name=="PlatformPart" then
            makeBlack(obj)
        end
    end
end

local function startMode()
    active=true
    MainBtn.Text="🖤  ВЫКЛЮЧИТЬ"
    MainBtn.BackgroundColor3=Color3.fromRGB(80,20,20)
    StatusLbl.Text="КУЛКИД активен"
    StatusLbl.TextColor3=Color3.fromRGB(255,50,50)
    scanPlatforms()
    -- Постоянно проверяем новые платформы
    if loop then loop:Disconnect() end
    loop=RS.Heartbeat:Connect(function()
        if not active then return end
        scanPlatforms()
    end)
end

local function stopMode()
    active=false
    if loop then loop:Disconnect();loop=nil end
    MainBtn.Text="🖤  ВКЛЮЧИТЬ КУЛКИД"
    MainBtn.BackgroundColor3=Color3.fromRGB(40,20,20)
    StatusLbl.Text="Выключено"
    StatusLbl.TextColor3=Color3.fromRGB(150,150,160)
end

local function resetPlatforms()
    for part,_ in pairs(doneParts) do
        if part and part.Parent then
            local orig=part:GetAttribute("OrigColor")
            if orig then part.Color=orig end
            part.Material=Enum.Material.Plastic
            -- Убираем SurfaceGui
            for _,c in ipairs(part:GetChildren()) do
                if c:IsA("SurfaceGui") then c:Destroy() end
            end
        end
    end
    doneParts={}
    StatusLbl.Text="Платформы сброшены"
    StatusLbl.TextColor3=Color3.fromRGB(150,200,255)
end

MainBtn.MouseButton1Click:Connect(function()
    if active then stopMode() else startMode() end
end)
ResetBtn.MouseButton1Click:Connect(resetPlatforms)

