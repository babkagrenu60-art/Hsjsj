        loadBtn.Text="📄  "..script.name
        loadBtn.TextColor3=Color3.fromRGB(200,200,220)
        loadBtn.TextSize=11
        loadBtn.Font=Enum.Font.GothamBold
        loadBtn.TextXAlignment=Enum.TextXAlignment.Left
        loadBtn.AutoButtonColor=false
        loadBtn.Parent=row
        loadBtn.MouseButton1Click:Connect(function()
            CodeBox.Text=script.code
            selectTab(1)
            StatusLbl.Text="> Загружен: "..script.name
            StatusLbl.TextColor3=Color3.fromRGB(150,255,150)
        end)

        local delBtn=Instance.new("TextButton")
        delBtn.Size=UDim2.new(0,34,0,28)
        delBtn.Position=UDim2.new(1,-38,0,4)
        delBtn.BackgroundColor3=Color3.fromRGB(140,40,40)
        delBtn.BorderSizePixel=0
        delBtn.Text="🗑"
        delBtn.TextColor3=Color3.fromRGB(255,255,255)
        delBtn.TextSize=14
        delBtn.Font=Enum.Font.GothamBold
        delBtn.AutoButtonColor=false
        delBtn.Parent=row
        cr(delBtn,6)
        st(delBtn,Color3.fromRGB(200,80,80),1)
        delBtn.MouseButton1Click:Connect(function()
            local name=script.name
            table.remove(savedScripts,i)
            refreshSaved()
            saveListToFile()
            StatusLbl.Text="> Удалён: "..name
            StatusLbl.TextColor3=Color3.fromRGB(255,150,150)
