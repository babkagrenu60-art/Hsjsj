local SAVE_KEY="XenoEditorScript"
local SAVED_LIST_KEY="XenoEditorList"
local savedScripts={}

-- Функция сохранения списка в файл
local function saveListToFile()
    if not writefile then return end
    local data=""
    for _,s in ipairs(savedScripts) do
        data=data..s.name.."\n===\n"..s.code.."\n===\n"
    end
    pcall(function() writefile(SAVED_LIST_KEY..".txt",data) end)
end

-- Загрузка списка из файла
local function loadListFromFile()
    if not readfile then return end
    local ok,data=pcall(function() return readfile(SAVED_LIST_KEY..".txt") end)
    if not ok or not data then return end
    local parts={}
    for chunk in data:gmatch("([^=]+)===") do
        table.insert(parts,chunk)
    end
    -- Простой парсер: имя, код, имя, код...
    local i=1
    while i<#parts do
        local name=parts[i]:gsub("^%s*(.-)%s*$","%1")
        local code=parts[i+1]
        if name and code and name~="" then
            table.insert(savedScripts,{name=name,code=code})
        end
        i=i+2
    end
end

local function refreshSaved()
    for _,c in ipairs(SavedScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    for i,script in ipairs(savedScripts) do
        local row=Instance.new("Frame")
