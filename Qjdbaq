local farmLoop=nil
local collectLoop=nil
local buildLoop=nil
local spawnLoop=nil

FarmBtn.MouseButton1Click:Connect(function()
    CFG.AutoFarm=not CFG.AutoFarm
    if CFG.AutoFarm then
        FarmBtn.Text="⏹  ОСТАНОВИТЬ ФАРМ"
        FarmBtn.BackgroundColor3=Color3.fromRGB(60,30,30)
        StatusLbl.Text="⛵ Фарм активен..."
        StatusLbl.TextColor3=Color3.fromRGB(150,255,150)
        if farmLoop then farmLoop:Disconnect() end
        farmLoop=RS.Heartbeat:Connect(function()
            if not CFG.AutoFarm then return end
            local _,_,hrp=getChar()
            if hrp then
                local target=Vector3.new(0,100,0)
                for _,obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and obj.Name:lower():find("treasure") then
                        target=obj.Position
                        break
                    end
                end
                if hrp.Position.Y<target.Y-50 then
                    hrp.CFrame=CFrame.new(target)
                end
            end
        end)
    else
        FarmBtn.Text="▶  АВТОФАРМ ЗОЛОТА"
        FarmBtn.BackgroundColor3=Color3.fromRGB(30,50,30)
        StatusLbl.Text="Остановлено"
        StatusLbl.TextColor3=Color3.fromRGB(180,180,190)
        if farmLoop then farmLoop:Disconnect();farmLoop=nil end
    end
end)

ResetBtn.MouseButton1Click:Connect(function()
    local c=getChar()
    if c then
        local h=c:FindFirstChildOfClass("Humanoid")
        if h then h.Health=0 end
    end
end)

AutoCollectBtn.MouseButton1Click:Connect(function()
    CFG.AutoCollect=not CFG.AutoCollect
    if CFG.AutoCollect then
        AutoCollectBtn.Text="💰  АВТО-СБОР (ВКЛ)"
        AutoCollectBtn.BackgroundColor3=Color3.fromRGB(70,70,40)
        if collectLoop then collectLoop:Disconnect() end
        collectLoop=RS.Heartbeat:Connect(function()
            if not CFG.AutoCollect then return end
            local _,_,hrp=getChar()
            if hrp then
                for _,obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        local n=obj.Name:lower()
                        if n:find("gold") or n:find("coin") or n:find("treasure") then
                            local d=(obj.Position-hrp.Position).Magnitude
                            if d<50 then
                                hrp.CFrame=CFrame.new(obj.Position+Vector3.new(0,3,0))
                                break
                            end
                        end
                    end
                end
            end
        end)
    else
        AutoCollectBtn.Text="💰  АВТО-СБОР ЗОЛОТА"
        AutoCollectBtn.BackgroundColor3=Color3.fromRGB(50,50,25)
        if collectLoop then collectLoop:Disconnect();collectLoop=nil end
    end
end)

