-- Функция телепортации предметов
function TeleportItemsToPlayer(itemName)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then 
        print("❌ Персонаж не найден!")
        return 
    end
    
    local hrp = char.HumanoidRootPart
    local count = 0
    
    for _, item in pairs(workspace:GetChildren()) do
        if item:IsA("Tool") or (item:IsA("Model") and string.find(string.lower(item.Name), string.lower(itemName))) then
            local primaryPart = nil
            if item:IsA("Model") then
                primaryPart = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
            else
                primaryPart = item
            end
            
            if primaryPart and primaryPart:IsA("BasePart") then
                if not primaryPart:IsDescendantOf(char) then
                    local offset = Vector3.new(math.random(-3, 3), 2, math.random(-3, 3))
                    primaryPart.CFrame = hrp.CFrame + offset
                    count = count + 1
                end
            end
        end
    end
    
    print("✅ Собрано " .. itemName .. ": " .. count .. " шт")
end

-- Функция броска в костер
function ThrowToCampfire()
    local campfire = nil
    for _, obj in pairs(workspace:GetChildren()) do
        if string.find(string.lower(obj.Name), "campfire") or 
           string.find(string.lower(obj.Name), "fire") or
           string.find(string.lower(obj.Name), "camp") then
            campfire = obj
            break
        end
    end
    
    if not campfire then
        print("❌ Костер не найден!")
        return
    end
    
    local campfirePart = campfire:FindFirstChildWhichIsA("BasePart") or campfire:FindFirstChild("Part") or campfire
    if not campfirePart or not campfirePart:IsA("BasePart") then return end
    
    local count = 0
    local char = player.Character
    for _, item in pairs(workspace:GetChildren()) do
        if string.find(string.lower(item.Name), string.lower(SelectedCampfireItem)) then
            local part = item:FindFirstChildWhichIsA("BasePart") or item
            if part and part:IsA("BasePart") then
                if char and not part:IsDescendantOf(char) then
                    part.CFrame = campfirePart.CFrame + Vector3.new(math.random(-2, 2), 1, math.random(-2, 2))
                    count = count + 1
                end
            end
        end
    end
    print("✅ Брошено в костер: " .. count .. " шт")
end

-- Функция отправки в скрап
function SendToScrap()
    local scrapMachine = nil
    for _, obj in pairs(workspace:GetChildren()) do
        if string.find(string.lower(obj.Name), "scrap") or 
           string.find(string.lower(obj.Name), "chipper") or
           string.find(string.lower(obj.Name), "grinder") or
           string.find(string.lower(obj.Name), "machine") then
            scrapMachine = obj
            break
        end
    end
    
    if not scrapMachine then
        print("❌ Скрап-машина не найдена!")
        return
    end
    
    local machinePart = scrapMachine:FindFirstChildWhichIsA("BasePart") or scrapMachine:FindFirstChild("Part") or scrapMachine
    if not machinePart or not machinePart:IsA("BasePart") then return end
    
    local count = 0
    local char = player.Character
    for _, item in pairs(workspace:GetChildren()) do
        if string.find(string.lower(item.Name), string.lower(SelectedScrapItem)) then
            local part = item:FindFirstChildWhichIsA("BasePart") or item
            if part and part:IsA("BasePart") then
                if char and not part:IsDescendantOf(char) then
                    part.CFrame = machinePart.CFrame + Vector3.new(math.random(-2, 2), 1, math.random(-2, 2))
                    count = count + 1
                end
            end
        end
    end
    print("✅ Отправлено в скрап: " .. count .. " шт")
end

