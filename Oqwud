-- ===== ОСНОВНАЯ ЛОГИКА =====
local function isSheriffGun(tool)
    if not tool then return false end
    local n=tool.Name:lower()
    return n:find("gun") or n:find("pistol") or n:find("sheriff") or n:find("revolver")
end

local function clearReload(tool)
    if not tool then return end
    -- Ищем скрипты перезарядки
    for _,obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript") then
            if obj.Name:lower():find("reload") or obj.Name:lower():find("ammo") then
                obj.Disabled=true
            end
        end
        -- Убираем анимации перезарядки
        if obj:IsA("Animation") then
            if obj.AnimationId~="" then
                obj.AnimationId=""
            end
        end
    end
    -- Сбрасываем атрибут перезарядки
    tool:SetAttribute("Reloading",false)
    tool:SetAttribute("Ammo",math.huge)
    tool:SetAttribute("MaxAmmo",math.huge)
    tool:SetAttribute("Reload",0)
    tool:SetAttribute("ReloadTime",0)
    -- Сбрасываем значения
    for _,v in ipairs(tool:GetChildren()) do
        if v:IsA("NumberValue") then
            if v.Name:lower():find("ammo") then v.Value=math.huge end
            if v.Name:lower():find("reload") then v.Value=0 end
        end
        if v:IsA("BoolValue") then
            if v.Name:lower():find("reload") then v.Value=false end
        end
    end
end

local function scan()
    local char=LP.Character
    if not char then return end
    for _,tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and isSheriffGun(tool) then
            clearReload(tool)
        end
    end
end

local function startLoop()
    if gunLoop then gunLoop:Disconnect() end
    gunLoop=RS.Heartbeat:Connect(function()
        if not active then return end
        scan()
    end)
end

