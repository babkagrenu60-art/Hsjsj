fpsSlider.FocusLost:Connect(function(enter)
    if enter then
        local val = tonumber(fpsSlider.Text)
        if val and val > 0 and val <= 144 then
            setfpscap(val)
            fpsSlider.Text = tostring(val)
        else
            fpsSlider.Text = "60"
        end
    end
end)

