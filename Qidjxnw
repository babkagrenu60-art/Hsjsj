local function startShakeLoop()
    if shakeLoop then shakeLoop:Disconnect() end
    shakeLoop=task.spawn(function()
        while active do
            task.wait(math.random(4,10))
            if active then
                shakeIntensity=math.random(8,20)/10
            end
        end
    end)
end

