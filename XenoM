local savedScripts={}

local function refreshSaved()
    for _,c in ipairs(SavedScroll:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    for i,script in ipairs(savedScripts) do
        local btn=Instance.new("TextButton")
        btn.Size=UDim2.new(1,-6,0,36)
        btn.BackgroundColor3=Color3.fromRGB(22,22,30)
        btn.BorderSizePixel=0
        btn.Text="📄  "..script.name
        btn.TextColor3=Color3.fromRGB(200,200,220)
        btn.TextSize=11
        btn.Font=Enum.Font.GothamBold
        btn.TextXAlignment=Enum.TextXAlignment.Left
        btn.AutoButtonColor=false
        btn.Parent=SavedScroll
        cr(btn,6)
        st(btn,Color3.fromRGB(40,40,60),1)
        btn.MouseButton1Click:Connect(function()
            CodeBox.Text=script.code
            selectTab(1)
            StatusLbl.Text="> Загружен: "..script.name
            StatusLbl.TextColor3=Color3.fromRGB(150,255,150)
        end)
    end
end

