local function makeBtn(parent,text,y,color)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(1,-10,0,42)
    b.Position=UDim2.new(0,5,0,y)
    b.BackgroundColor3=color or Color3.fromRGB(35,35,55)
