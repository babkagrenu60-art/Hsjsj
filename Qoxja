-- ФУНКЦИЯ: высокий прыжок при ударе головой
local function startJump1()
    if loop1 then loop1:Disconnect() end
    loop1=RS.Heartbeat:Connect(function()
        if not active1 then return end
        local c=LP.Character
        if not c then return end
        local h=c:FindFirstChild("Humanoid")
        local hrp=c:FindFirstChild("HumanoidRootPart")
        if not h or not hrp then return end
        -- Проверяем: в воздухе и над головой есть платформа
        if h.FloorMaterial==Enum.Material.Air and h:GetState()~=Enum.HumanoidStateType.Jumping then
            local ray=Ray.new(hrp.Position,Vector3.new(0,6,0))
            local hit=workspace:FindPartOnRay(ray,c)
            if hit and h:GetState()==Enum.HumanoidStateType.Freefall then
                hrp.AssemblyLinearVelocity=Vector3.new(hrp.AssemblyLinearVelocity.X,120,hrp.AssemblyLinearVelocity.Z)
            end
        end
    end)
end

local function stopJump1()
    if loop1 then loop1:Disconnect();loop1=nil end
end

-- ФУНКЦИЯ: wall hop (прыжок по стене)
local function startWallHop()
    if loop2 then loop2:Disconnect() end
    loop2=RS.Heartbeat:Connect(function()
        if not active2 then return end
        local c=LP.Character
        if not c then return end
        local h=c:FindFirstChild("Humanoid")
        local hrp=c:FindFirstChild("HumanoidRootPart")
        if not h or not hrp then return end
        -- Проверяем: в воздухе, рядом стена, держим прыжок
        if h.FloorMaterial==Enum.Material.Air then
            local ray=Ray.new(hrp.Position,Vector3.new(0,0,-1.5))
            local hit=workspace:FindPartOnRay(ray,c)
            if hit then
                -- Держим прыжок зажатым
                h.JumpPower=50
                if h:GetState()~=Enum.HumanoidStateType.Jumping then
                    h:ChangeState(Enum.HumanoidStateType.Jumping)
                end
                -- Толчок вверх и в сторону от стены
                local wallNormal=hit.Normal or Vector3.new(0,0,1)
                local up=Vector3.new(0,1,0)
                local push=up*50 + wallNormal*30
                hrp.AssemblyLinearVelocity=push
            end
        end
    end)
end

local function stopWallHop()
    if loop2 then loop2:Disconnect();loop2=nil end
    local c=LP.Character
    if c then local h=c:FindFirstChild("Humanoid");if h then h.JumpPower=50 end end
end

-- ФУНКЦИЯ: отталкивание от стены
local function startWallPush()
    if loop3 then loop3:Disconnect() end
    loop3=RS.Heartbeat:Connect(function()
        if not active3 then return end
        local c=LP.Character
        if not c then return end
        local h=c:FindFirstChild("Humanoid")
        local hrp=c:FindFirstChild("HumanoidRootPart")
        if not h or not hrp then return end
        -- Проверяем: в воздухе и рядом стена
        if h.FloorMaterial==Enum.Material.Air then
            local ray=Ray.new(hrp.Position,Vector3.new(0,0,-2))
            local hit=workspace:FindPartOnRay(ray,c)
            if hit then
                local wallNormal=hit.Normal or Vector3.new(0,0,1)
                -- Толкает вверх и вдаль от стены
                local push=Vector3.new(0,100,0) + wallNormal*80
                hrp.AssemblyLinearVelocity=push
            end
        end
    end)
end

local function stopWallPush()
    if loop3 then loop3:Disconnect();loop3=nil end
end

