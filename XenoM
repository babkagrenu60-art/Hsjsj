-- ===== ЛОГИКА =====
local SAVE_KEY="XenoEditorScript"

SaveBtn.MouseButton1Click:Connect(function()
    local code=CodeBox.Text
    local saved=false
    if writefile then
        local ok=pcall(function()
            writefile(SAVE_KEY..".lua",code)
        end)
        if ok then saved=true end
    end
    if not saved and setclipboard then
        pcall(function() setclipboard(code) end)
        saved=true
    end
    if saved then
        -- Добавляем в список
        table.insert(savedScripts,{name="Script_"..#savedScripts+1,code=code})
        refreshSaved()
        StatusLbl.Text="> СОХРАНЕНО"
        StatusLbl.TextColor3=Color3.fromRGB(150,255,150)
    else
        StatusLbl.Text="> ОШИБКА"
        StatusLbl.TextColor3=Color3.fromRGB(255,150,150)
    end
end)

RunBtn.MouseButton1Click:Connect(function()
    local code=CodeBox.Text
    StatusLbl.Text="> ЗАПУСК..."
    StatusLbl.TextColor3=Color3.fromRGB(255,200,80)
    local ok,err=pcall(function()
        local func=loadstring(code)
        if func then func() else error("Ошибка компиляции") end
    end)
    if ok then
        StatusLbl.Text="> ЗАПУЩЕНО"
        StatusLbl.TextColor3=Color3.fromRGB(150,255,150)
    else
        StatusLbl.Text="> ОШИБКА: "..tostring(err):sub(1,35)
        StatusLbl.TextColor3=Color3.fromRGB(255,100,100)
    end
end)

-- Загружаем сохранённый
