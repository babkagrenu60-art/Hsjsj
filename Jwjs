-- Получение всех игроков
function GetPlayers()
    local players = {}
    for _, plr in pairs(game:GetService("Players"):GetPlayers()) do
        if plr ~= Player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(players, plr)
        end
    end
    return players
end

-- Получение всех предметов на карте (ножи, пистолеты)
function GetItems()
    local items = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Tool") and v:FindFirstChild("Handle") then
            local item = {
                Name = v.Name,
                Position = v.Handle.Position,
                Tool = v
            }
            table.insert(items, item)
        end
    end
    return items
end

-- Проверка, является ли игрок убийцей
function IsMurderer(plr)
    if not plr or not plr.Character then return false end
    for _, tool in pairs(plr.Character:GetChildren()) do
        if tool:IsA("Tool") and tool:FindFirstChild("Handle") then
            if string.lower(tool.Name):find("knife") or string.lower(tool.Name):find("sword") then
                return true
            end
        end
    end
    return false
end

-- Проверка, есть ли у игрока пистолет
function HasGun(plr)
    if not plr or not plr.Character then return false end
    for _, tool in pairs(plr.Character:GetChildren()) do
        if tool:IsA("Tool") and tool:FindFirstChild("Handle") then
            if string.lower(tool.Name):find("gun") or string.lower(tool.Name):find("pistol") then
                return true
            end
        end
    end
    return false
end

-- ============================================================
-- AIMBOT (автонаведение)
-- ============================================================
function RunAimbot()
    if not UserSettings.Aimbot then return end
    
    local char = Player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local closest = nil
    local minDist = UserSettings.AimbotFOV
    
    for _, plr in pairs(GetPlayers()) do
        if plr and plr.Character then
            local targetPart = plr.Character:FindFirstChild(UserSettings.AimPart)
            if not targetPart then targetPart = plr.Character:FindFirstChild("HumanoidRootPart") end
            if targetPart then
                local screenPos, onScreen = Camera:WorldToScreenPoint(targetPart.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - UIS:GetMouseLocation()).Magnitude
                    if dist < minDist then
                        minDist = dist
                        closest = {Player = plr, Part = targetPart}
                    end
                end
            end
        end
    end
    
    if closest then
        local targetPos = closest.Part.Position
        local direction = (targetPos - Camera.CFrame.Position).Unit
        local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + direction)
        
        -- Плавное наведение
        Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, UserSettings.AimbotSmoothness)
    end
end

-- ============================================================
-- ESP (подсветка игроков)
-- ============================================================
local ESPObjects = {}

function RunESP()
    if not UserSettings.ESP then
        -- Удаляем старые ESP объекты
        for _, obj in pairs(ESPObjects) do
            if obj and obj.Parent then
                obj:Destroy()
            end
        end
        ESPObjects = {}
        return
    end
    
    -- Обновляем ESP
    for _, plr in pairs(GetPlayers()) do
        if plr.Character then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (Camera.CFrame.Position - root.Position).Magnitude
                if dist < UserSettings.ESPDistance then
                    -- Проверяем, существует ли уже ESP
                    local exists = false
                    for _, obj in pairs(ESPObjects) do
                        if obj and obj.Parent and obj:GetAttribute("Player") == plr.UserId then
                            exists = true
                            -- Обновляем позицию
                            obj.CFrame = CFrame.new(root.Position)
                            break
                        end
                    end
                    
                    if not exists then
                        -- Создаём новый ESP объект
                        local esp = Instance.new("Part")
                        esp.Size = Vector3.new(1.5, 1.5, 1.5)
                        esp.BrickColor = BrickColor.new(UserSettings.ESPColor)
                        esp.Material = Enum.Material.Neon
                        esp.Anchored = true
                        esp.CanCollide = false
                        esp.Transparency = 0.5
                        esp.CFrame = CFrame.new(root.Position)
                        esp:SetAttribute("Player", plr.UserId)
                        esp.Parent = Workspace
                        table.insert(ESPObjects, esp)
                        
                        -- Добавляем линию (ray)
                        local line = Instance.new("Part")
                        line.Size = Vector3.new(0.1, 0.1, dist)
                        line.BrickColor = BrickColor.new(UserSettings.ESPColor)
                        line.Material = Enum.Material.Neon
                        line.Anchored = true
                        line.CanCollide = false
                        line.Transparency = 0.3
                        line.CFrame = CFrame.new(
                            (Camera.CFrame.Position + root.Position) / 2,
                            root.Position
                        )
                        line:SetAttribute("Player", plr.UserId)
                        line.Parent = Workspace
                        table.insert(ESPObjects, line)
                    end
                end
            end
        end
    end
end

-- ============================================================
-- AUTO KNIFE (автоматический удар ножом)
-- ============================================================
function RunAutoKnife()
    if not UserSettings.AutoKnife then return end
    
    local char = Player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Находим нож
    local knife = nil
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool:FindFirstChild("Handle") then
            if string.lower(tool.Name):find("knife") or string.lower(tool.Name):find("sword") then
                knife = tool
                break
            end
        end
    end
    
    if not knife then return end
    
    -- Ищем ближайшего игрока
    local closest = nil
    local minDist = 15
    
    for _, plr in pairs(GetPlayers()) do
        if plr.Character then
            local targetRoot = plr.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                local dist = (root.Position - targetRoot.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = plr
                end
            end
        end
    end
    
    if closest then
        -- Поворачиваемся к игроку
        local targetPos = closest.Character.HumanoidRootPart.Position
        local dir = (targetPos - root.Position).Unit
        root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
        
        -- Атакуем
        knife:Activate()
        task.wait(0.1)
        knife:Deactivate()
    end
end

-- ============================================================
-- AUTO GUN (автоматическая стрельба)
-- ============================================================
function RunAutoGun()
    if not UserSettings.AutoGun then return end
    
    local char = Player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Находим пистолет
    local gun = nil
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool:FindFirstChild("Handle") then
            if string.lower(tool.Name):find("gun") or string.lower(tool.Name):find("pistol") then
                gun = tool
                break
            end
        end
    end
    
    if not gun then return end
    
    -- Ищем цель
    local target = nil
    local minDist = 60
    
    for _, plr in pairs(GetPlayers()) do
        if plr.Character and IsMurderer(plr) then
            local targetRoot = plr.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                local dist = (root.Position - targetRoot.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    target = plr
                end
            end
        end
    end
    
    if target then
        -- Наводимся
        local targetPos = target.Character.HumanoidRootPart.Position
        local dir = (targetPos - root.Position).Unit
        root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
        
        -- Стреляем
        gun:Activate()
        task.wait(0.15)
        gun:Deactivate()
    end
end

-- ============================================================
-- AUTO DODGE (уклонение)
-- ============================================================
function RunAutoDodge()
    if not UserSettings.AutoDodge then return end
    
    local char = Player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Проверяем, не целится ли кто-то в нас
    for _, plr in pairs(GetPlayers()) do
        if plr.Character and HasGun(plr) then
            local shooterRoot = plr.Character:FindFirstChild("HumanoidRootPart")
            if shooterRoot then
                local dir = (root.Position - shooterRoot.Position).Unit
                local lookDir = shooterRoot.CFrame.LookVector
                
                -- Если кто-то нацелен на нас
                if dir:Dot(lookDir) > 0.8 then
                    if math.random() < UserSettings.DodgeChance then
                        -- Прыгаем в сторону
                        local humanoid = char:FindFirstChild("Humanoid")
                        if humanoid then
                            humanoid:Jump()
                            -- Двигаемся вбок
                            local sideways = Vector3.new(
                                math.random() > 0.5 and 1 or -1,
                                0,
                                0
                            )
                            root.CFrame = root.CFrame + sideways * 5
                        end
                    end
                end
            end
        end
    end
end

