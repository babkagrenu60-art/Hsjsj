local function closeWithXeno()
    MF.Visible=false
    local XenoOverlay=Instance.new("Frame")
    XenoOverlay.Size=UDim2.new(1,0,1,0)
    XenoOverlay.BackgroundColor3=Color3.fromRGB(0,0,0)
    XenoOverlay.BackgroundTransparency=1
    XenoOverlay.BorderSizePixel=0
    XenoOverlay.ZIndex=999
    XenoOverlay.Parent=SG

    local XenoImg=Instance.new("ImageLabel")
    XenoImg.Size=UDim2.new(0,140,0,140)
    XenoImg.Position=UDim2.new(0.5,-70,0.5,-70)
    XenoImg.BackgroundTransparency=1
    XenoImg.Image=CFG.XenoLogo
    XenoImg.ImageTransparency=1
    XenoImg.ZIndex=1000
    XenoImg.Parent=XenoOverlay

    local XenoText=Instance.new("TextLabel")
    XenoText.Size=UDim2.new(1,0,0,30)
    XenoText.Position=UDim2.new(0,0,0.6,0)
    XenoText.BackgroundTransparency=1
    XenoText.Text="XENO"
    XenoText.TextColor3=CFG.Color
    XenoText.TextSize=24
    XenoText.Font=Enum.Font.GothamBlack
    XenoText.TextTransparency=1
    XenoText.ZIndex=1000
    XenoText.Parent=XenoOverlay

    TW:Create(XenoOverlay,TweenInfo.new(0.4),{BackgroundTransparency=0.4}):Play()
    TW:Create(XenoImg,TweenInfo.new(0.4,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{ImageTransparency=0}):Play()
    TW:Create(XenoText,TweenInfo.new(0.4),{TextTransparency=0}):Play()
    task.wait(1.2)
    TW:Create(XenoOverlay,TweenInfo.new(0.5),{BackgroundTransparency=1}):Play()
    TW:Create(XenoImg,TweenInfo.new(0.5),{ImageTransparency=1}):Play()
    TW:Create(XenoText,TweenInfo.new(0.5),{TextTransparency=1}):Play()
    task.wait(0.6)
    XenoOverlay:Destroy()
end

