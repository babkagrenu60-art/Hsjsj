-- ИСПРАВЛЕНО: ищем пистолет ТОЛЬКО упавший на землю,
-- а не тот что в руках живого шерифа
local function isGunDropped(gun)
    if not gun or not gun.Parent then return false end
    -- Если родитель — персонаж игрока → не подобран
    if gun.Parent:IsA("Model") then
        -- Проверяем, что это не Character (Character имеет Humanoid)
        if gun.Parent:FindFirstChildOfClass("Humanoid") then return false end
    end
    -- Если родитель — Backpack → в рюкзаке
    if gun.Parent:IsA("Backpack") then return false end
    -- Если родитель не Backpack и не Character → лежит в Workspace
    if gun.Parent == WS then return true end
    -- Если родитель — другой контейнер в Workspace
    if gun.Parent and gun.Parent.Parent == WS then return true end
    return false
end

local function isGunInPlayerHands(gun)
    if not gun or not gun.Parent then return false end
    -- Если родитель — персонаж какого-то игрока
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character == gun.Parent then
            return true
        end
    end
    return false
end

local function findFallenGun()
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("Tool") then
            local n = obj.Name:lower()
            if n:find("gun") or n:find("pistol") or n:find("revolver") then
                -- ИСПРАВЛЕНО: проверяем что пистолет реально лежит на земле,
                -- а не в руках живого шерифа
                if not isGunInPlayerHands(obj) and obj.Parent ~= LP.Character and obj.Parent ~= LP.Backpack then
                    -- Дополнительная проверка: если родитель — Model с Humanoid → пропускаем
                    if obj.Parent and obj.Parent:IsA("Model") then
                        if not obj.Parent:FindFirstChildOfClass("Humanoid") then
                            return obj
                        end
                    else
                        return obj
                    end
                end
            end
        end
    end
    return nil
end

local function autoPickupGun()
    if not autoGunPickup then return end
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local gun = findFallenGun()
    if not gun then return end
    local savedCF = char.HumanoidRootPart.CFrame
    local gunPos
    local ok, pivot = pcall(function() return gun:GetPivot() end)
    if ok then gunPos = pivot else gunPos = CFrame.new(gun.Position) end
    char.HumanoidRootPart.CFrame = gunPos
    task.spawn(function()
        local timeout = 0
        while timeout < 3 do
            if gun.Parent == char or gun.Parent == LP.Backpack then break end
            task.wait(0.05)
            timeout = timeout + 0.05
        end
        if savedCF and char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = savedCF
        end
    end)
end

task.spawn(function()
    while SG and SG.Parent do
        task.wait(UICfg.ProMode and 0.1 or 0.2)
        if autoGunPickup then autoPickupGun() end
    end
end)

local function autoShoot()
    if not autoShootEnabled then return end
    local myRole = getPlayerRole(LP)
    if myRole ~= "Sheriff" then return end
    local char = LP.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    local tn = tool.Name:lower()
    if not (tn:find("gun") or tn:find("pistol") or tn:find("revolver")) then return end
    local myPos = char.HumanoidRootPart.Position
    local murderer = nil
    local murdererDist = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then
            local role = getPlayerRole(player)
            if role == "Murderer" and player.Character then
                local hum = player.Character:FindFirstChild("Humanoid")
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    if autoShootOnlyKnife then
                        local mTool = player.Character:FindFirstChildOfClass("Tool")
                        if not mTool or not mTool.Name:lower():find("knife") then continue end
                    end
                    local dist = (myPos - hrp.Position).Magnitude
                    if dist < murdererDist and dist <= autoShootRange then
                        murderer = player
                        murdererDist = dist
                    end
                end
            end
        end
    end
    if murderer then
        pcall(function() tool:Activate() end)
        playRevolverShot()
    end
end

