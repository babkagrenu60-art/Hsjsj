-- Анимация плавного появления текста
local function fadeText(textLabel, targetTransparency, duration)
    local steps = 20
    local current = textLabel.TextTransparency
    local diff = targetTransparency - current
    for i = 1, steps do
        textLabel.TextTransparency = current + (diff * (i / steps))
        task.wait(duration / steps)
    end
end

-- Логика заставки (Интро последовательность)
task.spawn(function()
    task.wait(0.5)
    fadeText(IntroText, 0, 0.8) -- Появление "By: Gregoo"
    task.wait(4)
    fadeText(IntroText, 1, 0.8) -- Плавное исчезновение "By: Gregoo"
    
    IntroText.Text = "Приятной игры!"
    fadeText(IntroText, 0, 0.8) -- Появление "Приятной игры!"
    task.wait(3)
    fadeText(IntroText, 1, 0.8) -- Исчезновение "Приятной игры!"
    
    -- Плавное исчезновение черного фона
    local steps = 20
    for i = 1, steps do
        BlackFrame.BackgroundTransparency = i / steps
        task.wait(0.5 / steps)
    end
    IntroGui:Destroy() -- Уничтожаем интро, открываем чит-панель
end)


