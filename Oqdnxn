local function black(p)
    if not p or not p.Parent or parts[p] then return end
    parts[p]=true
    p:SetAttribute("OC",p.Color)
    p.Color=Color3.fromRGB(0,0,0);p.Material=Enum.Material.SmoothPlastic
    for _,f in ipairs{Enum.NormalId.Top,Enum.NormalId.Bottom,Enum.NormalId.Front,Enum.NormalId.Back,Enum.NormalId.Left,Enum.NormalId.Right} do
        local g=Instance.new("SurfaceGui");g.Face=f;g.CanvasSize=Vector2.new(400,400);g.LightInfluence=0;g.Parent=p
        local t=Instance.new("TextLabel");t.Size=UDim2.new(1,0,1,0);t.BackgroundTransparency=1
        t.Text="КУЛКИД";t.TextColor3=Color3.fromRGB(255,0,0);t.TextScaled=true
        t.Font=Enum.Font.GothamBlack;t.TextStrokeTransparency=0;t.TextStrokeColor3=Color3.fromRGB(0,0,0);t.Parent=g
    end
    p.Touched:Connect(function(hit)
        if not active then return end
        local ch=hit.Parent
        if not ch then return end
        local h=ch:FindFirstChildOfClass("Humanoid")
        if not h then return end
        if sndOn then
            local hrp2=ch:FindFirstChild("HumanoidRootPart")
            if hrp2 then
                local s=Instance.new("Sound");s.SoundId=SCREAM;s.Volume=5;s.Parent=hrp2;s:Play()
                task.delay(5,function() if s then s:Destroy() end end)
            end
        end
        local plr=P:GetPlayerFromCharacter(ch)
        if plr then infect(plr) end
    end)
end

local function scan()
