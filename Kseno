-- ===== ЛОГИКА =====
local SAVE_KEY="XenoStyleScript"

-- Сохранить
SaveBtn.MouseButton1Click:Connect(function()
    local code=CodeBox.Text
    local success,err=pcall(function()
        if writefile then
            writefile(SAVE_KEY..".lua",code)
        elseif setclipboard then
            setclipboard(code)
        end
    end)
    if success then
        StatusLbl.Text="> СОХРАНЕНО"
        StatusLbl.TextColor3=Color3.fromRGB(150,255,150)
    else
        StatusLbl.Text="> ОШИБКА СОХРАНЕНИЯ"
        StatusLbl.TextColor3=Color3.fromRGB(255,150,150)
    end
end)

-- Загрузить
LoadBtn.MouseButton1Click:Connect(function()
    local code=nil
    if readfile then
        local success,result=pcall(function()
            return readfile(SAVE_KEY..".lua")
        end)
        if success then code=result end
    end
    if code then
        CodeBox.Text=code
        StatusLbl.Text="> ЗАГРУЖЕНО"
        StatusLbl.TextColor3=Color3.fromRGB(150,255,150)
    else
        StatusLbl.Text="> НЕЧЕГО ЗАГРУЖАТЬ"
        StatusLbl.TextColor3=Color3.fromRGB(255,150,150)
    end
end)

-- Запустить
RunBtn.MouseButton1Click:Connect(function()
    local code=CodeBox.Text
    StatusLbl.Text="> ЗАПУСК..."
    StatusLbl.TextColor3=Color3.fromRGB(255,200,80)
    local success,err=pcall(function()
        local func=loadstring(code)
        if func then
            func()
        else
            error("Ошибка компиляции")
        end
    end)
    if success then
        StatusLbl.Text="> ЗАПУЩЕНО"
        StatusLbl.TextColor3=Color3.fromRGB(150,255,150)
    else
        StatusLbl.Text="> ОШИБКА: "..tostring(err):sub(1,40)
        StatusLbl.TextColor3=Color3.fromRGB(255,100,100)
    end
end)

-- Открытие/закрытие
