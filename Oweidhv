RESET.MouseButton1Click:Connect(function()
    -- Останавливаем все циклы
    if rainbowLoop then rainbowLoop:Disconnect();rainbowLoop=nil end
    for key,conn in pairs(CFG_Loops) do
        if conn then conn:Disconnect() end
        CFG_Loops[key]=nil
    end
    -- Удаляем частицы
    local c=getChar()
    if c then
        local hrp=c:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _,child in ipairs(hrp:GetChildren()) do
                if child:IsA("ParticleEmitter") or child:IsA("Fire") or child:IsA("Attachment") then
                    if child.Name~="RootJoint" and child.Name~="OriginalSize" then
                        child:Destroy()
                    end
                end
            end
        end
        -- Возвращаем цвет
        for _,p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                p.Color=Color3.fromRGB(255,255,255)
                p.Material=Enum.Material.Plastic
            end
        end
    end
    -- Удаляем следы
    for _,obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Part") and obj.Shape==Enum.PartType.Ball and obj.Anchored and obj.Material==Enum.Material.Neon then
            obj:Destroy()
        end
    end
    -- Обновляем кнопки
    RB.Text="🌈 ВКЛЮЧИТЬ РАДУГУ"
    RB.BackgroundColor3=Color3.fromRGB(50,30,70)
    PT1.Text="✨ ЧАСТИЦЫ ВОКРУГ"
