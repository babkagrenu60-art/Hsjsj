local function selectTab(idx)
    for i,btn in ipairs(TabButtons) do
        if i==idx then
            TW:Create(btn,TweenInfo.new(0.2),{BackgroundColor3=CFG.Color}):Play()
            btn.TextColor3=Color3.fromRGB(255,255,255)
            Pages[i].Visible=true
        else
            TW:Create(btn,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(30,25,45)}):Play()
            btn.TextColor3=Color3.fromRGB(160,150,190)
            Pages[i].Visible=false
        end
    end
end

for i,btn in ipairs(TabButtons) do
    btn.MouseButton1Click:Connect(function() selectTab(i) end)
end

