-- Функции навигации
local function addToMemory(position)
    table.insert(Brain.Memory, position)
    if #Brain.Memory > SETTINGS.MemorySize then
        table.remove(Brain.Memory, 1)
    end
end

local function isVisited(position, radius)
    radius = radius or 15
    for _, memPos in ipairs(Brain.Memory) do
        if (position - memPos).Magnitude < radius then
            return true
        end
    end
    return false
end

local function getRandomUnvisitedPosition()
    local char = Player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local attempts = 0
    while attempts < 30 do
        attempts = attempts + 1
        local angle = math.random() * 2 * math.pi
        local distance = math.random(30, 150)
        local x = root.Position.X + math.cos(angle) * distance
        local z = root.Position.Z + math.sin(angle) * distance
        local y = root.Position.Y
        
        local newPos = Vector3.new(x, y, z)
        
        if not isVisited(newPos, 20) then
            return newPos
        end
    end
    
    return nil
end

-- Принудительное движение через BodyVelocity
local function moveCharacter(direction)
    local char = Player.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Удаляем старые BodyVelocity
    for _, v in ipairs(root:GetChildren()) do
        if v:IsA("BodyVelocity") then
            v:Destroy()
        end
    end
    
    -- Создаём новое движение
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(4000, 4000, 4000)
    bodyVelocity.Velocity = direction * SETTINGS.MoveSpeed
    bodyVelocity.Parent = root
    
    -- Автоудаление через 0.5 секунды
    game:GetService("Debris"):AddItem(bodyVelocity, 0.5)
    
    -- Поворачиваем персонажа
    if direction.Magnitude > 0.1 then
        local lookAt = root.Position + direction
        local targetCFrame = CFrame.lookAt(root.Position, lookAt)
        root.CFrame = root.CFrame:Lerp(targetCFrame, 0.2)
    end
end

-- Функция остановки
local function stopCharacter()
    local char = Player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    for _, v in ipairs(root:GetChildren()) do
        if v:IsA("BodyVelocity") then
            v:Destroy()
        end
    end
end

-- Получение ближайшего игрока
local function getClosestPlayer()
    local closest = nil
    local minDist = math.huge
    local char = Player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    for _, plr in pairs(game:GetService("Players"):GetPlayers()) do
        if plr ~= Player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (root.Position - plr.Character.HumanoidRootPart.Position).Magnitude
            if dist < minDist and dist < SETTINGS.DetectionRadius then
                minDist = dist
                closest = plr
            end
        end
    end
    return closest
end

-- Стрельба
local function aimAndShoot(target)
    if not target or not target.Character then return end
    local char = Player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not root or not targetRoot then return end
    
    local direction = (targetRoot.Position - root.Position).Unit
    root.CFrame = CFrame.lookAt(root.Position, root.Position + direction)
    
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
        task.wait(0.1)
        tool:Deactivate()
    end
    
    Brain.Aggression = math.min(1, Brain.Aggression + 0.01)
end

-- Основной цикл движения
local function moveBot()
    local char = Player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Проверка на застревание
    if Brain.LastPosition then
        local dist = (root.Position - Brain.LastPosition).Magnitude
        if dist < 1 then
            Brain.StuckCounter = Brain.StuckCounter + 1
        else
            Brain.StuckCounter = 0
        end
    end
    Brain.LastPosition = root.Position
    
    -- Если застрял - прыгаем
    if Brain.StuckCounter > 10 then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid:Jump()
            Brain.StuckCounter = 0
        end
    end
    
    -- Добавляем в память
    if tick() % 2 < 0.1 then
        addToMemory(root.Position)
    end
    
    local target = getClosestPlayer()
    
    if target and target.Character then
        local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            local dist = (root.Position - targetRoot.Position).Magnitude
            local direction = (targetRoot.Position - root.Position).Unit
            
            -- Движение к врагу
            moveCharacter(direction)
            
            -- Стрельба
            if dist < 50 then
                aimAndShoot(target)
            end
        end
    else
        -- Исследование карты
        if not Brain.CurrentTarget or isVisited(Brain.CurrentTarget, 15) then
            Brain.CurrentTarget = getRandomUnvisitedPosition()
            if not Brain.CurrentTarget then
                -- Если все места посещены - идём в случайном направлении
                local angle = math.random() * 2 * math.pi
                local distance = math.random(30, 100)
                Brain.CurrentTarget = root.Position + Vector3.new(
                    math.cos(angle) * distance,
                    0,
                    math.sin(angle) * distance
                )
            end
        end
        
        if Brain.CurrentTarget then
            local direction = (Brain.CurrentTarget - root.Position).Unit
            local dist = (root.Position - Brain.CurrentTarget).Magnitude
            
            if dist > 5 then
                moveCharacter(direction)
            else
                addToMemory(Brain.CurrentTarget)
                Brain.CurrentTarget = nil
                stopCharacter()
            end
        end
    end
end

-- Обучение на ошибках
local function learnFromDeath()
    Brain.Deaths = Brain.Deaths + 1
    
    if Brain.Aggression > 0.7 then
        Brain.Aggression = math.max(0.1, Brain.Aggression - 0.2)
    else
        Brain.Aggression = math.min(1, Brain.Aggression + 0.1)
    end
    
    Brain.Memory = {}
    Brain.CurrentTarget = nil
    Brain.StuckCounter = 0
    
    print("🧠 Обучение: Смерть #" .. Brain.Deaths .. " | Агрессия: " .. math.floor(Brain.Aggression * 100) .. "%")
end

-- Обработка смерти
Player.CharacterAdded:Connect(function(char)
    task.wait(2)
    learnFromDeath()
end)

