-- ПОИСК ЦЕЛЕЙ
-- ============================================
local function getTargetsByPriority()
    local myRole = getMyRole()
    local myChar = LP.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return {}, {} end
    local myPos = myChar.HumanoidRootPart.Position

    local priorityList = {}
    local normalList = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and player.Character then
            local char = player.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local role = getPlayerRole(player)
                local dist = (myPos - hrp.Position).Magnitude
                local entry = { player = player, char = char, hrp = hrp, dist = dist, role = role }

                local isPriority = false
                if myRole == "Sheriff" and role == "Murderer" then isPriority = true end
                if myRole == "Murderer" and aimAtSheriffPriority and role == "Sheriff" then isPriority = true end
                if myRole == "Murderer" and killAllForMurder then isPriority = true end

                if isPriority then
                    table.insert(priorityList, entry)
                else
                    table.insert(normalList, entry)
                end
            end
        end
    end

    table.sort(priorityList, function(a, b) return a.dist < b.dist end)
    table.sort(normalList, function(a, b) return a.dist < b.dist end)
    return priorityList, normalList
end

local function getBestTarget()
    if npcOnlyMode or aimNPCEnabled then
        local npcs = findNPCs()
        if #npcs > 0 then
            if wallCheckEnabled then
                for _, npc in ipairs(npcs) do
                    local aimPos = getAimPositionFromNPC(npc)
                    if aimPos and isVisibleTo({npc.model}, aimPos) then
                        return { type = "NPC", npc = npc }
                    end
                end
                if npcOnlyMode then return nil end
            else
                return { type = "NPC", npc = npcs[1] }
            end
        end
        if npcOnlyMode then return nil end
    end

    local prio, normal = getTargetsByPriority()
    local list = #prio > 0 and prio or normal
    if #list == 0 then return nil end

    if wallCheckEnabled then
        for _, entry in ipairs(list) do
            local aimPos = getAimPositionFromPlayer(entry.player)
            if aimPos and isVisibleTo({entry.char}, aimPos) then
                return { type = "Player", player = entry.player }
            end
        end
        return nil
    end
    return { type = "Player", player = list[1].player }
end

-- ============================================
-- УЛУЧШЕННЫЙ АИМ — плавный с адаптивным сглаживанием
-- ============================================
local function doAimbot()
    if not aimbotEnabled then return end
    if not UIS.TouchEnabled and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        lastAimCF = nil
        return
    end

    local targetData = getBestTarget()
    if not targetData then return end

    local aimPos
    if targetData.type == "NPC" then
        aimPos = getAimPositionFromNPC(targetData.npc)
    else
        aimPos = getAimPositionFromPlayer(targetData.player)
    end
    if not aimPos then return end

    -- Отслеживаем изменение цели
    local targetId = targetData.type == "NPC" and targetData.npc.model.Name or targetData.player.Name
    if lastAimTarget ~= targetId then
        lastAimTarget = targetId
        lastAimCF = nil
        velocitySamples = {}
    end

    local camPos = CAM.CFrame.Position
    local targetCF = CFrame.new(camPos, aimPos)

    -- Адаптивное сглаживание — при смене цели быстрее, при слежении плавнее
    local adaptiveSmooth = aimSmoothness
    if not lastAimCF then
        -- Первый кадр на новой цели — снимем сглаживание
        adaptiveSmooth = 0
    end

    local newCF
    if lastAimCF and adaptiveSmooth > 0 then
        -- Плавное линейное сглаживание
        newCF = lastAimCF:Lerp(targetCF, 1 - adaptiveSmooth)
    else
        newCF = targetCF
    end

    lastAimCF = newCF
    lastAimPos = aimPos
    CAM.CFrame = newCF
end

RS.RenderStepped:Connect(function()
    if aimbotEnabled then doAimbot() end
end)

