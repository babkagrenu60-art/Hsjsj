-- ===== ПОИСК =====
local function findTarget()
    local bs=workspace:FindFirstChild("BoatStages")
    if bs then
        local dp=bs:FindFirstChild("DarknessPart",true)
        if dp then return dp end
    end
    return workspace:FindFirstChild("DarknessPart",true)
end

-- ===== ОДИН ЦИКЛ =====
local function runOneCycle()
    cachedTarget=findTarget()
    if not cachedTarget then
        StatusLbl.Text="> ЦЕЛЬ НЕ НАЙДЕНА"
        StatusLbl.TextColor3=Color3.fromRGB(255,100,100)
        return false
    end

    StatusLbl.Text="> ЛЕТИМ К "..cachedTarget.Name
    StatusLbl.TextColor3=Color3.fromRGB(150,255,150)

    local c0=LP.Character
    if c0 then
        for _,p in ipairs(c0:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide=false end
        end
    end

    local reached=false
    local startTime=tick()
    while cycleActive do
        local c=LP.Character
        if not c then break end
        local hrp=c:FindFirstChild("HumanoidRootPart")
        if not hrp then break end

        if not cachedTarget or not cachedTarget.Parent then
            cachedTarget=findTarget()
            if not cachedTarget then break end
        end

        local centerPos=cachedTarget.Position
        local dist=(centerPos-hrp.Position).Magnitude

        if dist<2 then
            reached=true
            break
        end

        hrp.CFrame=hrp.CFrame:Lerp(CFrame.new(centerPos),0.15)
        task.wait(0.03)

        if tick()-startTime>20 then break end
    end

    if not reached then
        StatusLbl.Text="> НЕ ДОЛЕТЕЛ"
        StatusLbl.TextColor3=Color3.fromRGB(255,150,150)
        return false
    end

    StatusLbl.Text="> В ЦЕНТРЕ · УМИРАЮ"
    StatusLbl.TextColor3=Color3.fromRGB(255,100,100)
    task.wait(0.3)

    local c=LP.Character
    if c then
        local h=c:FindFirstChildOfClass("Humanoid")
        if h then h.Health=0 end
    end

    return true
end

-- ===== ЗАПУСК ЦИКЛА =====
local function startCycle()
    if cycleThread then return end
    cycleActive=true
    cycleThread=task.spawn(function()
        while cycleActive do
            local ok=runOneCycle()
            if not cycleActive then break end

            StatusLbl.Text="> ЖДУ РЕСПАВН..."
            StatusLbl.TextColor3=Color3.fromRGB(255,200,80)

            local waited=0
            while cycleActive and waited<15 do
                local c=LP.Character
                if c then
                    local h=c:FindFirstChildOfClass("Humanoid")
                    if h and h.Health>0 then break end
                end
                task.wait(0.5)
                waited=waited+0.5
            end

            if not cycleActive then break end
            task.wait(1)
            if not cycleActive then break end
            StatusLbl.Text="> НОВЫЙ ЦИКЛ..."
            task.wait(0.5)
        end
        cycleThread=nil
    end)
end

local function stopCycle()
    cycleActive=false
    StatusLbl.Text="> OFF"
    StatusLbl.TextColor3=Color3.fromRGB(180,180,190)
    cachedTarget=nil
    local c=LP.Character
    if c then
        for _,p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then
                p.CanCollide=true
            end
        end
    end
end

