-- ========== ESP С ПОДСВЕТКОЙ ==========
local ESPObjects = {}

local function getPlayerRole(player)
    if player == LocalPlayer then return "Вы" end
    local char = player.Character
    local backpack = player.Backpack
    if not char then return "Неизвестно" end
    local hasKnife = char:FindFirstChild("Knife") or backpack:FindFirstChild("Knife")
    local hasGun = char:FindFirstChild("Gun") or backpack:FindFirstChild("Gun")
    if hasKnife and hasGun then return "Убийца/Шериф"
    elseif hasKnife then return "Убийца"
    elseif hasGun then return "Шериф"
    else return "Невиновный" end
end

local function createGlow(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    
    if ESPObjects[player] then
        for _, obj in pairs(ESPObjects[player]) do
            obj:Destroy()
        end
        ESPObjects[player] = nil
    end
    
    if not Settings.ESPEnabled then return end
    
    local role = getPlayerRole(player)
    local color
    
    if role == "Убийца" then
        color = Color3.fromRGB(255, 0, 0)
    elseif role == "Шериф" then
        color = Color3.fromRGB(0, 150, 255)
    elseif role == "Невиновный" then
        color = Color3.fromRGB(0, 255, 100)
    else
        color = Color3.fromRGB(255, 255, 255)
    end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "RoleGlow"
    highlight.Adornee = char
    highlight.FillColor = color
    highlight.FillTransparency = 0.4
    highlight.OutlineColor = color
    highlight.OutlineTransparency = 0.1
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = char
    
    ESPObjects[player] = {highlight}
end

local function updateESP()
    for _, player in pairs(Players:GetPlayers()) do
        createGlow(player)
    end
end

local function clearESP()
    for player, objects in pairs(ESPObjects) do
        for _, obj in pairs(objects) do
            obj:Destroy()
        end
    end
    ESPObjects = {}
end

function toggleESP(state)
    Settings.ESPEnabled = state
    if state then
        updateESP()
    else
        clearESP()
    end
end

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        createGlow(player)
    end)
end)

Players.PlayerRemoving:Connect(function(player)
