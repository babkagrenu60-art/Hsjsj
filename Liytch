local function makeParticles(name,texture,color,size,rate,lifetime,speed)
    local c=getChar()
    if not c then return end
    local hrp=c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local old=hrp:FindFirstChild(name)
    if old then old:Destroy() end
    local att=Instance.new("Attachment")
    att.Name=name.."Att"
    att.Parent=hrp
    local emit=Instance.new("ParticleEmitter")
    emit.Name=name
    emit.Texture=texture or "rbxassetid://243660364"
    emit.Rate=rate or 15
    emit.Lifetime=NumberRange.new(lifetime or 1,lifetime and lifetime*2 or 2)
    emit.Speed=NumberRange.new(speed or 2,(speed or 2)+3)
    emit.SpreadAngle=Vector2.new(180,180)
    emit.Size=NumberSequence.new(size or 0.5)
    emit.Color=ColorSequence.new(color or Color3.fromRGB(255,255,255))
    emit.Transparency=NumberSequence.new(0.3)
    emit.Parent=att
    return emit
end

