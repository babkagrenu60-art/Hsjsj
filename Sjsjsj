function Act(v)return 1/(1+math.exp(-v))end
function Decide(i)local d=0 for k,w in pairs(NN.Weights)do if i[k]then d=d+(i[k]*w)end end return Act(d)end
function Learn(s,f)NN.Learning.Iterations=NN.Learning.Iterations+1 local lr=S.LearningRate*(1+NN.Learning.Adaptations/100)if s then for k,w in pairs(NN.Weights)do NN.Weights[k]=math.min(1,w+(lr*(f[k]or 0.01)))end NN.Learning.SuccessRate=(NN.Learning.SuccessRate*0.9)+0.1 else for k,w in pairs(NN.Weights)do NN.Weights[k]=math.max(0,w-(lr*0.1))end NN.Learning.SuccessRate=NN.Learning.SuccessRate*0.95 end if NN.Learning.Iterations%10==0 then NN.Learning.Adaptations=NN.Learning.Adaptations+1 end end
function Move(d,s)local c=Player.Character if not c then return end local r=c:FindFirstChild("HumanoidRootPart")if not r then return end for _,v in pairs(r:GetChildren())do if v:IsA("BodyVelocity")or v:IsA("BodyForce")then v:Destroy()end end if d.Magnitude<0.1 then return end s=s or S.MoveSpeed local bv=Instance.new("BodyVelocity")bv.MaxForce=Vector3.new(4000,4000,4000)bv.Velocity=d.Unit*s bv.Parent=r local bf=Instance.new("BodyForce")bf.Force=Vector3.new(0,c:GetMass()*workspace.Gravity,0)bf.Parent=r game:GetService("Debris"):AddItem(bv,0.3)game:GetService("Debris"):AddItem(bf,0.3)if d.Magnitude>0.5 then local lp=r.Position+d.Unit*10 r.CFrame=r.CFrame:Lerp(CFrame.lookAt(r.Position,lp),0.15)end end
function Stop()local c=Player.Character if not c then return end local r=c:FindFirstChild("HumanoidRootPart")if not r then return end for _,v in pairs(r:GetChildren())do if v:IsA("BodyVelocity")or v:IsA("BodyForce")then v:Destroy()end end end
function Jump()local c=Player.Character if not c then return end local h=c:FindFirstChild("Humanoid")if h then h:Jump()end end
function AddPos(p)table.insert(NN.Memory.Positions,p)if #NN.Memory.Positions>S.MemorySize then table.remove(NN.Memory.Positions,1)end end
function IsVisited(p,r)r=r or 15 for _,m in pairs(NN.Memory.Positions)do if(p-m).Magnitude<r then return true end end return false end
function AddDeath(p)table.insert(NN.Memory.DeathLocations,p)if #NN.Memory.DeathLocations>20 then table.remove(NN.Memory.DeathLocations,1)end end
function IsDangerous(p,r)r=r or 25 for _,d in pairs(NN.Memory.DeathLocations)do if(p-d).Magnitude<r then return true end end return false end
function GetUnvisited()local c=Player.Character if not c then return end local r=c:FindFirstChild("HumanoidRootPart")if not r then return end for i=1,30 do local a=math.random()*2*math.pi local d=math.random(30,180)local x=r.Position.X+math.cos(a)*d local z=r.Position.Z+math.sin(a)*d local np=Vector3.new(x,r.Position.Y,z)if not IsVisited(np,20)and not IsDangerous(np,30)then return np end end return nil end
function GetClosest()local c,n=nil,math.huge local ch=Player.Character if not ch then return end local r=ch:FindFirstChild("HumanoidRootPart")if not r then return end for _,p in pairs(game:GetService("Players"):GetPlayers())do if p~=Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart")then local d=(r.Position-p.Character.HumanoidRootPart.Position).Magnitude if d<n and d<S.DetectionRadius then n=d c=p end end end return c,n end
function Predict(enemy)if not enemy or not enemy.Character then return end local r=enemy.Character:FindFirstChild("HumanoidRootPart")if not r then return end local pk=tostring(enemy.UserId)if not NN.Memory.EnemyPatterns[pk]then NN.Memory.EnemyPatterns[pk]={Positions={},LastPosition=nil,Speed=0,Direction=Vector3.new()}end local p=NN.Memory.EnemyPatterns[pk]if p.LastPosition then local v=(r.Position-p.LastPosition)/0.1 p.Direction=v.Unit p.Speed=v.Magnitude end p.LastPosition=r.Position return r.Position+(p.Direction*p.Speed*0.5)end
function AimShoot(target)if not target or not target.Character then return end local c=Player.Character if not c then return end local r=c:FindFirstChild("HumanoidRootPart")local tr=target.Character:FindFirstChild("HumanoidRootPart")if not r or not tr then return end local pp=Predict(target)or tr.Position local d=(pp-r.Position).Unit local tc=CFrame.lookAt(r.Position,r.Position+d)r.CFrame=r.CFrame:Lerp(tc,0.3)local acc=NN.Weights.Accuracy local sp=(1-acc)*0.05 local rc=RaycastParams.new()rc.FilterType=Enum.RaycastFilterType.Blacklist rc.FilterDescendantsInstances={c}local ro=r.Position+Vector3.new(0,1.5,0)local rd=d+Vector3.new((math.random()-0.5)*sp,(math.random()-0.5)*sp,(math.random()-0.5)*sp)local ray=workspace:Raycast(ro,rd*200,rc)local hit=false if ray and ray.Instance and ray.Instance:IsDescendantOf(target.Character)then hit=true Learn(true,{Accuracy=0.15})else Learn(false,{Accuracy=-0.05})end local b=Instance.new("Part")b.Size=Vector3.new(0.3,0.3,1)b.BrickColor=BrickColor.new(hit and"Bright green"or"Bright yellow")b.Material=Enum.Material.Neon b.CFrame=CFrame.new(ro)*CFrame.new(0,0,-1)b.Velocity=rd*250 b.CanCollide=false b.Lifetime=0.3 b.Parent=workspace game:GetService("Debris"):AddItem(b,0.3)local t=c:FindFirstChildOfClass("Tool")if t then t:Activate()task.wait(0.05)t:Deactivate()end return hit end
