-- СОЗДАНИЕ БЕКОНА
local function CreateBacon(name, color, position)
    local model = Instance.new("Model")
    model.Name = name
    model.Parent = workspace
    
    -- Части тела
    local parts = {}
    local partData = {
        {name = "HumanoidRootPart", size = Vector3.new(2, 1, 1), pos = position, color = color},
        {name = "Torso", size = Vector3.new(2, 2.5, 1.5), pos = position + Vector3.new(0, 1.5, 0), color = color},
        {name = "Head", size = Vector3.new(1.5, 1.5, 1.5), pos = position + Vector3.new(0, 3.5, 0), color = "Bright yellow"},
        {name = "LeftLeg", size = Vector3.new(0.5, 2, 0.5), pos = position + Vector3.new(-0.7, -0.5, 0), color = color},
        {name = "RightLeg", size = Vector3.new(0.5, 2, 0.5), pos = position + Vector3.new(0.7, -0.5, 0), color = color},
    }
    
    for _, data in ipairs(partData) do
        local part = Instance.new("Part")
        part.Name = data.name
        part.Size = data.size
        part.Position = data.pos
        part.Anchored = false
        part.CanCollide = true
        part.Material = Enum.Material.SmoothPlastic
        part.BrickColor = BrickColor.new(data.color)
        part.Parent = model
        table.insert(parts, part)
    end
    
    -- Humanoid
    local humanoid = Instance.new("Humanoid")
    humanoid.Name = "Humanoid"
    humanoid.MaxHealth = 100
    humanoid.Health = 100
    humanoid.Parent = model
    
    -- Сварка частей
    local function WeldParts(part0, part1, offset)
        local weld = Instance.new("Weld")
        weld.Part0 = part0
        weld.Part1 = part1
        weld.C0 = CFrame.new(offset or Vector3.new(0, 0, 0))
        weld.Parent = part0
        return weld
    end
    
    local root = model:FindFirstChild("HumanoidRootPart")
    local torso = model:FindFirstChild("Torso")
    local head = model:FindFirstChild("Head")
    local leftLeg = model:FindFirstChild("LeftLeg")
    local rightLeg = model:FindFirstChild("RightLeg")
    
    if root and torso then
        WeldParts(root, torso, Vector3.new(0, 1.5, 0))
    end
    if torso and head then
        WeldParts(torso, head, Vector3.new(0, 2, 0))
    end
    if torso and leftLeg then
        WeldParts(torso, leftLeg, Vector3.new(-0.7, -2.5, 0))
    end
    if torso and rightLeg then
        WeldParts(torso, rightLeg, Vector3.new(0.7, -2.5, 0))
    end
    
    return model
end

-- ФУНКЦИЯ ВЗРЫВА
local function CreateExplosion(position)
    -- Звук
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://9120386370"
    sound.Volume = 1
    sound.Parent = workspace
    sound:Play()
    game:GetService("Debris"):AddItem(sound, 3)
    
    -- Сфера взрыва
    local blast = Instance.new("Part")
    blast.Name = "Blast"
    blast.Size = Vector3.new(1, 1, 1)
    blast.Position = position
    blast.Anchored = true
    blast.CanCollide = false
    blast.Material = Enum.Material.Neon
    blast.BrickColor = BrickColor.new("Bright red")
    blast.Transparency = 0.5
    blast.Parent = workspace
    
    -- Анимация взрыва
    local tween1 = TweenService:Create(blast, TweenInfo.new(0.8, Enum.EasingStyle.Quad), {
        Size = Vector3.new(60, 60, 60),
        Transparency = 0
    })
    local tween2 = TweenService:Create(blast, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {
        Transparency = 1
    })
    
    tween1:Play()
    tween1.Completed:Wait()
    tween2:Play()
    tween2.Completed:Wait()
    
    -- УДАЛЯЕМ ВСЁ В РАДИУСЕ
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj ~= blast and obj.Parent ~= LocalPlayer.Character then
            local dist = (obj.Position - position).Magnitude
            if dist < 40 then
                game:GetService("Debris"):AddItem(obj, 0.1)
            end
        end
    end
    
    game:GetService("Debris"):AddItem(blast, 1)
end

