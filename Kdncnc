-- ===== ПРАВИЛЬНЫЙ ПОИСК СУНДУКА =====
local function findTreasure()
    -- Ищем именно в BoatStages (как на фото)
    local bs=workspace:FindFirstChild("BoatStages")
    if bs then
        for _,obj in ipairs(bs:GetDescendants()) do
            if obj:IsA("BasePart") then
                local n=obj.Name:lower()
                if n:find("treasure") or n:find("goldchest") or n:find("chest") then
                    return obj
                end
            end
        end
    end
    -- Если не нашли — общий поиск
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n=obj.Name:lower()
            if n:find("treasure") or n:find("goldchest") then
                return obj
            end
        end
    end
    return nil
end

