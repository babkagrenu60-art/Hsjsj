local function copyToClipboard(text)
    if setclipboard then
        local ok = pcall(function() setclipboard(text) end)
        if ok then return true end
    end
    if toclipboard then
        local ok = pcall(function() toclipboard(text) end)
        if ok then return true end
    end
    return false
end

local function openTelegram(link)
    -- Вариант 1: через openbrowser (Android/iOS)
    if openbrowser then
        local ok = pcall(function() openbrowser(link) end)
        if ok then return true end
    end
    -- Вариант 2: через request (HTTP-запрос)
    if request then
        local ok = pcall(function()
            request({
                Url = link,
                Method = "GET",
            })
        end)
        if ok then return true end
    end
    -- Вариант 3: через firetouchinterest нельзя, пробуем через loadstring с http_get
    if http_request then
        local ok = pcall(function() http_request({Url = link, Method = "GET"}) end)
        if ok then return true end
    end
    return false
end

