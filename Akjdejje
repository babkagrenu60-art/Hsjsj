local RagdollButton = createMenuBtn(GameTabFrame, "РЕГДОЛ (Упасть)", 0.05)

local ragdollActive = false
RagdollButton.MouseButton1Click:Connect(function()
    local char = player.Character
    if not char then return end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end
    
    ragdollActive = not ragdollActive
    
    if ragdollActive then
        RagdollButton.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        RagdollButton.Text = "РЕГДОЛ (ВКЛЮЧЕН)"
        
        -- Отключаем платформу и делаем регдол
        hum.PlatformStand = true
        
        -- Создаем эффект падения (резко ускоряем вниз)
        hrp.AssemblyLinearVelocity = Vector3.new(0, -30, 0)
        
        -- Немного вращаем для реализма
        hrp.AssemblyAngularVelocity = Vector3.new(
            math.random(-5, 5),
            math.random(-5, 5),
            math.random(-5, 5)
        )
        
        -- Делаем все конечности свободными
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("Motor6D") then
                part.Enabled = false
            end
        end
        
    else
        RagdollButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        RagdollButton.Text = "РЕГДОЛ (Упасть)"
        
        -- Возвращаем нормальное состояние
        hum.PlatformStand = false
        
        -- Включаем обратно конечности
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("Motor6D") then
                part.Enabled = true
            end
        end
        
        -- Возвращаем нормальную скорость
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end
end)

-- Дополнительная кнопка "Встать" на случай, если игрок застрял
local StandButton = createMenuBtn(GameTabFrame, "ВСТАТЬ", 0.55)

StandButton.MouseButton1Click:Connect(function()
    local char = player.Character
    if not char then return end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end
    
    -- Включаем платформу и моторы
    hum.PlatformStand = false
    
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("Motor6D") then
            part.Enabled = true
        end
    end
    
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    
    -- Если регдол был включен, выключаем его
    if ragdollActive then
        ragdollActive = false
        RagdollButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        RagdollButton.Text = "РЕГДОЛ (Упасть)"
    end
    
    StandButton.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
    task.wait(0.3)
    StandButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
end)
