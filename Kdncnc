local farmLoop=nil
local collectLoop=nil

FarmBtn.MouseButton1Click:Connect(function()
    CFG.AutoFarm=not CFG.AutoFarm
    if CFG.AutoFarm then
        FarmBtn.Text="> АВТОФАРМ [ВКЛ]"
        FarmBtn.BackgroundColor3=Color3.fromRGB(50,80,50)
        StatusLbl.Text="> FARMING..."
        StatusLbl.TextColor3=Color3.fromRGB(150,255,150)
        if farmLoop then farmLoop:Disconnect() end
        farmLoop=RS.Heartbeat:Connect(function()
            if not CFG.AutoFarm then return end
            local c=LP.Character
            if not c then return end
            local hrp=c:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local treasure=findTreasure()
            if treasure then
                local dist=(treasure.Position-hrp.Position).Magnitude
                if dist>5 then
                    hrp.CFrame=hrp.CFrame:Lerp(CFrame.new(treasure.Position+Vector3.new(0,3,0)),0.1)
                end
            else
                StatusLbl.Text="> СУНДУК НЕ НАЙДЕН"
                StatusLbl.TextColor3=Color3.fromRGB(255,150,150)
            end
        end)
    else
        FarmBtn.Text="> АВТОФАРМ"
        FarmBtn.BackgroundColor3=Color3.fromRGB(30,50,30)
        StatusLbl.Text="> OFF"
        StatusLbl.TextColor3=Color3.fromRGB(180,180,190)
        if farmLoop then farmLoop:Disconnect();farmLoop=nil end
    end
end)

