-- ОТКРЫТИЕ ПО НАЖАТИЮ НА КУБИК
local isDragging = false
local dragStart, startPos

miniCube.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = true
        dragStart = input.Position
        startPos = miniCube.Position
    elseif input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        dragStart = input.Position
        startPos = miniCube.Position
    end
end)

miniCube.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if isDragging then
            local delta = input.Position - dragStart
            if delta.Magnitude < 10 then
                -- ЭТО БЫЛ КЛИК, А НЕ ПЕРЕТАСКИВАНИЕ → ОТКРЫВАЕМ ПАНЕЛЬ
                minimized = false
                main.Visible = true
                glow.Visible = true
                miniCube.Visible = false
                minimizeBtn.Text = "_"
            end
        end
        isDragging = false
    end
end)

miniCube.InputChanged:Connect(function(input)
    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        miniCube.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

