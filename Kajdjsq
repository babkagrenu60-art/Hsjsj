BoostBtn.MouseButton1Click:Connect(function()
    if BoostCooldown then
        StatusLabel.Text = "⏳ Подождите 2 секунды!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
        return
    end
    
    local char = LocalPlayer.Character
    if not char then
        StatusLabel.Text = "❌ Нет персонажа!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        return
    end
    
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        StatusLabel.Text = "❌ Нет RootPart!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        return
    end
    
    -- Супер-прыжок
    local boostHeight = 70
    local boostForward = 20
    
    local lookVector = rootPart.CFrame.LookVector
    local velocity = Vector3.new(
        lookVector.X * boostForward,
        boostHeight,
        lookVector.Z * boostForward
    )
    
    rootPart.AssemblyLinearVelocity = velocity
    
    StatusLabel.Text = "🚀 СУПЕР-ТОЛЧОК!"
    StatusLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
    
    -- Визуальный эффект
    BoostBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 200)
    task.wait(0.2)
    BoostBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
    
    -- Кулдаун
    BoostCooldown = true
    task.wait(2)
    BoostCooldown = false
end)

