end

-- 1 ЛИЦО + ДИНАМИЧЕСКИЕ РУКИ
local function fpStart()
    makeArms()
    if fpLoop then fpLoop:Disconnect() end
    fpLoop=RS.RenderStepped:Connect(function(dt)
        if not active then return end
        local c=LP.Character
        if not c then return end
        local head=c:FindFirstChild("Head")
        if not head then return end
        cam.CameraType=Enum.CameraType.Scriptable
        local shx=(math.random()-0.5)*shake*0.05
        local shy=(math.random()-0.5)*shake*0.05
        if shake>0.01 then shake=shake*0.92 end

        -- Камера идёт за джойстиком
        local h=c:FindFirstChildOfClass("Humanoid")
        if h and h.MoveDirection.Magnitude>0.1 then
            local moveAngle=math.atan2(-h.MoveDirection.X,-h.MoveDirection.Z)
            local targetAngle=angX
            local diff=((moveAngle-targetAngle+math.pi)%(math.pi*2))-math.pi
            angX=angX+diff*dt*3
        end

        local base=CFrame.new(head.Position)*CFrame.Angles(0,angX,0)*CFrame.Angles(angY,0,0)
        cam.CFrame=base*CFrame.Angles(shx,shy,0)

        for _,p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") and p.Name~="HumanoidRootPart" and not p:FindFirstAncestor("KulkidArms") then
                p.LocalTransparencyModifier=1
                if p.Transparency<1 then p.Transparency=1 end
            end
            if p:IsA("Decal") then p.Transparency=1 end
        end

        updateArms(dt)
    end)
end

local function fpStop()
    if fpLoop then fpLoop:Disconnect();fpLoop=nil end
    cam.CameraType=Enum.CameraType.Custom
    local c=LP.Character
    if c then
        local h=c:FindFirstChildOfClass("Humanoid")
        if h then cam.CameraSubject=h end
        local arms=c:FindFirstChild("KulkidArms")
        if arms then arms:Destroy() end
        for _,p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                p.LocalTransparencyModifier=0
                if p.Name~="HumanoidRootPart" then p.Transparency=0 end
            end
            if p:IsA("Decal") then p.Transparency=0 end
        end
    end
end

-- ТРЯСКА
local function shakeLoop()
    if sLoop then sLoop:Disconnect() end
    sLoop=task.spawn(function()
        while active do
            task.wait(math.random(4,10))
            if active then shake=math.random(8,20)/10 end
        end
    end)
end

-- СТАРТ/СТОП
local function start()
    active=true;Vig.Visible=true
    MB.Text="⏹  ВЫКЛЮЧИТЬ ВСЁ";MB.BackgroundColor3=Color3.fromRGB(100,20,20)
    SL.Text="КУЛКИД АКТИВЕН";SL.TextColor3=Color3.fromRGB(255,50,50)
    weatherOn();scan()
    if pLoop then pLoop:Disconnect() end
    pLoop=RS.Heartbeat:Connect(function() if active then scan() end end)
    attackLoop();fpStart();shakeLoop()
end

local function stop()
    active=false;Vig.Visible=false
    if pLoop then pLoop:Disconnect();pLoop=nil end
    if aLoop then aLoop:Disconnect();aLoop=nil end
    fpStop();shake=0;weatherOff()
    MB.Text="🖤  ВКЛЮЧИТЬ ВСЁ";MB.BackgroundColor3=Color3.fromRGB(40,20,20)
    SL.Text="Выключено";SL.TextColor3=Color3.fromRGB(150,150,160)
end

MB.MouseButton1Click:Connect(function() if active then stop() else start() end end)

LP.CharacterAdded:Connect(function()
    if active then task.wait(1);fpStop();task.wait(0.1);fpStart() end
end)

