local function startScream67()
    if screamLoop then screamLoop:Disconnect() end
    screamLoop=task.spawn(function()
        local chatEvent=game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
        local sayReq=chatEvent and chatEvent:FindFirstChild("SayMessageRequest")
        while screamLoop do
            if sayReq then
                pcall(function()
                    sayReq:FireServer("67! 67!!!!","All")
                end)
            end
            -- Звук "67" через громкий звук
            local s=Instance.new("Sound")
            s.SoundId="rbxassetid://131961133"
            s.Volume=8
            s.Parent=SG
            s:Play()
            task.delay(2,function() if s then s:Destroy() end end)
            task.wait(0.8)
        end
    end)
end

-- ===== ВСЕ ЗВУКИ ГРОМЧЕ =====
local function boostAllSounds()
    if soundBoostLoop then soundBoostLoop:Disconnect() end
    soundBoostLoop=RS.Heartbeat:Connect(function()
        for _,obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Sound") then
                if obj.Volume<10 then
                    obj.Volume=math.min(obj.Volume*3,20)
                end
            end
        end
        for _,obj in ipairs(SG:GetDescendants()) do
            if obj:IsA("Sound") then
                if obj.Volume<15 then
                    obj.Volume=math.min(obj.Volume*3,20)
                end
            end
        end
    end)
end

-- ===== ГЛАВНЫЙ ТРОЛЛЬ =====
local function playScream()
    -- Звуки
    local soundIds={
        "rbxassetid://90468563693248",
        "rbxassetid://131961133",
        "rbxassetid://1837879082",
        "rbxassetid://162608401",
        "rbxassetid://5153905925",
    }
    for _,id in ipairs(soundIds) do
        local s=Instance.new("Sound")
        s.SoundId=id
        s.Volume=15
        s.Parent=SG
        s:Play()
        task.delay(5,function() if s then s:Destroy() end end)
    end

    -- Красный экран
    local flash=Instance.new("Frame")
    flash.Size=UDim2.new(1,0,1,0)
    flash.BackgroundColor3=Color3.fromRGB(255,0,0)
    flash.BackgroundTransparency=0.3
    flash.BorderSizePixel=0
    flash.ZIndex=50
    flash.Parent=SG

    -- Скример-лицо
    local face=Instance.new("ImageLabel")
    face.Size=UDim2.new(1,0,1,0)
    face.BackgroundTransparency=1
    face.Image="rbxassetid://73034065288464"
    face.ImageTransparency=1
    face.ZIndex=51
    face.Parent=SG

    -- Тряска камеры
    task.spawn(function()
        for i=1,80 do
            if cam then
                cam.CFrame=cam.CFrame*CFrame.Angles(
                    (math.random()-0.5)*0.15,
                    (math.random()-0.5)*0.15,
                    (math.random()-0.5)*0.15
                )
            end
            task.wait(0.02)
        end
    end)

    TW:Create(flash,TweenInfo.new(0.3),{BackgroundTransparency=0.7}):Play()
    TW:Create(face,TweenInfo.new(0.1),{ImageTransparency=0}):Play()
    task.wait(0.5)
    TW:Create(face,TweenInfo.new(0.05),{ImageTransparency=1}):Play()
    task.wait(0.2)
    TW:Create(face,TweenInfo.new(0.1),{ImageTransparency=0}):Play()
    task.wait(2)
    TW:Create(face,TweenInfo.new(1),{ImageTransparency=1}):Play()
    TW:Create(flash,TweenInfo.new(1),{BackgroundTransparency=1}):Play()
    task.wait(1)
    if face then face:Destroy() end
    if flash then flash:Destroy() end
end

