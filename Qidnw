local function getAimPartFromModel(model)
    if aimBone == "Head" then return model:FindFirstChild("Head") end
    if aimBone == "UpperTorso" then return model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") end
    if aimBone == "LowerTorso" then return model:FindFirstChild("LowerTorso") or model:FindFirstChild("Torso") end
    if aimBone == "HumanoidRootPart" then return model:FindFirstChild("HumanoidRootPart") end
    return model:FindFirstChild("Head")
end

-- ============================================
-- ПРЕДИКТ
-- ============================================
local function getPredictedPosition(part, velocity)
    if not predictEnabled then return part.Position end
    local gravity = WS.Gravity
    local strength = predictStrength
    -- Для убийцы — усиленный предикт
    if getMyRole() == "Murderer" and predictForMurder then
        strength = murderPredictStrength
    end
    local predictTime = 0.15 * strength
    local predictedY = velocity.Y * predictTime - 0.5 * gravity * predictTime * predictTime
    return part.Position + Vector3.new(
        velocity.X * predictTime,
        predictedY,
        velocity.Z * predictTime
    )
end

local function getAimPositionFromPlayer(target)
    if not target or not target.Character then return nil end
    local char = target.Character
    local part = getAimPartFromModel(char)
    if not part then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then return getPredictedPosition(part, hrp.Velocity) end
    return part.Position
end

local function getAimPositionFromNPC(npc)
    if not npc or not npc.model then return nil end
    local part = getAimPartFromModel(npc.model)
    if not part then return nil end
    local hrp = npc.model:FindFirstChild("HumanoidRootPart")
    if hrp then return getPredictedPosition(part, hrp.Velocity) end
    return part.Position
end

-- ============================================
-- ВИДИМОСТЬ (WallCheck)
-- ============================================
local function isVisibleTo(instancesToIgnore, targetPos)
    if not LP.Character then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignoreList = {LP.Character}
    for _, inst in ipairs(instancesToIgnore) do table.insert(ignoreList, inst) end
    params.FilterDescendantsInstances = ignoreList
    params.IgnoreWater = true
    local origin = CAM.CFrame.Position
    local direction = targetPos - origin
    local result = WS:Raycast(origin, direction, params)
    return result == nil
end

-- ============================================
-- ПОИСК ИГРОКОВ
-- ============================================
local function getTargetsByPriority()
    local myRole = getMyRole()
    local myChar = LP.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return {}, {} end
    local myPos = myChar.HumanoidRootPart.Position

    local priorityList = {}
    local normalList = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and player.Character then
            local char = player.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local role = getPlayerRole(player)
                local dist = (myPos - hrp.Position).Magnitude
                local entry = { player = player, char = char, hrp = hrp, dist = dist, role = role, isNPC = false }

                local isPriority = false
                if myRole == "Sheriff" and role == "Murderer" then isPriority = true end
                -- УБИЙЦА → ШЕРИФ (главный приоритет)
                if myRole == "Murderer" and aimAtSheriffPriority and role == "Sheriff" then isPriority = true end
                -- Убийца → все остальные (если killAll)
                if myRole == "Murderer" and killAllForMurder then isPriority = true end

                if isPriority then
                    table.insert(priorityList, entry)
                else
                    table.insert(normalList, entry)
                end
            end
        end
    end

    table.sort(priorityList, function(a, b) return a.dist < b.dist end)
    table.sort(normalList, function(a, b) return a.dist < b.dist end)

    return priorityList, normalList
end

-- ============================================
-- ВЫБОР ЦЕЛИ
-- ============================================
local function getBestTarget()
    if npcOnlyMode or aimNPCEnabled then
        local npcs = findNPCs()
        if #npcs > 0 then
            if wallCheckEnabled then
                for _, npc in ipairs(npcs) do
                    local aimPos = getAimPositionFromNPC(npc)
                    if aimPos and isVisibleTo({npc.model}, aimPos) then
                        return { type = "NPC", npc = npc }
                    end
                end
                if npcOnlyMode then return nil end
            else
                return { type = "NPC", npc = npcs[1] }
            end
        end
        if npcOnlyMode then return nil end
    end

    local prio, normal = getTargetsByPriority()
    local list = #prio > 0 and prio or normal
    if #list == 0 then return nil end

    if wallCheckEnabled then
        for _, entry in ipairs(list) do
            local aimPos = getAimPositionFromPlayer(entry.player)
            if aimPos and isVisibleTo({entry.char}, aimPos) then
                return { type = "Player", player = entry.player }
            end
        end
        return nil
    end
    return { type = "Player", player = list[1].player }
end

