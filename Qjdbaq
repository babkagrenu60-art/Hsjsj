local function makePage()
    local f=Instance.new("Frame")
    f.Size=UDim2.new(1,0,1,-86)
    f.Position=UDim2.new(0,0,0,84)
    f.BackgroundTransparency=1
    f.Visible=false
    f.Parent=MF
    return f
end

for i=1,#tabs do
    Pages[i]=makePage()
end

local function selectTab(idx)
    for i,btn in ipairs(TabButtons) do
        if i==idx then
            btn.BackgroundColor3=CFG.Color
            btn.TextColor3=Color3.fromRGB(0,0,0)
            Pages[i].Visible=true
        else
            btn.BackgroundColor3=Color3.fromRGB(35,25,20)
            btn.TextColor3=Color3.fromRGB(180,160,140)
            Pages[i].Visible=false
        end
    end
end

for i,btn in ipairs(TabButtons) do
    btn.MouseButton1Click:Connect(function() selectTab(i) end)
end

selectTab(1)

local function makeBtn(parent,text,y,color)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(1,-10,0,36)
    b.Position=UDim2.new(0,5,0,y)
    b.BackgroundColor3=color or Color3.fromRGB(35,25,20)
    b.BorderSizePixel=0
    b.Text=text
    b.TextColor3=Color3.fromRGB(220,200,180)
    b.TextSize=11
    b.Font=Enum.Font.GothamBold
    b.AutoButtonColor=false
    b.Parent=parent
    cr(b,10)
    return b
end

local function getChar()
    local c=LP.Character
    if not c then return nil,nil,nil end
    local h=c:FindFirstChildOfClass("Humanoid")
    local hrp=c:FindFirstChild("HumanoidRootPart")
    return c,h,hrp
end

local function getShip()
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower():find("boat") then
            return obj
        end
    end
    return nil
end

