function Process()local c=Player.Character if not c then return end local r=c:FindFirstChild("HumanoidRootPart")if not r then return end local h=c:FindFirstChild("Humanoid")if not h then return end FC=FC+1 if FC%20==0 then AddPos(r.Position)end local e,d=GetClosest()local i={Aggression=NN.Weights.Aggression,Caution=1/(d+1),Exploration=#NN.Memory.Positions/S.MemorySize,ReactionTime=1/(NN.Weights.ReactionTime+0.1),Accuracy=NN.Weights.Accuracy}local dec=Decide(i)if e and d<S.DetectionRadius then if d<40 and dec>0.6 then NN.State.Mode="chasing"elseif d<20 then NN.State.Mode="fleeing"else NN.State.Mode="approaching"end else NN.State.Mode="exploring"end if NN.State.Mode=="exploring"then if not NN.State.Target or IsVisited(NN.State.Target,15)or IsDangerous(NN.State.Target,25)then NN.State.Target=GetUnvisited()if not NN.State.Target then local a=math.random()*2*math.pi local dist=math.random(30,80)NN.State.Target=r.Position+Vector3.new(math.cos(a)*dist,0,math.sin(a)*dist)end end if NN.State.Target then local dir=NN.State.Target-r.Position if dir.Magnitude>5 then Move(dir)else AddPos(NN.State.Target)NN.State.Target=nil end end elseif NN.State.Mode=="chasing"or NN.State.Mode=="approaching"then if e and e.Character then local tr=e.Character:FindFirstChild("HumanoidRootPart")if tr then local dir=tr.Position-r.Position local ro=Vector3.new((math.random()-0.5)*2,0,(math.random()-0.5)*2)*(1-dec)Move(dir+ro)if dir.Magnitude<50 and FC%15==0 then AimShoot(e)end if dir.Magnitude<15 and dec>0.7 and FC%30==0 then Jump()end end end elseif NN.State.Mode=="fleeing"then if e and e.Character then local tr=e.Character:FindFirstChild("HumanoidRootPart")if tr then local dir=(r.Position-tr.Position).Unit Move(dir*0.5)end end end if FC%10==0 then NI.BackgroundColor3=NN.State.Confidence>0.7 and Color3.fromRGB(0,255,0)or Color3.fromRGB(255,255,0)NI.BackgroundTransparency=1-NN.State.Confidence end end
function HandleDeath()local c=Player.Character if c and c:FindFirstChild("HumanoidRootPart")then AddDeath(c.HumanoidRootPart.Position)end NN.Learning.LastDeath=tick()NN.State.Confidence=math.max(0.1,NN.State.Confidence-0.3)Learn(false,{Aggression=-0.2,Caution=0.3,Exploration=0.1})end
