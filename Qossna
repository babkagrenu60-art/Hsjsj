-- ИИ ПОБЕГА
local function getTargetChar()
    if not target or not target.Character then return nil end
    return target.Character
end

local function getDistance(a,b)
    if not a or not b then return 999 end
    return (a.Position-b.Position).Magnitude
end

local function isPathBlocked(hrp,dir)
    local ray=Ray.new(hrp.Position,dir*4)
    local hit=workspace:FindPartOnRay(ray,LP.Character)
    return hit~=nil
end

local function findEscapeDir(myHrp,threatHrp)
    local away=(myHrp.Position-threatHrp.Position)
    away=Vector3.new(away.X,0,away.Z)
    if away.Magnitude<0.1 then away=Vector3.new(1,0,0) end
    away=away.Unit

    -- Пробуем несколько направлений: назад, влево, вправо
    local candidates={
        away,
        Vector3.new(-away.Z,0,away.X),
        Vector3.new(away.Z,0,-away.X),
        (away+Vector3.new(-away.Z,0,away.X)).Unit,
        (away+Vector3.new(away.Z,0,-away.X)).Unit,
    }

    local best=away
    local bestScore=-999
    for _,dir in ipairs(candidates) do
        -- Проверяем, не в стене ли
        local blocked=isPathBlocked(myHrp,dir)
        -- Проверяем, уводит ли от угрозы
        local newPos=myHrp.Position+dir*10
        local distFromThreat=(newPos-threatHrp.Position).Magnitude
        local score=distFromThreat - (blocked and 100 or 0)
        if score>bestScore then
            bestScore=score
            best=dir
        end
    end
    return best
end

local function escapeLoop()
    if aiLoop then aiLoop:Disconnect() end
    aiLoop=RS.Heartbeat:Connect(function(dt)
        if not active then return end
        local myChar=LP.Character
        if not myChar then return end
        local myHrp=myChar:FindFirstChild("HumanoidRootPart")
        local myHum=myChar:FindFirstChildOfClass("Humanoid")
        if not myHrp or not myHum then return end

        local tChar=getTargetChar()
        if not tChar then
            myHum:MoveTo(myHrp.Position)
            return
        end
        local tHrp=tChar:FindFirstChild("HumanoidRootPart")
        local tHum=tChar:FindFirstChildOfClass("Humanoid")
        if not tHrp or not tHum then return end

        local dist=getDistance(myHrp,tHrp)

        -- Если цель далеко — идём от неё по прямой
        if dist>30 then
            local away=(myHrp.Position-tHrp.Position)
            away=Vector3.new(away.X,0,away.Z).Unit
            myHum:MoveTo(myHrp.Position+away*20)
        else
            -- Близко — активно уворачиваемся
            local dir=findEscapeDir(myHrp,tHrp)
            local targetPos=myHrp.Position+dir*25
            myHum:MoveTo(targetPos)

            -- Прыжок через препятствие
            jumpCooldown=jumpCooldown-dt
            if jumpCooldown<=0 then
                local rayFront=Ray.new(myHrp.Position,dir*3)
                local hit=workspace:FindPartOnRay(rayFront,myChar)
                if hit then
                    myHum.Jump=true
                    jumpCooldown=0.5
                end
            end

            -- Резкий рывок в сторону если цель вплотную
            if dist<8 then
                dodgeCooldown=dodgeCooldown-dt
                if dodgeCooldown<=0 then
                    local side=Vector3.new(-dir.Z,0,dir.X)
                    if math.random()<0.5 then side=-side end
                    myHrp.AssemblyLinearVelocity=side*40+Vector3.new(0,20,0)
                    dodgeCooldown=0.6
                end
            end
        end
    end)
end

local function stopEscape()
    if aiLoop then aiLoop:Disconnect();aiLoop=nil end
    local myChar=LP.Character
    if myChar then
        local myHum=myChar:FindFirstChildOfClass("Humanoid")
        if myHum then myHum:MoveTo(myChar:FindFirstChild("HumanoidRootPart").Position) end
    end
end

