local function weatherOff()
    if savedL[1] then
        L.FogEnd=savedL[1];L.FogStart=savedL[2];L.FogColor=savedL[3]
        L.Brightness=savedL[4];L.Ambient=savedL[5]
        L.OutdoorAmbient=savedL[6];L.ClockTime=savedL[7]
    end
    if sky then sky:Destroy();sky=nil end
    if oldSky then oldSky.Parent=L;oldSky=nil end
    local a=L:FindFirstChild("RussiaAtm");if a then a:Destroy() end
end

-- СОЗДАНИЕ ШАХИДА
local function makeShahid(targetPos,isRocket,isNuke)
    local bomb=Instance.new("Part")
    bomb.Name="Shahid"
    bomb.Size=Vector3.new(2,1,4)
    bomb.Color=isNuke and Color3.fromRGB(255,255,0) or isRocket and Color3.fromRGB(200,50,50) or Color3.fromRGB(100,100,100)
    bomb.Material=Enum.Material.Metal
    bomb.Anchored=false
    bomb.CanCollide=false
    bomb.Parent=workspace

    -- Дымный трейл
    local att=Instance.new("Attachment");att.Parent=bomb
    local trail=Instance.new("Trail")
    trail.Attachment0=att
    trail.Lifetime=1
    trail.Color=ColorSequence.new(Color3.fromRGB(80,80,80))
    trail.Transparency=NumberSequence.new(0.3)
    trail.Parent=bomb

    -- Звук двигателя
    local snd=Instance.new("Sound")
    snd.SoundId="rbxassetid://131961133"
    snd.Volume=3;Loop=false
    snd.Looped=true;snd.Parent=bomb;snd:Play()

    -- Стартовая позиция: высоко в небе над целью
    local startX=targetPos.X+math.random(-30,30)
    local startZ=targetPos.Z+math.random(-30,30)
    local startY=targetPos.Y+300
    bomb.CFrame=CFrame.new(startX,startY,startZ)

    -- Направление вниз к цели
    local dir=(targetPos-bomb.Position).Unit
    bomb.AssemblyLinearVelocity=dir*150

    -- Отслеживание попадания
    local hitConn
    hitConn=bomb.Touched:Connect(function(hit)
        if not bomb or not bomb.Parent then return end
        local char=hit.Parent
        local hum=char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        hitConn:Disconnect()
        bomb:Destroy()
        -- Взрыв
        local exp=Instance.new("Explosion")
        exp.Position=bomb.Position
        if isNuke then
            exp.BlastRadius=120
            exp.BlastPressure=5000000
        elseif isRocket then
            exp.BlastRadius=60
            exp.BlastPressure=2000000
        else
            exp.BlastRadius=25
            exp.BlastPressure=500000
        end
        exp.DestroyJointRadiusPercent=1
        exp.Parent=workspace
        -- Тряска камеры
        shake=isNuke and 5 or isRocket and 3 or 1.5
        -- Урон игрокам вручную (для надёжности)
        local dmg=isNuke and 0.99 or isRocket and 0.6 or 0.35
        for _,plr in ipairs(P:GetPlayers()) do
            local pc=plr.Character
            if pc then
                local phrp=pc:FindFirstChild("HumanoidRootPart")
                local phum=pc:FindFirstChildOfClass("Humanoid")
                if phrp and phum then
                    local dist=(phrp.Position-bomb.Position).Magnitude
                    if dist<=exp.BlastRadius then
                        if isNuke then
                            phum.Health=phum.Health*(1-dmg)
                        else
                            phum.Health=phum.Health*(1-dmg)
                        end
                    end
                end
            end
        end
    end)

    -- Автоудаление через 10 сек
    task.delay(10,function()
        if bomb and bomb.Parent then
            hitConn:Disconnect()
            bomb:Destroy()
        end
    end)
end

-- СПАВН
local function spawnBomb()
    -- Целимся в случайного игрока или в случайную точку
    local target=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local pos
    if target and math.random()<0.7 then
        pos=target.Position
    else
        local basePos=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local base=basePos and basePos.Position or Vector3.new(0,50,0)
        pos=base+Vector3.new(math.random(-80,80),0,math.random(-80,80))
    end

    local r=math.random()
    if r<0.02 then
        -- 2% ядерная
        makeShahid(pos,false,true)
        SL.Text="☢️ ЯДЕРНАЯ РАКЕТА!"
        SL.TextColor3=Color3.fromRGB(255,255,0)
    elseif r<0.15 then
        -- 13% ракета
        makeShahid(pos,true,false)
        SL.Text="🚀 РАКЕТА ЛЕТИТ!"
        SL.TextColor3=Color3.fromRGB(255,100,100)
    else
        -- 85% шахид
        makeShahid(pos,false,false)
        SL.Text="🚁 Шахид летит"
        SL.TextColor3=Color3.fromRGB(200,200,200)
    end
end

-- ЦИКЛ СПАВНА
local function startSpawn()
    if spawnLoop then spawnLoop:Disconnect() end
    spawnLoop=task.spawn(function()
        while active do
            task.wait(math.random(2,4))
            if active then spawnBomb() end
        end
    end)
end

-- ТРЯСКА КАМЕРЫ
local function shakeLoop()
    if aLoop then aLoop:Disconnect() end
    aLoop=RS.RenderStepped:Connect(function()
        if not active then return end
        if shake>0.01 then
            local cam=workspace.CurrentCamera
            if cam then
                local sx=(math.random()-0.5)*shake*0.05
                local sy=(math.random()-0.5)*shake*0.05
                cam.CFrame=cam.CFrame*CFrame.Angles(sx,sy,0)
                shake=shake*0.9
            end
        end
    end)
end

-- ПУЛЬС ВИНЬЕТКИ
task.spawn(function()
    while task.wait(0.1) do
        if active and Vig.Visible then
            local pulse=math.abs(math.sin(tick()*2))*0.15
            for _,e in ipairs{tE,bE,lE,rE} do
                local g=e:FindFirstChildOfClass("UIGradient")
                if g then
                    g.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.2),NumberSequenceKeypoint.new(0.5,0.7+pulse),NumberSequenceKeypoint.new(1,1)})
                end
            end
        end
    end
end)

-- СТАРТ/СТОП
local function start()
    active=true;Vig.Visible=true
    MB.Text="⏹  ОСТАНОВИТЬ БОМБЁЖКУ";MB.BackgroundColor3=Color3.fromRGB(100,20,20)
    SL.Text="БОМБЁЖКА НАЧАЛАСЬ";SL.TextColor3=Color3.fromRGB(255,50,50)
    weatherOn();startSpawn();shakeLoop()
end

local function stop()
    active=false;Vig.Visible=false;shake=0
    if spawnLoop then spawnLoop=nil end
    if aLoop then aLoop:Disconnect();aLoop=nil end
    weatherOff()
    for _,o in ipairs(workspace:GetChildren()) do
        if o.Name=="Shahid" then o:Destroy() end
    end
    MB.Text="🇷🇺  НАЧАТЬ БОМБЁЖКУ";MB.BackgroundColor3=Color3.fromRGB(40,20,20)
    SL.Text="Остановлено";SL.TextColor3=Color3.fromRGB(150,150,160)
end

