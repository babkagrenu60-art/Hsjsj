local function saveTransform(char)
    if savedTransforms[char] then return end
    local data={parts={},scales={}}
    local hum=char:FindFirstChildOfClass("Humanoid")
    if hum then
        if hum:FindFirstChild("BodyWidthScale") then
            data.scales.body={hum.BodyDepthScale.Value,hum.BodyWidthScale.Value,hum.BodyHeightScale.Value}
        end
        if hum:FindFirstChild("HeadScale") then data.scales.head=hum.HeadScale.Value end
    end
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then data.parts[p]={color=p.Color,size=p.Size} end
    end
    savedTransforms[char]=data
end

local function makeMonster(char)
    if not char then return end
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    saveTransform(char)
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.Color=Color3.fromRGB(200,0,0) end
    end
    if hum:FindFirstChild("BodyWidthScale") then
        hum.BodyWidthScale.Value=1.8
        hum.BodyDepthScale.Value=1.5
        hum.BodyHeightScale.Value=1.4
    end
    if hum:FindFirstChild("HeadScale") then hum.HeadScale.Value=1.6 end
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            local n=p.Name
            if n:find("Arm") or n:find("Leg") then
                p.Size=Vector3.new(p.Size.X*1.5,p.Size.Y*2,p.Size.Z*1.5)
            elseif n=="Torso" or n=="UpperTorso" or n=="LowerTorso" then
                p.Size=Vector3.new(p.Size.X*1.6,p.Size.Y*1.5,p.Size.Z*1.6)
            end
        end
    end
    if hum:FindFirstChild("RightShoulder") then
        hum.RightShoulder.C0=CFrame.new(0,0.5,0)*CFrame.Angles(math.rad(-90),0,0)
    end
    if hum:FindFirstChild("LeftShoulder") then
        hum.LeftShoulder.C0=CFrame.new(0,0.5,0)*CFrame.Angles(math.rad(-90),0,0)
    end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    if hrp and soundOn then
        local snd=Instance.new("Sound")
        snd.SoundId=SCREAM_ID;snd.Volume=5;snd.Looped=true
        snd.Parent=hrp;snd:Play()
    end
end

local function resetMonster(char)
    if not char then return end
    local hum=char:FindFirstChildOfClass("Humanoid")
    local data=savedTransforms[char]
    if data then
        for p,info in pairs(data.parts) do
            if p and p.Parent then p.Color=info.color;p.Size=info.size end
        end
        if hum and data.scales.body and hum:FindFirstChild("BodyWidthScale") then
            hum.BodyWidthScale.Value=data.scales.body[2]
            hum.BodyDepthScale.Value=data.scales.body[1]
            hum.BodyHeightScale.Value=data.scales.body[3]
        end
        if hum and data.scales.head and hum:FindFirstChild("HeadScale") then
            hum.HeadScale.Value=data.scales.head
        end
        if hum and hum:FindFirstChild("RightShoulder") then hum.RightShoulder.C0=CFrame.new(1,0.5,0) end
        if hum and hum:FindFirstChild("LeftShoulder") then hum.LeftShoulder.C0=CFrame.new(-1,0.5,0) end
    end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _,s in ipairs(hrp:GetChildren()) do
            if s:IsA("Sound") then s:Destroy() end
        end
    end
    savedTransforms[char]=nil
end

local function infectPlayer(plr)
    if infectedPlayers[plr] then return end
    infectedPlayers[plr]=true
    local c=plr.Character
    if c then makeMonster(c) end
    plr.CharacterAdded:Connect(function(char)
        if infectedPlayers[plr] then
            task.wait(1)
            makeMonster(char)
        end
    end)
end

-- ===== АТАКА + ОТКИДЫВАНИЕ ПРИ СТОЕ =====
local function startAttackLoop()
    if attackLoop then attackLoop:Disconnect() end
    attackLoop=RS.Heartbeat:Connect(function(dt)
        if not active then return end
        local myChar=LP.Character
        if not myChar then return end
        local myHrp=myChar:FindFirstChild("HumanoidRootPart")
        local myHum=myChar:FindFirstChildOfClass("Humanoid")
        if not myHrp or not myHum then return end

        -- Проверяем: стою ли я на месте
        local moving=myHum.MoveDirection.Magnitude>0.1
        local nearbyMonster=false
        local closestMonster=nil
        local minDist=999

        for plr,_ in pairs(infectedPlayers) do
            if plr~=LP and plr.Parent then
                local c=plr.Character
                if c then
                    local hrp=c:FindFirstChild("HumanoidRootPart")
                    local hum=c:FindFirstChildOfClass("Humanoid")
                    if hrp and hum then
                        local dist=(hrp.Position-myHrp.Position).Magnitude
                        if dist<=attackRange then
                            nearbyMonster=true
                            if dist<minDist then minDist=dist;closestMonster={plr=plr,char=c,hrp=hrp,hum=hum} end
                            -- Монстр идёт к тебе
                            if dist>0.5 then
                                local dir=(myHrp.Position-hrp.Position)
                                dir=Vector3.new(dir.X,0,dir.Z)
                                if dir.Magnitude>0.1 then
                                    dir=dir.Unit
                                    local newPos=hrp.Position+dir*monsterSpeed
                                    local ray=Ray.new(hrp.Position,dir*3)
                                    local hit=workspace:FindPartOnRay(ray,c)
                                    if not hit then hrp.CFrame=CFrame.new(newPos,newPos+dir) end
                                    if hum.WalkSpeed==0 then hum.WalkSpeed=16 end
                                end
                            end
                        else
                            if hum.WalkSpeed~=0 then hum.WalkSpeed=0 end
                        end
                    end
                end
            end
        end

        -- Если стою и монстр рядом — откидывает
        if not moving and nearbyMonster and closestMonster then
            local dir=(myHrp.Position-closestMonster.hrp.Position)
            dir=Vector3.new(dir.X,0,dir.Z)
            if dir.Magnitude<0.1 then dir=Vector3.new(0,0,1) end
            dir=dir.Unit
            -- Откидываем ТЕБЯ
            myHrp.AssemblyLinearVelocity=dir*80 + Vector3.new(0,60,0)
            -- Тряска камеры
            shakeIntensity=1.5
            -- Крик
            if soundOn then
                local snd=Instance.new("Sound")
                snd.SoundId=SCREAM_ID;snd.Volume=5
                snd.Parent=myHrp;snd:Play()
                task.delay(3,function() if snd then snd:Destroy() end end)
            end
            StatusLbl.Text="МОНСТР ОТКИНУЛ ТЕБЯ!"
            StatusLbl.TextColor3=Color3.fromRGB(255,50,50)
            task.wait(2)
            if active then
                StatusLbl.Text="КУЛКИД АКТИВЕН"
                StatusLbl.TextColor3=Color3.fromRGB(255,50,50)
            end
        end
    end)
end

