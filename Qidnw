local function isPlayerCharacter(model)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character == model then return true end
    end
    return false
end

local function findNPCs()
    local npcs = {}
    local myChar = LP.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return npcs end
    local myPos = myChar.HumanoidRootPart.Position

    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("Humanoid") then
            local model = obj.Parent
            if model and not isPlayerCharacter(model) then
                local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
                local head = model:FindFirstChild("Head")
                if hrp and head and obj.Health > 0 then
                    local dist = (myPos - hrp.Position).Magnitude
                    if dist <= npcAimRange and model ~= myChar then
                        table.insert(npcs, {
                            model = model,
                            humanoid = obj,
                            hrp = hrp,
                            head = head,
                            dist = dist,
                        })
                    end
                end
            end
        end
    end
    table.sort(npcs, function(a, b) return a.dist < b.dist end)
    return npcs
end

-- ============================================
-- КОСТЬ ЦЕЛИ
