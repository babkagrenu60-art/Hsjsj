local function spin()
if isSpinning then return end
isSpinning=true
SpinBtn.Text="🎰  КРУТИМ..."
local spinTime=2
local startTick=tick()
while tick()-startTick<spinTime do
local r=events[math.random(1,#events)]
RollText.Text=r.name
RollText.TextColor3=r.color
task.wait(0.05)
end
local index=math.random(1,#events)
local ev=events[index]
RollText.Text="💥 "..ev.name
RollText.TextColor3=ev.color
task.spawn(eventFuncs[index])
task.wait(1.5)
SpinBtn.Text="🎰  КРУТИТЬ"
isSpinning=false
end

