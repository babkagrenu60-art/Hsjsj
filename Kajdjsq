-- Поиск ближайшей стены
local function FindNearestWall()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local closestWall = nil
    local shortestDistance = 20
    local currentPos = rootPart.Position
    
    -- Ищем стены в радиусе
    local parts = workspace:GetPartBoundsInRadius(currentPos, shortestDistance)
    
    for _, part in pairs(parts) do
        if part:IsA("BasePart") and part.CanCollide then
            -- Проверяем, что это не часть персонажа
            if not part:IsDescendantOf(character) then
                -- Проверяем, что стена достаточно высокая
                local sizeY = part.Size.Y
                if sizeY > 3 then
                    local distance = (currentPos - part.Position).Magnitude
                    -- Проверяем, что стена находится спереди
                    local directionToWall = (part.Position - currentPos).Unit
                    local forward = rootPart.CFrame.LookVector
                    
                    -- Стена должна быть впереди и не слишком низко
                    if directionToWall:Dot(forward) > 0.3 and part.Position.Y > currentPos.Y - 3 then
                        if distance < shortestDistance then
                            shortestDistance = distance
                            closestWall = part
                        end
                    end
                end
            end
        end
    end
    
    return closestWall
end

-- Функция велхопа
local function DoWallHop()
    if not WH_Enabled then return end
    
    local character = LocalPlayer.Character
    if not character then 
        StatusLabel.Text = "❌ Персонаж не найден"
        return 
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not rootPart then 
        StatusLabel.Text = "❌ Нет Humanoid"
        return 
    end
    
    if humanoid.Health <= 0 then
        StatusLabel.Text = "💀 Персонаж мертв"
        return
    end
    
    local targetWall = FindNearestWall()
    
    if targetWall then
        local wallPos = targetWall.Position
        local wallCFrame = targetWall.CFrame
        
        -- Вычисляем направление к стене
        local directionToWall = (Vector3.new(wallPos.X, rootPart.Position.Y, wallPos.Z) - rootPart.Position).Unit
        
        -- Разворачиваемся к стене спиной (для велхопа)
        local lookDirection = -directionToWall
        rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + lookDirection)
        
        -- Двигаемся к стене
        local movePos = wallPos - directionToWall * 2
        humanoid:MoveTo(Vector3.new(movePos.X, rootPart.Position.Y, movePos.Z))
        
        -- Проверяем, достаточно ли близко к стене
        local distanceToWall = (rootPart.Position - wallPos).Magnitude
        
        if distanceToWall < 4 then
            -- Делаем велхоп
            humanoid.Jump = true
            
            -- Мощный толчок вверх и в сторону от стены
            local jumpVelocity = directionToWall * 8 + Vector3.new(0, 45, 0)
            rootPart.AssemblyLinearVelocity = jumpVelocity
            
            StatusLabel.Text = "🏃 Велхоп выполнен!"
            StatusLabel.TextColor3 = Color3.fromRGB(85, 255, 140)
            
            task.wait(0.05)
        else
            StatusLabel.Text = "🔍 Ищу стену... Расстояние: " .. math.floor(distanceToWall)
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
        end
    else
        StatusLabel.Text = "🔍 Стена не найдена"
        StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end

