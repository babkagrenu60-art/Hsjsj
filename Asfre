    end
end)

-- ========== WALLHACK ==========
local function toggleWallhack(state)
    Settings.WallhackEnabled = state
    
    if state then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Name ~= "Handle" and v.Name ~= "Knife" and v.Name ~= "Gun" then
                if v:FindFirstChild("OriginalTransparency") == nil then
                    local orig = Instance.new("NumberValue")
                    orig.Name = "OriginalTransparency"
                    orig.Value = v.Transparency
                    orig.Parent = v
                end
                v.Transparency = 0.5
                v.Material = Enum.Material.SmoothPlastic
            end
        end
        Fluent:Notify({ Title = "Wallhack", Content = "Включен!", Duration = 2 })
    else
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                local orig = v:FindFirstChild("OriginalTransparency")
                if orig then
                    v.Transparency = orig.Value
                    orig:Destroy()
                end
            end
        end
        Fluent:Notify({ Title = "Wallhack", Content = "Выключен!", Duration = 2 })
    end
end

