local ScreenGui = Instance.new("ScreenGui")
local PlaneBtn = Instance.new("TextButton")
local PlaneCorner = Instance.new("UICorner")
local DroneBtn = Instance.new("TextButton")
local DroneCorner = Instance.new("UICorner")

