        CreateShootButton()
        autoShootButton.Visible = true
        
        -- Автоматически ищем убийцу и стреляем каждые 1.5 секунды
        if shootConnection then shootConnection:Disconnect() end
        
        shootConnection = RunService.Heartbeat:Connect(function()
            if not autoShootActive then return end
            -- Стреляем каждые 1.5 секунды
            if tick() % 1.5 < 0.05 then
                ShootAtMurderer()
            end
        end)
        
    else
        AutoShootToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        AutoShootToggleBtn.Text = "🔫 АВТОСТРЕЛЬБА: ВЫКЛ"
        
        if autoShootButton then
            autoShootButton.Visible = false
        end
        
        if shootConnection then
            shootConnection:Disconnect()
            shootConnection = nil
        end
    end
end)

