-- Функция активации (сигмоида)
function NeuralCore.Activate(value)
    return 1 / (1 + math.exp(-value))
end

-- Принятие решения на основе весов
function NeuralCore.Decide(inputs)
    local decision = 0
    for key, weight in pairs(NeuralNetwork.Weights) do
        if inputs[key] then
            decision = decision + (inputs[key] * weight)
        end
    end
    return NeuralCore.Activate(decision)
end

-- Обучение (корректировка весов)
function NeuralCore.Learn(success, feedback)
    NeuralNetwork.Learning.Iterations = NeuralNetwork.Learning.Iterations + 1
    
    local learningRate = SETTINGS.LearningRate * (1 + NeuralNetwork.Learning.Adaptations / 100)
    
    if success then
        -- Усиление правильных решений
        for key, weight in pairs(NeuralNetwork.Weights) do
            NeuralNetwork.Weights[key] = math.min(1, weight + (learningRate * (feedback[key] or 0.01)))
        end
        NeuralNetwork.Learning.SuccessRate = (NeuralNetwork.Learning.SuccessRate * 0.9) + 0.1
    else
        -- Ослабление неправильных решений
        for key, weight in pairs(NeuralNetwork.Weights) do
            NeuralNetwork.Weights[key] = math.max(0, weight - (learningRate * 0.1))
        end
        NeuralNetwork.Learning.SuccessRate = NeuralNetwork.Learning.SuccessRate * 0.95
    end
    
    -- Адаптация (каждые 10 итераций)
    if NeuralNetwork.Learning.Iterations % 10 == 0 then
        NeuralNetwork.Learning.Adaptations = NeuralNetwork.Learning.Adaptations + 1
    end
end

-- ============================================================
-- СИСТЕМА ДВИЖЕНИЯ (принудительное через BodyVelocity)
-- ============================================================
local MovementSystem = {}

function MovementSystem.Move(direction, speed)
    local char = Player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Очищаем старые силы
    for _, v in ipairs(root:GetChildren()) do
        if v:IsA("BodyVelocity") or v:IsA("BodyForce") then
            v:Destroy()
        end
    end
    
    if direction.Magnitude < 0.1 then
        return
    end
    
    speed = speed or SETTINGS.MoveSpeed
    
    -- Основное движение
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(4000, 4000, 4000)
    bodyVelocity.Velocity = direction.Unit * speed
    bodyVelocity.Parent = root
    
    -- Дополнительная сила для стабильности (гравитация)
    local bodyForce = Instance.new("BodyForce")
    bodyForce.Force = Vector3.new(0, char:GetMass() * workspace.Gravity, 0)
    bodyForce.Parent = root
    
    -- Автоматическое удаление через 0.3 секунды
    Debris:AddItem(bodyVelocity, 0.3)
    Debris:AddItem(bodyForce, 0.3)
    
    -- Плавный поворот в сторону движения
    if direction.Magnitude > 0.5 then
        local lookPosition = root.Position + direction.Unit * 10
        local targetCFrame = CFrame.lookAt(root.Position, lookPosition)
        root.CFrame = root.CFrame:Lerp(targetCFrame, 0.15)
    end
end

function MovementSystem.Stop()
    local char = Player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    for _, v in ipairs(root:GetChildren()) do
        if v:IsA("BodyVelocity") or v:IsA("BodyForce") then
            v:Destroy()
        end
    end
end

function MovementSystem.Jump()
    local char = Player.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid then
        humanoid:Jump()
    end
end

