SG.Parent=PG

local function cr(p,r)
    local c=Instance.new("UICorner")
    c.CornerRadius=UDim.new(0,r)
    c.Parent=p
    return c
end

local function st(p,col,t)
    local s=Instance.new("UIStroke")
    s.Color=col
    s.Thickness=t or 1.5
    s.Parent=p
    return s
end

