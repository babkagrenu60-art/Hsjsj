-- Поиск стены
local function FindNearestWall()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPart = character.HumanoidRootPart
    
    local closestWall = nil
    local shortestDistance = 25 
    
    local parts = workspace:GetPartBoundsInRadius(rootPart.Position, shortestDistance)
    for _, part in pairs(parts) do
        if part:IsA("BasePart") and part.CanCollide and part.Size.Y > 5 and not part:IsDescendantOf(character) then
            local distance = (rootPart.Position - part.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                closestWall = part
            end
        end
    end
    return closestWall
end

-- Процесс велхопа
local function DoWallHop()
    if not WH_Enabled then return end
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildWhichIsA("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return end
    
    local targetWall = FindNearestWall()
    if targetWall then
        local wallPos = targetWall.Position
        local direction = (Vector3.new(wallPos.X, rootPart.Position.Y, wallPos.Z) - rootPart.Position).Unit
        
        humanoid:MoveTo(wallPos - (direction * 1.5))
        rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position - direction) -- Поворот спиной
        
        local ray = Ray.new(rootPart.Position, direction * 2)
        local hit, _ = workspace:FindPartOnRayWithIgnoreList(ray, {character})
        
        if hit then
            humanoid.Jump = true
            rootPart.Velocity = Vector3.new(rootPart.Velocity.X + (direction.X * 2), 48, rootPart.Velocity.Z + (direction.Z * 2))
            task.wait(0.08)
        end
    end
end

-- Логика кнопки включения
ToggleBtn.MouseButton1Click:Connect(function()
    WH_Enabled = not WH_Enabled
    if WH_Enabled then
        ToggleBtn.Text = "АВТО-ВЕЛХОП: ВКЛ"
        ToggleBtn.TextColor3 = Color3.fromRGB(85, 255, 140) -- Зеленый
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 55, 45)
        
        task.spawn(function()
            while WH_Enabled do
                pcall(DoWallHop)
                task.wait(0.01)
            end
        end)
    else
        ToggleBtn.Text = "АВТО-ВЕЛХОП: ВЫКЛ"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 85, 85) -- Красный
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        
        local char = LocalPlayer.Character
        if char and char:FindFirstChildWhichIsA("Humanoid") then
            char:FindFirstChildWhichIsA("Humanoid"):MoveTo(char:FindFirstChild("HumanoidRootPart").Position)
        end
    end
end)

