    while task.wait(30) do
        if BotActive then
            Brain.Aggression = math.min(1, Brain.Aggression + 0.01)
            SETTINGS.DetectionRadius = math.min(200, SETTINGS.DetectionRadius + 0.5)
            SETTINGS.MemorySize = math.min(100, SETTINGS.MemorySize + 1)
            print("🧠 Эволюция: Агрессия " .. math.floor(Brain.Aggression * 100) .. "% | Память: " .. SETTINGS.MemorySize)
        end
    end
end)

-- Визуализация памяти (отладочные точки)
local function showMemory()
    for _, pos in ipairs(Brain.Memory) do
        local part = Instance.new("Part")
        part.Size = Vector3.new(1, 1, 1)
        part.BrickColor = BrickColor.new("Bright blue")
        part.Material = Enum.Material.Neon
        part.CFrame = CFrame.new(pos)
        part.Anchored = true
        part.CanCollide = false
        part.Transparency = 0.5
        part.Parent = workspace
        game:GetService("Debris"):AddItem(part, 5)
    end
end

