-- ВКЛАДКА ESP
local ESPScroll = makeScroll(Pages[4])

local espRolesEnabled = false
local espDistanceEnabled = false
local espNPCEnabled = false
local espObjects = {}

local function clearESP()
    for _, o in ipairs(espObjects) do
        if o and o.Parent then o:Destroy() end
    end
    espObjects = {}
end

local function updateESP()
    clearESP()
    if not espRolesEnabled and not espDistanceEnabled and not espNPCEnabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            if head and hrp and hum and hum.Health > 0 then
                local role = getPlayerRole(player)
                local color = getRoleColor(role)
                if espRolesEnabled then
                    local hl = Instance.new("Highlight")
                    hl.Parent = char
                    hl.Adornee = char
                    hl.FillColor = color
                    hl.OutlineColor = color
                    hl.FillTransparency = 0.6
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    table.insert(espObjects, hl)
                end
                if espDistanceEnabled then
                    local bb = Instance.new("BillboardGui")
                    bb.Parent = char
                    bb.Adornee = head
                    bb.Size = UDim2.new(0, 150, 0, 50)
                    bb.StudsOffset = Vector3.new(0, 2.8, 0)
                    bb.AlwaysOnTop = true
                    local nm = Instance.new("TextLabel")
                    nm.Parent = bb
                    nm.Size = UDim2.new(1, 0, 0.5, 0)
                    nm.BackgroundTransparency = 1
                    nm.TextColor3 = color
                    nm.TextStrokeTransparency = 0
                    nm.Font = Enum.Font.GothamBold
                    nm.TextSize = 12
                    nm.Text = player.Name
                    local dst = Instance.new("TextLabel")
                    dst.Parent = bb
                    dst.Size = UDim2.new(1, 0, 0.5, 0)
                    dst.Position = UDim2.new(0, 0, 0.5, 0)
                    dst.BackgroundTransparency = 1
                    dst.TextColor3 = Color3.fromRGB(255, 255, 255)
                    dst.TextStrokeTransparency = 0
                    dst.Font = Enum.Font.Code
                    dst.TextSize = 11
                    if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                        local d = (LP.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                        dst.Text = getRoleName(role) .. " | " .. string.format("%.0f м", d)
                    end
                    table.insert(espObjects, bb)
                end
            end
        end
    end
    if espNPCEnabled then
        local npcs = findNPCs()
        for _, npc in ipairs(npcs) do
            local hl = Instance.new("Highlight")
            hl.Parent = npc.model
            hl.Adornee = npc.model
            hl.FillColor = CFG.NpcColor
            hl.OutlineColor = CFG.NpcColor
            hl.FillTransparency = 0.6
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            table.insert(espObjects, hl)
        end
    end
end

_G._updateESPNow = function()
    if espRolesEnabled or espDistanceEnabled or espNPCEnabled then updateESP() end
end

