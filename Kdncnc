-- Перетаскивание (только за заголовок, но НЕ за кнопку X)
local dragEnabled=false
TB.InputBegan:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
        -- Проверяем, что тап НЕ по кнопке X
        local pos=i.Position
        local cbPos=CB.AbsolutePosition
        local cbSize=CB.AbsoluteSize
        if pos.X>=cbPos.X and pos.X<=cbPos.X+cbSize.X and pos.Y>=cbPos.Y and pos.Y<=cbPos.Y+cbSize.Y then
            return -- не перетаскиваем, если попали в X
        end
        dragEnabled=true
        local ds=i.Position
        local sp=MF.Position
        local conn
        conn=UIS.InputChanged:Connect(function(ii)
            if dragEnabled and (ii.UserInputType==Enum.UserInputType.MouseMovement or ii.UserInputType==Enum.UserInputType.Touch) then
                local dd=ii.Position-ds
                MF.Position=UDim2.new(sp.X.Scale,sp.X.Offset+dd.X,sp.Y.Scale,sp.Y.Offset+dd.Y)
            end
        end)
        UIS.InputEnded:Connect(function(ii)
            if ii.UserInputType==Enum.UserInputType.MouseButton1 or ii.UserInputType==Enum.UserInputType.Touch then
                dragEnabled=false
                if conn then conn:Disconnect() end
            end
        end)
    end
end)

