local function updateArms(dt)
    local c=LP.Character
    if not c then return end
    local arms=c:FindFirstChild("KulkidArms")
    if not arms then return end
    local la=arms:FindFirstChild("LHand")
    local ra=arms:FindFirstChild("RHand")
    if not la or not ra then return end

    local hum=c:FindFirstChildOfClass("Humanoid")
    local moving=hum and hum.MoveDirection.Magnitude>0.1
    local bob=0
    if moving then
        bob=math.sin(tick()*8)*0.15
    else
        bob=math.sin(tick()*2)*0.05
    end

    -- Позиция рук относительно камеры
    local camCF=cam.CFrame
    la.CFrame=camCF*CFrame.new(-1.2,-1.2+bob,-1.5)*CFrame.Angles(math.rad(-15),math.rad(10),0)
    ra.CFrame=camCF*CFrame.new(1.2,-1.2-bob,-1.5)*CFrame.Angles(math.rad(-15),math.rad(-10),0)
end

-- МОНСТРЫ
local function saveT(ch)
    if saved[ch] then return end
    local d={parts={},scales={}}
    local h=ch:FindFirstChildOfClass("Humanoid")
    if h and h:FindFirstChild("BodyWidthScale") then
        d.scales.body={h.BodyDepthScale.Value,h.BodyWidthScale.Value,h.BodyHeightScale.Value}
    end
    for _,p in ipairs(ch:GetDescendants()) do
        if p:IsA("BasePart") then d.parts[p]={p.Color,p.Size} end
    end
    saved[ch]=d
end

local function makeMon(ch)
    if not ch then return end
    local h=ch:FindFirstChildOfClass("Humanoid")
    if not h then return end
    saveT(ch)
    for _,p in ipairs(ch:GetDescendants()) do
        if p:IsA("BasePart") then p.Color=Color3.fromRGB(200,0,0) end
    end
    if h:FindFirstChild("BodyWidthScale") then
        h.BodyWidthScale.Value=1.8;h.BodyDepthScale.Value=1.5;h.BodyHeightScale.Value=1.4
    end
    if h:FindFirstChild("HeadScale") then h.HeadScale.Value=1.6 end
    for _,p in ipairs(ch:GetDescendants()) do
        if p:IsA("BasePart") then
            local n=p.Name
            if n:find("Arm") or n:find("Leg") then p.Size=Vector3.new(p.Size.X*1.5,p.Size.Y*2,p.Size.Z*1.5)
            elseif n=="Torso" or n=="UpperTorso" or n=="LowerTorso" then p.Size=Vector3.new(p.Size.X*1.6,p.Size.Y*1.5,p.Size.Z*1.6) end
        end
    end
    local hrp=ch:FindFirstChild("HumanoidRootPart")
    if hrp and sndOn then
        local s=Instance.new("Sound");s.SoundId=SCREAM;s.Volume=5;s.Looped=true;s.Parent=hrp;s:Play()
    end
end

local function resetM(ch)
    if not ch then return end
    local h=ch:FindFirstChildOfClass("Humanoid")
    local d=saved[ch]
    if d then
        for p,i in pairs(d.parts) do
            if p and p.Parent then p.Color=i[1];p.Size=i[2] end
        end
        if h and d.scales.body and h:FindFirstChild("BodyWidthScale") then
            h.BodyWidthScale.Value=d.scales.body[2];h.BodyDepthScale.Value=d.scales.body[1];h.BodyHeightScale.Value=d.scales.body[3]
        end
    end
    local hrp=ch:FindFirstChild("HumanoidRootPart")
    if hrp then for _,s in ipairs(hrp:GetChildren()) do if s:IsA("Sound") then s:Destroy() end end end
    saved[ch]=nil
end

local function infect(plr)
    if infected[plr] then return end
    infected[plr]=true
    if plr.Character then makeMon(plr.Character) end
    plr.CharacterAdded:Connect(function(c) if infected[plr] then task.wait(1);makeMon(c) end end)
end

