-- ВИДИМОСТЬ
-- ============================================
local function isVisibleTo(instancesToIgnore, targetPos)
    if not LP.Character then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignoreList = {LP.Character}
    for _, inst in ipairs(instancesToIgnore) do table.insert(ignoreList, inst) end
    params.FilterDescendantsInstances = ignoreList
    params.IgnoreWater = true
    local origin = CAM.CFrame.Position
    local direction = targetPos - origin
    local result = WS:Raycast(origin, direction, params)
    return result == nil
end

