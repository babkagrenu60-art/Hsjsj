-- Система фиксации смертей
local function SetupLearning(character)
    local humanoid = character:WaitForChild("Humanoid")
    local root = character:WaitForChild("HumanoidRootPart")
    task.spawn(function()
        while character and character.Parent and humanoid.Health > 0 do
            if humanoid.FloorMaterial ~= Enum.Material.Air then LastSafePosition = root.Position end
            task.wait(0.2)
        end
    end)
    humanoid.Died:Connect(function()
        if AI_Enabled and LastSafePosition ~= Vector3.new(0,0,0) then
            table.insert(DeathLocations, LastSafePosition)
            SetThought("Ой, я упал! Запомнил это место. В следующий раз прыгну заранее!", "learn")
        end
    end)
end
if LocalPlayer.Character then SetupLearning(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(SetupLearning)

-- Проверка преград
local function CheckHazards(rootPart)
    for _, part in pairs(workspace:GetPartBoundsInRadius(rootPart.Position, 16)) do
        if part:IsDescendantOf(workspace) and not part:FindFirstAncestorOfClass("Model"):FindFirstChildOfClass("Humanoid") then
            local name = string.lower(part.Name)
            if string.find(name, "kill") or string.find(name, "lava") or string.find(name, "laser") or 
               string.find(name, "acid") or string.find(name, "spike") or (part.Color.R > 0.8 and part.Color.G < 0.2 and part.Color.B < 0.2) then
                local relativePos = rootPart.CFrame:PointToObjectSpace(part.Position)
                if relativePos.Z < 0 and math.abs(relativePos.X) < 5 then return true end
            end
        end
    end
    return false
end

-- Поиск чекпоинтов
local function FindTarget()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local target = nil
    local minDistance = math.huge
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (string.find(string.lower(obj.Name), "checkpoint") or string.find(string.lower(obj.Name), "finish") or obj.Name == "Stage") then
            local dist = (character.HumanoidRootPart.Position - obj.Position).Magnitude
            if dist > 6 and dist < minDistance then minDistance = dist target = obj end
        end
    end
    return target
end

-- Цикл ИИ
local function MoveAI()
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildWhichIsA("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return end

    for _, deathPos in pairs(DeathLocations) do
        if (rootPart.Position - deathPos).Magnitude < 13 then
            SetThought("Я тут уже ошибался! Исправляю ошибку — ПРЫГАЮ!", "learn")
            humanoid.Jump = true
            local jumpDirection = (rootPart.CFrame.LookVector * 20) + Vector3.new(0, 14, 0)
            rootPart.Velocity = Vector3.new(jumpDirection.X, rootPart.Velocity.Y + 16, jumpDirection.Z)
            task.wait(0.3)
            return
        end
    end

    if CheckHazards(rootPart) then
        SetThought("Вичу опасность! Перепрыгиваю!", "danger")
        humanoid.Jump = true
        local jumpDirection = (rootPart.CFrame.LookVector * 18) + Vector3.new(0, 12, 0)
        rootPart.Velocity = Vector3.new(jumpDirection.X, rootPart.Velocity.Y + 15, jumpDirection.Z)
        task.wait(0.2)
        return
    end

    local target = FindTarget()
    if not target then 
        for _, part in pairs(workspace:GetChildren()) do
            if part:IsA("BasePart") and part.Size.X < 60 and (part.Position - rootPart.Position).Magnitude < 35 then
                if part.Position.Y >= rootPart.Position.Y - 4 then target = part break end
            end
        end
    end
    if not target then SetThought("Ищу маршрут...", "normal") return end

    local path = PathfindingService:CreatePath(agentParameters)
    local success, _ = pcall(function() path:ComputeAsync(rootPart.Position, target.Position) end)

    if success and path.Status == Enum.PathStatus.Success then
        CurrentWaypoints = path:GetWaypoints()
        CurrentWaypointIndex = 1
        if CurrentWaypointIndex <= #CurrentWaypoints and AI_Enabled then
            local waypoint = CurrentWaypoints[CurrentWaypointIndex]
            if waypoint.Action == Enum.PathWaypointAction.Jump or waypoint.Position.Y > rootPart.Position.Y + 1.2 then
                SetThought("Прыгаю на платформу выше", "normal")
                humanoid.Jump = true
                rootPart.Velocity = rootPart.Velocity + (rootPart.CFrame.LookVector * 12)
            else
                SetThought("Бегу вперед. Ошибок на пути не зафиксировано", "normal")
            end
            humanoid:MoveTo(waypoint.Position)
            local timeout = task.delay(1.2, function()
                if humanoid.WalkToPoint == waypoint.Position and AI_Enabled then
                    SetThought("Застрял в текстуре, прыгаю для сброса", "danger")
                    humanoid.Jump = true 
                end
            end)
            humanoid.MoveToFinished:Wait()
            task.cancel(timeout)
            CurrentWaypointIndex = CurrentWaypointIndex + 1
        end
    else
        SetThought("Срезаю путь к следующей платформе напрямую", "normal")
        humanoid:MoveTo(target.Position)
        if (target.Position - rootPart.Position).Magnitude < 18 then humanoid.Jump = true end
    end
end

