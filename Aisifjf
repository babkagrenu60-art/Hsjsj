local function findFallenGun()
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("Tool") then
            local n = obj.Name:lower()
            if (n:find("gun") or n:find("pistol") or n:find("revolver")) and obj.Parent ~= LP.Character and obj.Parent ~= LP.Backpack then
                return obj
            end
        end
    end
    return nil
end

local function pickGunTP()
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local gun = findFallenGun()
    if not gun then return false end
    local savedCF = char.HumanoidRootPart.CFrame
    local gunPos
    local ok, pivot = pcall(function() return gun:GetPivot() end)
    if ok then gunPos = pivot else gunPos = CFrame.new(gun.Position) end
    char.HumanoidRootPart.CFrame = gunPos
    task.spawn(function()
        local timeout = 0
        while timeout < 3 do
            if gun.Parent == char or gun.Parent == LP.Backpack then break end
            task.wait(0.05)
            timeout = timeout + 0.05
        end
        if savedCF and char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = savedCF
        end
    end)
    return true
end

