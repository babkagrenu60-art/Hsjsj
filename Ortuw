local artLoops={}

local function artLoopKey(key,fn)
    if artLoops[key] then
        artLoops[key]:Disconnect()
        artLoops[key]=nil
        return false
    end
    artLoops[key]=fn()
    return true
end

local function getChar()
    local c=LP.Character
    if not c then return nil,nil,nil end
    local h=c:FindFirstChildOfClass("Humanoid")
    local hrp=c:FindFirstChild("HumanoidRootPart")
    return c,h,hrp
end

ArtButtons[1].MouseButton1Click:Connect(function()
    local on=artLoopKey("rainbow",function()
        local t=0
        return RS.Heartbeat:Connect(function(dt)
            t=t+dt
            local c=getChar()
            if c then
                local hue=(t*0.5)%1
                for _,p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.Color=Color3.fromHSV(hue,0.8,1)
                    end
                end
            end
        end)
    end)
    ArtButtons[1].Text=on and "Радужный (ВКЛ)" or "Радужный"
end)

