-- ===== ПРЕВРАЩЕНИЕ В МОНСТРА =====
local savedTransforms={}

local function saveTransform(char)
    if savedTransforms[char] then return end
    local data={parts={},scales={}}
    -- Сохраняем масштаб (R15)
    local hum=char:FindFirstChildOfClass("Humanoid")
    if hum then
        if hum:FindFirstChild("BodyDepthScale") then
            data.scales.body={hum.BodyDepthScale.Value,hum.BodyWidthScale.Value,hum.BodyHeightScale.Value}
        end
        if hum:FindFirstChild("HeadScale") then
            data.scales.head={hum.HeadScale.Value,hum.HeadScale.Value,hum.HeadScale.Value}
        end
    end
    -- Сохраняем цвета и размеры частей
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            data.parts[p]={color=p.Color,size=p.Size,mesh=p:FindFirstChildOfClass("SpecialMesh") and true or false}
        end
    end
    savedTransforms[char]=data
end

local function makeMonster(char)
    if not char then return end
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    saveTransform(char)

    -- Красный цвет
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.Color=Color3.fromRGB(200,0,0) end
    end

    -- Растягиваем как монстра
    if hum:FindFirstChild("BodyWidthScale") then
        hum.BodyWidthScale.Value=1.8
        hum.BodyDepthScale.Value=1.5
        hum.BodyHeightScale.Value=1.4
    end
    if hum:FindFirstChild("HeadScale") then
        hum.HeadScale.Value=1.6
    end

    -- Увеличиваем части рук и ног
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            local n=p.Name
            if n=="LeftUpperArm" or n=="RightUpperArm" or n=="LeftLowerArm" or n=="RightLowerArm" then
                p.Size=Vector3.new(p.Size.X*1.5,p.Size.Y*2,p.Size.Z*1.5)
            elseif n=="LeftUpperLeg" or n=="RightUpperLeg" or n=="LeftLowerLeg" or n=="RightLowerLeg" then
                p.Size=Vector3.new(p.Size.X*1.5,p.Size.Y*2,p.Size.Z*1.5)
            elseif n=="Torso" or n=="UpperTorso" or n=="LowerTorso" then
                p.Size=Vector3.new(p.Size.X*1.6,p.Size.Y*1.5,p.Size.Z*1.6)
            end
        end
    end

    -- Рагдолл-походка: руки вытянуты вперёд
    if hum:FindFirstChild("RightShoulder") then
        hum.RightShoulder.C0=CFrame.new(0,0.5,0)*CFrame.Angles(math.rad(-90),0,0)
    end
    if hum:FindFirstChild("LeftShoulder") then
        hum.LeftShoulder.C0=CFrame.new(0,0.5,0)*CFrame.Angles(math.rad(-90),0,0)
    end

    -- Звук рычания
    local hrp=char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local snd=Instance.new("Sound")
        snd.SoundId=SCREAM_ID
        snd.Volume=5
        snd.Looped=true
        snd.Parent=hrp
        snd:Play()
    end
end

local function resetMonster(char)
    if not char then return end
    local hum=char:FindFirstChildOfClass("Humanoid")
    local data=savedTransforms[char]
    if data then
        -- Возвращаем части
        for p,info in pairs(data.parts) do
            if p and p.Parent then
                p.Color=info.color
                p.Size=info.size
            end
        end
        -- Возвращаем масштаб
        if hum and data.scales.body then
            if hum:FindFirstChild("BodyWidthScale") then
                hum.BodyWidthScale.Value=data.scales.body[2]
                hum.BodyDepthScale.Value=data.scales.body[1]
                hum.BodyHeightScale.Value=data.scales.body[3]
            end
        end
        if hum and data.scales.head and hum:FindFirstChild("HeadScale") then
            hum.HeadScale.Value=data.scales.head[1]
        end
        -- Возвращаем плечи
        if hum and hum:FindFirstChild("RightShoulder") then
            hum.RightShoulder.C0=CFrame.new(1,0.5,0)
        end
        if hum and hum:FindFirstChild("LeftShoulder") then
            hum.LeftShoulder.C0=CFrame.new(-1,0.5,0)
        end
    end
    -- Убираем звук
    local hrp=char:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _,s in ipairs(hrp:GetChildren()) do
            if s:IsA("Sound") then s:Destroy() end
        end
    end
    savedTransforms[char]=nil
end

local function infectPlayer(plr)
    if infectedPlayers[plr] then return end
    infectedPlayers[plr]=true
    local c=plr.Character
    if c then makeMonster(c) end

    -- Следим за респавном
    plr.CharacterAdded:Connect(function(char)
        if infectedPlayers[plr] then
            task.wait(1)
            makeMonster(char)
        end
    end)
end

-- ===== ВИЗУАЛЬНАЯ АТАКА (идут на тебя) =====
local function startAttackLoop()
    if attackLoop then attackLoop:Disconnect() end
    attackLoop=RS.Heartbeat:Connect(function()
        if not active then return end
        local myChar=LP.Character
        if not myChar then return end
        local myHrp=myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end

        for plr,_ in pairs(infectedPlayers) do
            if plr~=LP and plr.Parent then
                local c=plr.Character
                if c then
                    local hrp=c:FindFirstChild("HumanoidRootPart")
                    local hum=c:FindFirstChildOfClass("Humanoid")
                    if hrp and hum then
                        local dist=(hrp.Position-myHrp.Position).Magnitude
                        if dist<=attackRange then
                            -- Заставляем идти к игроку
                            hum.WalkSpeed=16
                            hum:MoveTo(myHrp.Position)
                        else
                            -- Далеко — стоят
                            hum.WalkSpeed=0
                        end
                    end
                end
            end
        end
    end)
end

-- ===== ОБРАБОТКА ПЛАТФОРМ =====
local function makeBlack(part)
    if not part or not part.Parent then return end
    if doneParts[part] then return end
    doneParts[part]=true

    part:SetAttribute("OrigColor",part.Color)
    part.Color=Color3.fromRGB(0,0,0)
    part.Material=Enum.Material.SmoothPlastic

    for _,face in ipairs{Enum.NormalId.Top,Enum.NormalId.Bottom,Enum.NormalId.Front,Enum.NormalId.Back,Enum.NormalId.Left,Enum.NormalId.Right} do
        local gui=Instance.new("SurfaceGui")
        gui.Face=face;gui.CanvasSize=Vector2.new(400,400);gui.LightInfluence=0
        gui.Parent=part
        local txt=Instance.new("TextLabel")
        txt.Size=UDim2.new(1,0,1,0);txt.BackgroundTransparency=1
        txt.Text="КУЛКИД";txt.TextColor3=Color3.fromRGB(255,0,0);txt.TextScaled=true
        txt.Font=Enum.Font.GothamBlack;txt.TextStrokeTransparency=0
        txt.TextStrokeColor3=Color3.fromRGB(0,0,0);txt.Parent=gui
    end

    part.Touched:Connect(function(hit)
        if not active then return end
        local char=hit.Parent
        if not char then return end
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        -- Звук
        local hrp=char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local snd=Instance.new("Sound")
            snd.SoundId=SCREAM_ID;snd.Volume=5
            snd.Parent=hrp;snd:Play()
            task.delay(5,function() if snd then snd:Destroy() end end)
        end

        -- Превращаем в монстра
        local plr=P:GetPlayerFromCharacter(char)
        if plr then infectPlayer(plr) end
    end)
end

local function scanPlatforms()
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name=="PlatformPart" then
            makeBlack(obj)
        end
    end
end

local function startMode()
    active=true
    MainBtn.Text="🖤  ВЫКЛЮЧИТЬ"
    MainBtn.BackgroundColor3=Color3.fromRGB(80,20,20)
    StatusLbl.Text="КУЛКИД активен · монстры идут"
    StatusLbl.TextColor3=Color3.fromRGB(255,50,50)
    scanPlatforms()
    if loop then loop:Disconnect() end
    loop=RS.Heartbeat:Connect(function()
        if not active then return end
        scanPlatforms()
    end)
    startAttackLoop()
end

local function stopMode()
    active=false
    if loop then loop:Disconnect();loop=nil end
    if attackLoop then attackLoop:Disconnect();attackLoop=nil end
    MainBtn.Text="🖤  ВКЛЮЧИТЬ КУЛКИД"
    MainBtn.BackgroundColor3=Color3.fromRGB(40,20,20)
    StatusLbl.Text="Выключено"
    StatusLbl.TextColor3=Color3.fromRGB(150,150,160)
end

local function resetAll()
    -- Сбрасываем платформы
    for part,_ in pairs(doneParts) do
        if part and part.Parent then
            local orig=part:GetAttribute("OrigColor")
            if orig then part.Color=orig end
            part.Material=Enum.Material.Plastic
            for _,c in ipairs(part:GetChildren()) do
                if c:IsA("SurfaceGui") then c:Destroy() end
            end
        end
    end
    doneParts={}

    -- Сбрасываем монстров
    for plr,_ in pairs(infectedPlayers) do
        if plr.Character then resetMonster(plr.Character) end
    end
    infectedPlayers={}

    StatusLbl.Text="Всё сброшено"
    StatusLbl.TextColor3=Color3.fromRGB(150,200,255)
end

MainBtn.MouseButton1Click:Connect(function()
    if active then stopMode() else startMode() end
