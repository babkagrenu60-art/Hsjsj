-- ===== РАДУЖНОЕ НЕБО =====
local function enableRainbowSky()
    savedSky=L:FindFirstChildOfClass("Sky")
    savedFog={L.FogColor,L.FogEnd,L.FogStart,L.Brightness,L.Ambient,L.OutdoorAmbient}
    if savedSky then savedSky.Parent=nil end

    rainbowSky=Instance.new("Sky")
    rainbowSky.SkyboxBk="rbxassetid://0"
    rainbowSky.SkyboxDn="rbxassetid://0"
    rainbowSky.SkyboxFt="rbxassetid://0"
    rainbowSky.SkyboxLf="rbxassetid://0"
    rainbowSky.SkyboxRt="rbxassetid://0"
    rainbowSky.SkyboxUp="rbxassetid://0"
    rainbowSky.SunAngularSize=0
    rainbowSky.MoonAngularSize=0
    rainbowSky.Parent=L

    -- Радужная атмосфера
    local atmos=L:FindFirstChildOfClass("Atmosphere")
    if not atmos then
        atmos=Instance.new("Atmosphere")
        atmos.Parent=L
    end
    atmos.Color=Color3.fromRGB(255,100,200)
    atmos.Decay=Color3.fromRGB(100,150,255)
    atmos.Density=0.5
    atmos.Haze=2

    -- Цикл радуги
    task.spawn(function()
        local t=0
        while rainbowSky and rainbowSky.Parent do
            t=t+0.02
            local hue=(t*0.5)%1
            L.FogColor=Color3.fromHSV(hue,0.8,1)
            L.Ambient=Color3.fromHSV((hue+0.3)%1,0.6,1)
            L.OutdoorAmbient=Color3.fromHSV((hue+0.6)%1,0.6,1)
            atmos.Color=Color3.fromHSV(hue,0.7,1)
            atmos.Decay=Color3.fromHSV((hue+0.5)%1,0.7,1)
            task.wait(0.05)
        end
    end)
end

-- ===== РАДУЖНЫЕ ГОРЯЩИЕ ШАРИКИ =====
local function spawnRainbowBall()
    local c=LP.Character
    local hrp=c and c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local ball=Instance.new("Part")
    ball.Size=Vector3.new(4,4,4)
    ball.Shape=Enum.PartType.Ball
    ball.Color=Color3.fromHSV(math.random(),0.8,1)
    ball.Material=Enum.Material.Neon
    ball.Anchored=false
    ball.CanCollide=false
    ball.Position=Vector3.new(
        hrp.Position.X+math.random(-50,50),
        hrp.Position.Y+150,
        hrp.Position.Z+math.random(-50,50)
    )
    ball.Parent=workspace

    -- Огонь на шарике
    local fire=Instance.new("Fire")
    fire.Size=6
    fire.Heat=10
    fire.Color=ball.Color
    fire.Parent=ball

    -- Звук падения
    local whistle=Instance.new("Sound")
    whistle.SoundId="rbxassetid://131961133"
    whistle.Volume=5
    whistle.Parent=ball
    whistle:Play()

    -- Падение
    task.spawn(function()
        while ball and ball.Parent do
            ball.AssemblyLinearVelocity=Vector3.new(0,-150,0)
            task.wait(0.05)
        end
    end)

    -- Взрыв при касании
    ball.Touched:Connect(function(hit)
        if not ball or not ball.Parent then return end
        local exp=Instance.new("Explosion")
        exp.Position=ball.Position
        exp.BlastRadius=15
        exp.BlastPressure=100000
        exp.DestroyJointRadiusPercent=1
        exp.Parent=workspace

        -- Звук "бум"
        local boom=Instance.new("Sound")
        boom.SoundId="rbxassetid://131237241"
        boom.Volume=10
        boom.Parent=workspace
        boom:Play()
        task.delay(3,function() if boom then boom:Destroy() end end)

        ball:Destroy()
    end)

    -- Автоудаление
    task.delay(10,function()
        if ball then ball:Destroy() end
    end)
end

-- ===== ВСЕ ИГРОКИ ИДУТ К ТЕБЕ =====
local function makePlayersFollow()
    if followLoop then followLoop:Disconnect() end
    followLoop=RS.Heartbeat:Connect(function()
        local myChar=LP.Character
        if not myChar then return end
        local myHrp=myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end

        for _,plr in ipairs(Players:GetPlayers()) do
            if plr~=LP and plr.Character then
                local hrp=plr.Character:FindFirstChild("HumanoidRootPart")
                local hum=plr.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum then
                    local dist=(hrp.Position-myHrp.Position).Magnitude
                    if dist>3 then
                        -- Тащим их к тебе через CFrame
                        local dir=(myHrp.Position-hrp.Position).Unit
                        hrp.CFrame=CFrame.new(hrp.Position+dir*0.5, hrp.Position+dir*2)
                        -- Заставляем анимацию ходьбы
                        if hum.WalkSpeed==0 then hum.WalkSpeed=16 end
                    end
                end
            end
        end
    end)
end

