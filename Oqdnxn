-- УДАР О СТЕНКУ (определение части)
local lastWallHit=0
local function checkWallHit()
    if not active then return end
    local c=LP.Character
    if not c then return end
    local hrp=c:FindFirstChild("HumanoidRootPart")
    local hum=c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local vel=hrp.AssemblyLinearVelocity.Magnitude
    -- Если недавно откинуло и скорость упала об стену
    if vel>15 and tick()-lastWallHit>1 then
        local ray=Ray.new(hrp.Position,hrp.AssemblyLinearVelocity.Unit*3)
        local hit=workspace:FindPartOnRay(ray,c)
        if hit and vel>25 then
            lastWallHit=tick()
            local bodyPart="тело"
            -- Определяем, какая часть ближе к стене
            local head=c:FindFirstChild("Head")
            local torso=c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso")
            local leftArm=c:FindFirstChild("Left Arm") or c:FindFirstChild("LeftUpperArm")
            local rightArm=c:FindFirstChild("Right Arm") or c:FindFirstChild("RightUpperArm")
            local leftLeg=c:FindFirstChild("Left Leg") or c:FindFirstChild("LeftUpperLeg")
            local rightLeg=c:FindFirstChild("Right Leg") or c:FindFirstChild("RightUpperLeg")
            local parts={["голова"]=head,["торс"]=torso,["левая рука"]=leftArm,["правая рука"]=rightArm,["левая нога"]=leftLeg,["правая нога"]=rightLeg}
            local minD=999
            for name,p in pairs(parts) do
                if p then
                    local d=(p.Position-hit).Magnitude
                    if d<minD then minD=d;bodyPart=name end
                end
            end
            BodyLbl.Text="🤕 Болит: "..bodyPart
            BodyLbl.TextColor3=Color3.fromRGB(255,180,80)
            shake=1.2
            task.delay(3,function() if active then bodyStatus() end end)
        end
    end
end

