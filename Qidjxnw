local function setupCameraControl()
    camAngleX=0;camAngleY=0

    UIS.InputChanged:Connect(function(input)
        if not active then return end
        if input.UserInputType==Enum.UserInputType.MouseMovement then
            camAngleX=camAngleX - input.Delta.X*0.003
            camAngleY=math.clamp(camAngleY - input.Delta.Y*0.003,-math.rad(80),math.rad(80))
        elseif input.UserInputType==Enum.UserInputType.Touch then
            camAngleX=camAngleX - input.Delta.X*0.005
            camAngleY=math.clamp(camAngleY - input.Delta.Y*0.005,-math.rad(80),math.rad(80))
        end
    end)
end
