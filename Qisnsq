local function evFreeze()
local char=LP.Character;if not char then return end
local hrp=char:FindFirstChild("HumanoidRootPart")
local hum=char:FindFirstChildOfClass("Humanoid")
if not hrp or not hum then return end
hum.WalkSpeed=0;hum.JumpPower=0
for _,p in ipairs(char:GetDescendants()) do
if p:IsA("BasePart") then p.Color=Color3.fromRGB(150,220,255) end
end
task.wait(4)
if hum and hum.Parent then hum.WalkSpeed=16;hum.JumpPower=50 end
end

local function evInvisible()
local char=LP.Character;if not char then return end
for _,p in ipairs(char:GetDescendants()) do
if p:IsA("BasePart") then p.Transparency=0.9;p.CanCollide=false end
end
task.wait(5)
if char and char.Parent then
for _,p in ipairs(char:GetDescendants()) do
if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then
p.Transparency=0;p.CanCollide=true
end
end
end
end

