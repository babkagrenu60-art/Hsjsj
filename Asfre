    Callback = function(state) autoShootEnabled = state end
})

local function findMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local backpack = player.Backpack
            if char and (char:FindFirstChild("Knife") or backpack:FindFirstChild("Knife")) then
                return player
            end
        end
    end
    return nil
end

task.spawn(function()
    while task.wait(0.15) do
        if autoShootEnabled and LocalPlayer.Character then
            local gun = LocalPlayer.Character:FindFirstChild("Gun")
            if gun then
                local murderer = findMurderer()
                if murderer and murderer.Character then
                    local hrp = murderer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local hasKnifeOut = murderer.Character:FindFirstChild("Knife")
                        if not Settings.ShootWhenDrawn or (Settings.ShootWhenDrawn and hasKnifeOut) then
                            local mouse = LocalPlayer:GetMouse()
                            if mouse then
                                local screenPos, onScreen = workspace.CurrentCamera:WorldToScreenPoint(hrp.Position)
                                if onScreen then
                                    mouse.Hit = CFrame.new(hrp.Position)
                                    UserInputService.InputBegan:Fire(mouse, Enum.UserInputType.MouseButton1)
                                    task.wait(0.05)
                                    UserInputService.InputEnded:Fire(mouse, Enum.UserInputType.MouseButton1)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

