    Callback = function()
        -- Ищем костер
        local campfire = nil
        for _, obj in pairs(workspace:GetChildren()) do
            if string.find(string.lower(obj.Name), "campfire") or 
               string.find(string.lower(obj.Name), "fire") or
               string.find(string.lower(obj.Name), "camp") then
