local isAnimating = false

local function closeWithParticles()
    if isAnimating then return end
    isAnimating = true

    local iconPos = getIconAbsolutePosition()

    -- 1. Частицы летят ОТ панели к иконке
    spawnParticles(iconPos, 30, false)

    -- 2. Панель сжимается и летит к иконке
    local startPos = MF.AbsolutePosition
    local startSize = MF.AbsoluteSize
    local targetX = iconPos.X - startSize.X / 2
    local targetY = iconPos.Y - startSize.Y / 2

    local shrinkTween = TW:Create(MF, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0, iconPos.X, 0, iconPos.Y),
        BackgroundTransparency = 1
    })

    TW:Create(mainStroke, TweenInfo.new(0.4), {Transparency = 1}):Play()
    for _, desc in ipairs(MF:GetDescendants()) do
        if desc:IsA("GuiObject") and not desc:IsA("UIStroke") then
            pcall(function()
                TW:Create(desc, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
            end)
            if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
                pcall(function()
                    TW:Create(desc, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
                end)
            end
            if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
                pcall(function()
                    TW:Create(desc, TweenInfo.new(0.3), {ImageTransparency = 1}):Play()
                end)
            end
        end
    end

    shrinkTween:Play()

    shrinkTween.Completed:Connect(function()
        MF.Visible = false
        -- Восстановить прозрачность
        MF.BackgroundTransparency = 0
        MF.Size = UDim2.new(0, 290, 0, 360)
        MF.Position = UDim2.new(0.5, -145, 0.5, -180)
        mainStroke.Transparency = 0
        for _, desc in ipairs(MF:GetDescendants()) do
            if desc:IsA("GuiObject") and not desc:IsA("UIStroke") then
                pcall(function()
                    desc.BackgroundTransparency = desc:GetAttribute("OrigBgT") or 0
                end)
            end
        end

        -- Иконка пульсирует при возврате
        local pulseTween = TW:Create(Icon, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 52, 0, 52)
        })
        pulseTween:Play()
        pulseTween.Completed:Connect(function()
            TW:Create(Icon, TweenInfo.new(0.3), {Size = UDim2.new(0, 42, 0, 42)}):Play()
        end)

        isAnimating = false
    end)
end

-- ===== ОТКРЫТИЕ С АНИМАЦИЕЙ =====
local function openWithParticles()
    if isAnimating then return end
    isAnimating = true

    local iconPos = getIconAbsolutePosition()

    -- 1. Иконка сжимается
    TW:Create(Icon, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 20, 0, 20)
    }):Play()

    -- 2. Частицы летят К иконке (собираются)
    spawnParticles(iconPos, 25, false)

    task.wait(0.15)

    -- 3. Показываем панель с анимацией "вылета"
    MF.Visible = true
    MF.Size = UDim2.new(0, 0, 0, 0)
    MF.Position = UDim2.new(0, iconPos.X, 0, iconPos.Y)
    MF.BackgroundTransparency = 1
    mainStroke.Transparency = 1

    -- Скрываем содержимое на время анимации
    for _, desc in ipairs(MF:GetDescendants()) do
        if desc:IsA("GuiObject") and not desc:IsA("UIStroke") then
            if not desc:GetAttribute("OrigBgT") then
                desc:SetAttribute("OrigBgT", desc.BackgroundTransparency)
            end
            desc.BackgroundTransparency = 1
        end
        if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
            if not desc:GetAttribute("OrigTextT") then
                desc:SetAttribute("OrigTextT", desc.TextTransparency)
            end
            desc.TextTransparency = 1
        end
        if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
            if not desc:GetAttribute("OrigImgT") then
                desc:SetAttribute("OrigImgT", desc.ImageTransparency)
            end
            desc.ImageTransparency = 1
        end
    end

    local expandTween = TW:Create(MF, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 290, 0, 360),
        Position = UDim2.new(0.5, -145, 0.5, -180),
        BackgroundTransparency = 0
    })
    TW:Create(mainStroke, TweenInfo.new(0.5), {Transparency = 0}):Play()
    expandTween:Play()

    -- Восстанавливаем содержимое с задержкой
    task.spawn(function()
        task.wait(0.25)
        for _, desc in ipairs(MF:GetDescendants()) do
            if desc:IsA("GuiObject") and not desc:IsA("UIStroke") then
                local origBg = desc:GetAttribute("OrigBgT") or 0
                pcall(function()
                    TW:Create(desc, TweenInfo.new(0.3), {BackgroundTransparency = origBg}):Play()
                end)
            end
            if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
                local origT = desc:GetAttribute("OrigTextT") or 0
                pcall(function()
                    TW:Create(desc, TweenInfo.new(0.3), {TextTransparency = origT}):Play()
                end)
            end
            if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
                local origI = desc:GetAttribute("OrigImgT") or 0
                pcall(function()
                    TW:Create(desc, TweenInfo.new(0.3), {ImageTransparency = origI}):Play()
                end)
            end
        end
    end)

    -- Иконка возвращается в норм размер
    TW:Create(Icon, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 42, 0, 42)
    }):Play()

    task.wait(0.5)
    isAnimating = false
end

CloseBtn.MouseButton1Click:Connect(closeWithParticles)

Icon.MouseButton1Click:Connect(function()
    if MF.Visible then
        closeWithParticles()
    else
        openWithParticles()
    end
end)

-- Перетаскивание
do
    local dragging = false
    local dragStart = nil
    local startPos = nil

    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MF.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            MF.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

