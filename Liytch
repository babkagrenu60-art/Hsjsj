local function getChar()
    local c=LP.Character
    if not c then return nil,nil,nil end
    local h=c:FindFirstChildOfClass("Humanoid")
    local hrp=c:FindFirstChild("HumanoidRootPart")
    return c,h,hrp
end

local function clearParticles(name)
    local c=getChar()
    if not c then return end
    local hrp=c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    for _,child in ipairs(hrp:GetChildren()) do
        if child.Name==name then child:Destroy() end
    end
end

local function clearAllEffects()
    if rainbowLoop then rainbowLoop:Disconnect();rainbowLoop=nil end
    for k,conn in pairs(CFG_Loops) do
        if conn then pcall(function() conn:Disconnect() end) end
        CFG_Loops[k]=nil
    end
    local c=getChar()
    if c then
        local hrp=c:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _,child in ipairs(hrp:GetChildren()) do
                if child:IsA("ParticleEmitter") then child:Destroy() end
                if child:IsA("Fire") then child:Destroy() end
                if child:IsA("PointLight") then child:Destroy() end
                if child:IsA("Sound") then child:Destroy() end
            end
        end
        for _,p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                p.Color=Color3.fromRGB(255,255,255)
                p.Material=Enum.Material.Plastic
            end
        end
    end
end

